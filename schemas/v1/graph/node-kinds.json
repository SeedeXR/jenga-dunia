[
  {
    "kind": "jd.analysis.curvature@1",
    "description": "Curvature (Laplacian of height, 1/m) mapped to −1..1: positive on ridges and convex breaks, negative in valleys and hollows — for rock exposure, soil and sediment masks",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CurvatureParams",
      "type": "object",
      "properties": {
        "scale": {
          "description": "Curvature (1/m) that maps to ±1; smaller values exaggerate.",
          "type": "number",
          "format": "float",
          "default": 0.009999999776482582
        },
        "radius_px": {
          "description": "Stencil half-width in samples (1..=16): 1 reacts to every bump, larger radii read\nridges and valleys at landscape scale.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.analysis.flow@1",
    "description": "D8 flow accumulation: upstream drainage area per cell (log-scaled 0..1 mask by default) — rivers, wetness, erosion seeding",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FlowParams",
      "type": "object",
      "properties": {
        "log_scale": {
          "description": "Output ln(1 + area) / ln(1 + N) in 0..1 (true) or the raw upstream cell count (false).",
          "type": "boolean",
          "default": true
        },
        "method": {
          "description": "Routing: `d8` (single steepest neighbour), `dinf` (Tarboton facets, smoother streams) or `mfd` (Freeman, most diffuse).",
          "$ref": "#/$defs/FlowMethod",
          "default": "d8"
        }
      },
      "additionalProperties": false,
      "$defs": {
        "FlowMethod": {
          "description": "Flow routing method.",
          "oneOf": [
            {
              "description": "Single steepest neighbour (O'Callaghan & Mark 1984): fast, 45° quantised.",
              "type": "string",
              "const": "d8"
            },
            {
              "description": "Tarboton 1997: steepest of eight triangular facets, flow split between its two neighbours.",
              "type": "string",
              "const": "dinf"
            },
            {
              "description": "Freeman 1991 multiple-flow-direction: flow shared among all lower neighbours in proportion\nto slope^1.1 — the most diffuse (hillslope wash, wetness); streams come out wide.",
              "type": "string",
              "const": "mfd"
            }
          ]
        }
      }
    }
  },
  {
    "kind": "jd.analysis.slope@1",
    "description": "Slope mask 0..1 (gradient angle / max_deg) — feed into multiply to attenuate by steepness",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SlopeParams",
      "type": "object",
      "properties": {
        "max_deg": {
          "description": "Slope that maps to 1.0 in the mask (degrees, (0, 90]).",
          "type": "number",
          "format": "float",
          "default": 90.0
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.biome.classify@1",
    "description": "Classify every cell into a biome by ordered rules on height, slope (0..1) and wetness (0..1); outputs the class id map (1-based rule index, 0 = none)",
    "inputs": [
      {
        "name": "height",
        "ty": "heightfield",
        "required": true
      },
      {
        "name": "slope",
        "ty": "heightfield",
        "required": false
      },
      {
        "name": "wetness",
        "ty": "heightfield",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "biome",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "BiomeParams",
      "type": "object",
      "properties": {
        "rules": {
          "description": "Rules in priority order; class ids are 1-based positions, 0 = unclassified. Empty = a\ntemperate default set (beach, grassland, forest, rock, snow).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BiomeRule"
          }
        }
      },
      "additionalProperties": false,
      "$defs": {
        "BiomeRule": {
          "description": "One biome rule: every given range must hold; a range on an input that is not connected\nnever matches. Rules are tried in order; the first match wins.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Display name (e.g. \"alpine meadow\").",
              "type": "string"
            },
            "height_m": {
              "description": "Height band in metres [min, max).",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": null
            },
            "slope": {
              "description": "Slope band in 0..1 (the `jd.analysis.slope@1` scale, 1 = 90°) [min, max).",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": null
            },
            "wetness": {
              "description": "Wetness band in 0..1 (the `jd.hydrology.wetness@1` index) [min, max).",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "name"
          ]
        }
      }
    }
  },
  {
    "kind": "jd.erosion.droplet@1",
    "description": "Particle (droplet) hydraulic erosion after Beyer: seeded droplets follow the slope with inertia, erode through a brush and deposit as they slow — gullies and fans; outputs the terrain and the signed `delta`",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      },
      {
        "name": "delta",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "DropletParams",
      "description": "Droplet erosion parameters (Beyer's defaults, metres scaled by the sample spacing).",
      "type": "object",
      "properties": {
        "droplets": {
          "description": "Number of droplets (1..=5 000 000). Aim for 1–2 per cell: 512² wants ~400 000; fewer gives\ndiffuse, unstructured lowering, more deepens the same gullies.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 200000
        },
        "seed": {
          "description": "Seed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "max_steps": {
          "description": "Steps a droplet may travel before it is dropped (8..=256).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 64
        },
        "inertia": {
          "description": "Direction inertia 0..1 (0 follows the gradient exactly).",
          "type": "number",
          "format": "float",
          "default": 0.05000000074505806
        },
        "capacity": {
          "description": "Sediment capacity factor.",
          "type": "number",
          "format": "float",
          "default": 4.0
        },
        "min_capacity": {
          "description": "Minimum capacity so droplets on flats still carry a little.",
          "type": "number",
          "format": "float",
          "default": 0.009999999776482582
        },
        "deposit": {
          "description": "Fraction of surplus sediment deposited per step, 0..1.",
          "type": "number",
          "format": "float",
          "default": 0.30000001192092896
        },
        "erode": {
          "description": "Fraction of the capacity deficit eroded per step, 0..1.",
          "type": "number",
          "format": "float",
          "default": 0.30000001192092896
        },
        "evaporation": {
          "description": "Water lost per step, 0..1.",
          "type": "number",
          "format": "float",
          "default": 0.009999999776482582
        },
        "gravity": {
          "description": "Gravity (speed gain per unit drop).",
          "type": "number",
          "format": "float",
          "default": 4.0
        },
        "radius": {
          "description": "Erosion brush radius in cells (1..=8).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 3
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.erosion.hydraulic@1",
    "description": "Hydraulic erosion (virtual pipes / shallow water): rain flows downhill, dissolves, carries and deposits sediment; outputs terrain, water depth and suspended sediment",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      },
      {
        "name": "water",
        "ty": "heightfield",
        "required": false
      },
      {
        "name": "sediment",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "HydraulicNodeParams",
      "type": "object",
      "properties": {
        "iterations": {
          "description": "Simulation steps (1..=2000).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 100
        },
        "dt": {
          "description": "Time step in seconds ((0, 1]; 0.02 is stable for the pipe model).",
          "type": "number",
          "format": "float",
          "default": 0.019999999552965164
        },
        "rain_rate": {
          "description": "Rain in metres of water per second.",
          "type": "number",
          "format": "float",
          "default": 0.012000000104308128
        },
        "evaporation": {
          "description": "Evaporation per second (fraction of depth).",
          "type": "number",
          "format": "float",
          "default": 0.014999999664723873
        },
        "capacity_k": {
          "description": "Sediment capacity constant Kc.",
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "dissolve_k": {
          "description": "Dissolving constant Ks.",
          "type": "number",
          "format": "float",
          "default": 0.5
        },
        "deposit_k": {
          "description": "Deposition constant Kd.",
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "max_concentration": {
          "description": "Suspended sediment cap as a fraction of water depth (excess settles the same step).",
          "type": "number",
          "format": "float",
          "default": 0.30000001192092896
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.erosion.stream_power@1",
    "description": "Fluvial (stream-power) erosion: channels incise in proportion to drainage area^m × slope, implicit and unconditionally stable; outputs the eroded terrain and an `incision` depth map",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      },
      {
        "name": "incision",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "StreamPowerParams",
      "description": "Stream-power (detachment-limited fluvial) erosion parameters.",
      "type": "object",
      "properties": {
        "k": {
          "description": "Erodibility K: metres of incision per step for unit drainage area and unit slope\n(`dz = -K·A^m·S`, A in m², S dimensionless). 1e-3 carves visible valleys on a 5 km world\nin 20 steps; 1e-4 is subtle, 1e-2 is a badlands.",
          "type": "number",
          "format": "float",
          "default": 0.0010000000474974513
        },
        "m": {
          "description": "Area exponent m (0.3–0.6 in nature; n is fixed at 1 for the implicit solve).",
          "type": "number",
          "format": "float",
          "default": 0.5
        },
        "uplift_m": {
          "description": "Uniform uplift per step in metres (0 = none); outlets rise too, so base level is kept.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "iterations": {
          "description": "Steps (1..=1000).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 20
        },
        "method": {
          "description": "Flow routing used for the drainage area.",
          "$ref": "#/$defs/FlowMethod",
          "default": "d8"
        }
      },
      "additionalProperties": false,
      "$defs": {
        "FlowMethod": {
          "description": "Flow routing method.",
          "oneOf": [
            {
              "description": "Single steepest neighbour (O'Callaghan & Mark 1984): fast, 45° quantised.",
              "type": "string",
              "const": "d8"
            },
            {
              "description": "Tarboton 1997: steepest of eight triangular facets, flow split between its two neighbours.",
              "type": "string",
              "const": "dinf"
            },
            {
              "description": "Freeman 1991 multiple-flow-direction: flow shared among all lower neighbours in proportion\nto slope^1.1 — the most diffuse (hillslope wash, wetness); streams come out wide.",
              "type": "string",
              "const": "mfd"
            }
          ]
        }
      }
    }
  },
  {
    "kind": "jd.erosion.thermal@1",
    "description": "Thermal erosion: material steeper than the talus angle slides downhill (mass-conserving Jacobi steps)",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ThermalParams",
      "type": "object",
      "properties": {
        "talus_deg": {
          "description": "Angle of repose in degrees (sand ≈ 30–35, scree ≈ 35–40).",
          "type": "number",
          "format": "float",
          "default": 35.0
        },
        "iterations": {
          "description": "Jacobi steps (1..=1000); more steps move material further.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 50
        },
        "rate": {
          "description": "Fraction of the excess that moves per step, (0, 0.25]; 0.25 is the stable maximum.",
          "type": "number",
          "format": "float",
          "default": 0.25
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.filter.blur@1",
    "description": "Box blur (tile-local, reads through the halo; radius ≤ world.halo)",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "BlurParams",
      "type": "object",
      "properties": {
        "radius": {
          "description": "Box-blur radius in pixels (1..=4; must not exceed the world's tile halo).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.filter.terrace@1",
    "description": "Terraces: quantise heights into steps of `step_m` with a soft riser — mesas, rice paddies, strata",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerraceParams",
      "type": "object",
      "properties": {
        "step_m": {
          "description": "Step height in metres (> 0).",
          "type": "number",
          "format": "float",
          "default": 25.0
        },
        "softness": {
          "description": "0 = hard steps, 1 = untouched; in between blends the step edge over that fraction of the riser.",
          "type": "number",
          "format": "float",
          "default": 0.20000000298023224
        },
        "offset_m": {
          "description": "Shift the step boundaries by this many metres.",
          "type": "number",
          "format": "float",
          "default": 0.0
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.hydrology.fill@1",
