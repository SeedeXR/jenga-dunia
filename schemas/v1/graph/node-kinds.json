    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      },
      {
        "name": "lakes",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FillParams",
      "type": "object",
      "properties": {
        "epsilon_m": {
          "description": "Extra rise per step across filled flats so they still drain (metres; 0 = perfectly flat lakes).",
          "type": "number",
          "format": "float",
          "default": 0.0010000000474974513
        }
      },
      "additionalProperties": false
    }
  },
  {
