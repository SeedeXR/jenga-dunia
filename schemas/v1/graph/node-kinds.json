[
  {
    "kind": "jd.analysis.flow@1",
    "description": "D8 flow accumulation: upstream drainage area per cell (log-scaled 0..1 mask by default) — rivers, wetness, erosion seeding",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FlowParams",
      "type": "object",
      "properties": {
        "log_scale": {
          "description": "Output ln(1 + area) / ln(1 + N) in 0..1 (true) or the raw upstream cell count (false).",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.analysis.slope@1",
    "description": "Slope mask 0..1 (gradient angle / max_deg) — feed into multiply to attenuate by steepness",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SlopeParams",
      "type": "object",
      "properties": {
        "max_deg": {
          "description": "Slope that maps to 1.0 in the mask (degrees, (0, 90]).",
          "type": "number",
          "format": "float",
          "default": 90.0
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.erosion.hydraulic@1",
    "description": "Hydraulic erosion (virtual pipes / shallow water): rain flows downhill, dissolves, carries and deposits sediment; outputs terrain, water depth and suspended sediment",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      },
      {
        "name": "water",
        "ty": "heightfield",
        "required": false
      },
      {
        "name": "sediment",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "HydraulicNodeParams",
      "type": "object",
      "properties": {
        "iterations": {
          "description": "Simulation steps (1..=2000).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 100
        },
        "dt": {
          "description": "Time step in seconds ((0, 1]; 0.02 is stable for the pipe model).",
          "type": "number",
          "format": "float",
          "default": 0.019999999552965164
        },
        "rain_rate": {
          "description": "Rain in metres of water per second.",
          "type": "number",
          "format": "float",
          "default": 0.012000000104308128
        },
        "evaporation": {
          "description": "Evaporation per second (fraction of depth).",
          "type": "number",
          "format": "float",
          "default": 0.014999999664723873
        },
        "capacity_k": {
          "description": "Sediment capacity constant Kc.",
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "dissolve_k": {
          "description": "Dissolving constant Ks.",
          "type": "number",
          "format": "float",
          "default": 0.5
        },
        "deposit_k": {
          "description": "Deposition constant Kd.",
          "type": "number",
          "format": "float",
          "default": 1.0
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.erosion.thermal@1",
    "description": "Thermal erosion: material steeper than the talus angle slides downhill (mass-conserving Jacobi steps)",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ThermalParams",
      "type": "object",
      "properties": {
        "talus_deg": {
          "description": "Angle of repose in degrees (sand ≈ 30–35, scree ≈ 35–40).",
          "type": "number",
          "format": "float",
          "default": 35.0
        },
        "iterations": {
          "description": "Jacobi steps (1..=1000); more steps move material further.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 50
        },
        "rate": {
          "description": "Fraction of the excess that moves per step, (0, 0.25]; 0.25 is the stable maximum.",
          "type": "number",
          "format": "float",
          "default": 0.25
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.filter.blur@1",
    "description": "Box blur (tile-local, reads through the halo; radius ≤ world.halo)",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "BlurParams",
      "type": "object",
      "properties": {
        "radius": {
          "description": "Box-blur radius in pixels (1..=4; must not exceed the world's tile halo).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.hydrology.fill@1",
    "description": "Priority-flood depression filling: raises pits to their spill level so every cell drains; `lakes` = water depth of the filled basins",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      },
      {
        "name": "lakes",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FillParams",
      "type": "object",
      "properties": {
        "epsilon_m": {
          "description": "Extra rise per step across filled flats so they still drain (metres; 0 = perfectly flat lakes).",
          "type": "number",
          "format": "float",
          "default": 0.0010000000474974513
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.hydrology.rivers@1",
    "description": "Carve river channels where flow accumulates (depressions filled first); outputs the carved terrain and a 0..1 river mask",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      },
      {
        "name": "rivers",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "RiversParams",
      "type": "object",
      "properties": {
        "threshold": {
          "description": "Log-scaled flow accumulation (0..1) above which a cell is a river channel.",
          "type": "number",
          "format": "float",
          "default": 0.550000011920929
        },
        "depth_m": {
          "description": "Incision depth at the largest rivers, metres.",
          "type": "number",
          "format": "float",
          "default": 20.0
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.input.heightmap@1",
    "description": "Load a heightmap from the project's assets/ (PNG 16-bit, EXR, TIFF, RAW) and resample it onto the world grid",
    "inputs": [],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "InputParams",
      "description": "How to interpret a foreign file.",
      "type": "object",
      "properties": {
        "path": {
          "description": "File inside the project's `assets/` directory (png, exr, tif/tiff, r16, r32).",
          "type": "string"
        },
        "range_m": {
          "description": "Height range the full 16-bit span maps to (quantised PNG/TIFF/r16); ignored for float data.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "size_px": {
          "description": "Width and height in pixels — required for headerless RAW files.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "north_up": {
          "description": "Row 0 of the file is north (true, the usual image convention) or south (the field convention).",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    }
  },
  {
    "kind": "jd.math.add@1",
    "description": "a + b",
    "inputs": [
      {
        "name": "a",
        "ty": "heightfield",
        "required": true
      },
      {
        "name": "b",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "No parameters.",
      "type": "object",
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.math.multiply@1",
    "description": "a × b (use a 0..1 mask as b to attenuate)",
    "inputs": [
      {
        "name": "a",
        "ty": "heightfield",
        "required": true
      },
      {
        "name": "b",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "No parameters.",
      "type": "object",
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.math.remap@1",
    "description": "Linear remap of [from0, from1] to [to0, to1], optional clamp",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "RemapParams",
      "type": "object",
      "properties": {
        "from": {
          "description": "Input range mapped from.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0.0,
            1.0
          ]
        },
        "to": {
          "description": "Output range mapped to.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0.0,
            1.0
          ]
        },
        "clamp": {
          "description": "Clamp to the output range.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.math.scale@1",
    "description": "in × factor",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ScaleParams",
      "type": "object",
      "properties": {
        "factor": {
          "description": "Multiplier.",
          "type": "number",
          "format": "float",
          "default": 1.0
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.noise.fbm@1",
    "description": "Fractal noise heightfield (OpenSimplex2/Perlin/… × fBm/ridged/ping-pong), parameters in metres",
    "inputs": [],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoiseParams",
      "description": "Parameters of a noise heightfield generator.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Lattice.",
          "$ref": "#/$defs/NoiseKind",
          "default": "open_simplex2"
        },
        "fractal": {
          "description": "Fractal combinator.",
          "$ref": "#/$defs/FractalKind",
          "default": "fbm"
        },
        "seed": {
          "description": "Seed (combined with the world seed by the caller when desired).",
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "feature_size_m": {
          "description": "Feature size in metres (wavelength of the first octave).",
          "type": "number",
          "format": "float",
          "default": 1024.0
        },
        "octaves": {
          "description": "Octave count (1–16).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 6
        },
        "lacunarity": {
          "description": "Frequency multiplier per octave.",
          "type": "number",
          "format": "float",
          "default": 2.0
        },
        "gain": {
          "description": "Amplitude multiplier per octave.",
          "type": "number",
          "format": "float",
          "default": 0.5
        },
        "height_range_m": {
          "description": "Output height range in metres: noise ∈ [-1,1] maps to [min, max].",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0.0,
            500.0
          ]
        },
        "offset_m": {
          "description": "Offset of the sampling origin in metres.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0.0,
            0.0
          ]
        }
      },
      "additionalProperties": false,
      "$defs": {
        "NoiseKind": {
          "description": "Base noise lattice.",
          "oneOf": [
            {
              "description": "OpenSimplex2 (fast, isotropic). Default.",
              "type": "string",
              "const": "open_simplex2"
            },
            {
              "description": "OpenSimplex2S (smoother).",
              "type": "string",
              "const": "open_simplex2_s"
            },
            {
              "description": "Improved Perlin.",
              "type": "string",
              "const": "perlin"
            },
            {
              "description": "Value noise.",
              "type": "string",
              "const": "value"
            },
            {
              "description": "Cubic value noise.",
              "type": "string",
              "const": "value_cubic"
            },
            {
              "description": "Cellular / Worley (F1 distance).",
              "type": "string",
              "const": "cellular"
            }
          ]
        },
        "FractalKind": {
          "description": "Fractal combinator.",
          "oneOf": [
            {
              "description": "Single octave.",
              "type": "string",
              "const": "none"
            },
            {
              "description": "Fractal Brownian motion. Default.",
              "type": "string",
              "const": "fbm"
            },
            {
              "description": "Ridged multifractal (mountain ridges).",
              "type": "string",
              "const": "ridged"
            },
            {
              "description": "Ping-pong (terraced/billowy).",
              "type": "string",
              "const": "ping_pong"
            }
          ]
        }
      }
    }
  },
  {
    "kind": "jd.output.height@1",
    "description": "Publishes its input as a named heightfield layer",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "OutputParams",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name the result is published under.",
          "type": "string",
          "default": "height"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "kind": "jd.sculpt.strokes@1",
    "description": "Brush strokes (raise/lower with smooth falloff) recorded as data: non-destructive, replayable, undo removes a whole stroke",
    "inputs": [
      {
        "name": "in",
        "ty": "heightfield",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "out",
        "ty": "heightfield",
        "required": false
      }
    ],
    "param_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SculptParams",
      "type": "object",
      "properties": {
        "strokes": {
          "description": "Recorded brush strokes, applied in order on top of the input.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stroke"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "$defs": {
        "Stroke": {
          "description": "One brush stroke.",
          "type": "object",
          "properties": {
            "points": {
              "description": "Polyline in layer metres: `[u east, v north]` from the south-west corner (row 0 = south).",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "radius_m": {
              "description": "Brush radius in metres.",
              "type": "number",
              "format": "float"
            },
            "strength_m": {
              "description": "Height added at the centre for `raise` (negative lowers), metres.",
              "type": "number",
              "format": "float",
              "default": 0.0
            },
            "mode": {
              "description": "Brush behaviour (default `raise`).",
              "$ref": "#/$defs/StrokeMode",
              "default": "raise"
            },
            "amount": {
              "description": "Blend factor 0..1 for `smooth` / `flatten` (default 0.5).",
              "type": "number",
              "format": "float",
              "default": 0.5
            }
          },
          "additionalProperties": false,
          "required": [
            "points",
            "radius_m"
          ]
        },
        "StrokeMode": {
          "description": "What a stroke does to the heights under the brush.",
          "oneOf": [
            {
              "description": "Add `strength_m` (negative digs).",
              "type": "string",
              "const": "raise"
            },
            {
              "description": "Blend towards the local mean (box filter ~ radius/4) by `amount`.",
              "type": "string",
              "const": "smooth"
            },
            {
              "description": "Blend towards the height under the first point by `amount`.",
              "type": "string",
              "const": "flatten"
            }
          ]
        }
      }
    }
  }
]
