{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineExportReport",
  "description": "`timeline.export` result.",
  "type": "object",
  "properties": {
    "dir": {
      "description": "Directory the frames went to.",
      "type": "string"
    },
    "frames": {
      "description": "The frames in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimelineFrame"
      }
    },
    "range_m": {
      "description": "Height range the quantised frames share, metres.",
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "duration_ms": {
      "description": "Wall time, milliseconds.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "dir",
    "frames",
    "range_m",
    "duration_ms"
  ],
  "$defs": {
    "TimelineFrame": {
      "description": "One exported frame.",
      "type": "object",
      "properties": {
        "time": {
          "description": "Timeline position.",
          "type": "number",
          "format": "float"
        },
        "file": {
          "description": "File written.",
          "type": "string"
        },
        "min": {
          "description": "Height statistics of the frame, metres.",
          "type": "number",
          "format": "float"
        },
        "max": {
          "description": "Maximum.",
          "type": "number",
          "format": "float"
        },
        "mean": {
          "description": "Mean.",
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "time",
        "file",
        "min",
        "max",
        "mean"
      ]
    }
  }
}
