{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TerrainExportMesh",
  "description": "`terrain.export_mesh` params.",
  "type": "object",
  "properties": {
    "layer": {
      "description": "Layer name.",
      "type": "string",
      "default": "height"
    },
    "path": {
      "description": "Output `.glb`, `.fbx`, `.obj`, `.stl`, `.ply`, `.usda`, `.usdc` or `.usdz`; relative paths resolve against the project's `exports/` directory.",
      "type": "string"
    },
    "step": {
      "description": "Grid step (1 = every sample). Default: the smallest step that keeps the mesh within `max_vertices`.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0,
      "default": null
    },
    "max_vertices": {
      "description": "Vertex budget used when `step` is not given (default 1025² = 1 050 625).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 1050625
    },
    "texture": {
      "description": "Embed a baked base-colour texture (hypsometric ramp + slope, one texel per vertex).",
      "type": "boolean",
      "default": true
    },
    "target_triangles": {
      "description": "Decimate the sampled grid to at most this many triangles (quadric edge collapse):\nflat ground collapses, ridges keep their detail. Not for `.fbx`.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0,
      "default": null
    },
    "materials": {
      "description": "Material layers baked into the GLB's albedo and roughness textures (see `terrain.textures`).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MaterialSpec"
      },
      "default": []
    },
    "lods": {
      "description": "Also write this many coarser levels beside the file (`<stem>_lod1.<ext>`, …), each with\na quarter of the previous level's triangles; the report lists them under `lods`. 1..=8, not for `.fbx`.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0,
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "$defs": {
    "MaterialSpec": {
      "description": "One material layer of the stack.",
      "type": "object",
      "properties": {
        "mask": {
          "description": "0..1 mask layer that weights this material (omit for everywhere).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "albedo": {
          "description": "Base colour, sRGB 0..1.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "roughness": {
          "description": "Roughness 0..1.",
          "type": "number",
          "format": "float",
          "default": 0.8999999761581421
        },
        "emissive": {
          "description": "Emitted light, linear RGB 0..1 (unset = none): a lava flow's `heat` layer, embers, windows at night.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": null
        },
        "detail": {
          "description": "Tileable detail (grain repeated every `tile_m` metres): baked into the macro maps and\nthe GLB by world position, returned as tiles for the viewport, written as tiles for\nthe engines.",
          "anyOf": [
            {
              "$ref": "#/$defs/DetailSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "albedo"
      ]
    },
    "DetailSpec": {
      "description": "A layer's tileable detail.",
      "type": "object",
      "properties": {
        "tile_m": {
          "description": "Metres per repeat.",
          "type": "number",
          "format": "float",
          "minimum": 0.01,
          "maximum": 100000.0,
          "default": 8.0
        },
        "bump": {
          "description": "Normal strength 0..1.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.5
        },
        "contrast": {
          "description": "Albedo variation 0..1.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.30000001192092896
        },
        "seed": {
          "description": "Noise seed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "px": {
          "description": "Tile side in pixels (16..=2048).",
          "type": "integer",
          "format": "uint32",
          "minimum": 16,
          "maximum": 2048,
          "default": 512
        }
      },
      "additionalProperties": false
    }
  }
}
