{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WaterExportResult",
  "description": "`water.export` result.",
  "type": "object",
  "properties": {
    "path": {
      "description": "File written.",
      "type": "string"
    },
    "triangles": {
      "description": "Triangles written (0 for `.json`).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "bytes": {
      "description": "Bytes written.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "layers": {
      "description": "The water-depth layers merged into the surface.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "falls": {
      "description": "Waterfalls drawn as sheets.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "path",
    "triangles",
    "bytes",
    "layers",
    "falls"
  ]
}
