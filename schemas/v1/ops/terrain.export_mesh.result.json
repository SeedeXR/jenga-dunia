{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeshExportReport",
  "description": "What `export_glb` wrote.",
  "type": "object",
  "properties": {
    "path": {
      "description": "Written file.",
      "type": "string"
    },
    "format": {
      "description": "Always `glb`.",
      "type": "string"
    },
    "vertices": {
      "description": "Vertex count.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "triangles": {
      "description": "Triangle count.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "step": {
      "description": "Grid step used (1 = every sample).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "bytes": {
      "description": "Bytes written.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "extent_m": {
      "description": "World extent covered, metres.",
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "texture_px": {
      "description": "Baked base-colour texture size in pixels when one was embedded.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "normal_px": {
      "description": "Baked normal + roughness map size in pixels (full field resolution, capped at 2048²).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "topology": {
      "description": "Topology of the written triangles (None for FBX, which writes quads).",
      "anyOf": [
        {
          "$ref": "#/$defs/MeshTopology"
        },
        {
          "type": "null"
        }
      ]
    },
    "lods": {
      "description": "Coarser levels written beside this file (`<stem>_lod1.<ext>`, …), each with about a\nquarter of the previous level's triangles.",
      "type": "array",
      "items": {
        "$ref": "#"
      }
    }
  },
  "required": [
    "path",
    "format",
    "vertices",
    "triangles",
    "step",
    "bytes",
    "extent_m"
  ],
  "$defs": {
    "MeshTopology": {
      "description": "Topology summary of an indexed triangle list — the checks a mesh importer trips over.\nA closed-grid terrain has 0 degenerate, 0 non-manifold, 0 unreferenced and a perimeter of\nboundary edges; decimation must keep it that way.",
      "type": "object",
      "properties": {
        "degenerate": {
          "description": "Triangles that repeat a vertex (zero area by construction).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "boundary_edges": {
          "description": "Edges used by exactly one triangle (the outline; holes add to it).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "non_manifold_edges": {
          "description": "Edges shared by more than two triangles.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "unreferenced_vertices": {
          "description": "Vertices no triangle references.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "out_of_range": {
          "description": "Indices past the vertex count (a broken file; always 0 from our writers).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "degenerate",
        "boundary_edges",
        "non_manifold_edges",
        "unreferenced_vertices",
        "out_of_range"
      ]
    }
  }
}
