{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeshExportReport",
  "description": "What `export_glb` wrote.",
  "type": "object",
  "properties": {
    "path": {
      "description": "Written file.",
      "type": "string"
    },
    "format": {
      "description": "Always `glb`.",
      "type": "string"
    },
    "vertices": {
      "description": "Vertex count.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "triangles": {
      "description": "Triangle count.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "step": {
      "description": "Grid step used (1 = every sample).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "bytes": {
      "description": "Bytes written.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "extent_m": {
      "description": "World extent covered, metres.",
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": [
    "path",
    "format",
    "vertices",
    "triangles",
    "step",
    "bytes",
    "extent_m"
  ]
}
