{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AddSimulation",
  "description": "`graph.add_simulation` params.",
  "type": "object",
  "properties": {
    "which": {
      "description": "Which simulation.",
      "$ref": "#/$defs/Simulation"
    },
    "max_height_m": {
      "description": "The shown layer's highest point (m): snow's sea-level temperature puts the snow line\nat six tenths of it. Default 500.",
      "type": [
        "number",
        "null"
      ],
      "format": "double",
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "which"
  ],
  "$defs": {
    "Simulation": {
      "description": "Simulation layers the viewport's layer strip adds.",
      "oneOf": [
        {
          "description": "`jd.climate.snowpack@1` beside the height (cover published as `snow`).",
          "type": "string",
          "const": "snow"
        },
        {
          "description": "`jd.erosion.aeolian@1` in front of the height.",
          "type": "string",
          "const": "sand"
        },
        {
          "description": "`jd.erosion.debris@1` in front of the height (`debris` published).",
          "type": "string",
          "const": "debris"
        },
        {
          "description": "`jd.volcanic.lava@1` in front of the height (`heat` and `lava` published, glowing).",
          "type": "string",
          "const": "lava"
        }
      ]
    }
  }
}
