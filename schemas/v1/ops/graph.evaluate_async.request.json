{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluate",
  "description": "`graph.evaluate` params.",
  "type": "object",
  "properties": {
    "lod": {
      "description": "Level of detail (0 = full resolution).",
      "type": "integer",
      "format": "uint8",
      "minimum": 0,
      "maximum": 255,
      "default": 0
    },
    "timeout_s": {
      "description": "Detached jobs only: give up after this many seconds (`E_TIMEOUT` in the result).",
      "type": [
        "number",
        "null"
      ],
      "format": "float",
      "default": null
    }
  },
  "additionalProperties": false
}
