{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectSetLook",
  "description": "`project.set_look` params: fields left out keep their value.",
  "type": "object",
  "properties": {
    "materials": {
      "description": "The whole material stack.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/MaterialSpec"
      },
      "default": null
    },
    "scatter": {
      "description": "Scatter settings.",
      "anyOf": [
        {
          "$ref": "#/$defs/ScatterLook"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sun": {
      "description": "Sun and sky.",
      "anyOf": [
        {
          "$ref": "#/$defs/SunLook"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "$defs": {
    "MaterialSpec": {
      "description": "One material layer of the stack.",
      "type": "object",
      "properties": {
        "mask": {
          "description": "0..1 mask layer that weights this material (omit for everywhere).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "albedo": {
          "description": "Base colour, sRGB 0..1.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "roughness": {
          "description": "Roughness 0..1.",
          "type": "number",
          "format": "float",
          "default": 0.8999999761581421
        },
        "emissive": {
          "description": "Emitted light, linear RGB 0..1 (unset = none): a lava flow's `heat` layer, embers, windows at night.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": null
        },
        "detail": {
          "description": "Tileable detail (grain repeated every `tile_m` metres): baked into the macro maps and\nthe GLB by world position, returned as tiles for the viewport, written as tiles for\nthe engines.",
          "anyOf": [
            {
              "$ref": "#/$defs/DetailSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "albedo"
      ]
    },
    "DetailSpec": {
      "description": "A layer's tileable detail.",
      "type": "object",
      "properties": {
        "tile_m": {
          "description": "Metres per repeat.",
          "type": "number",
          "format": "float",
          "minimum": 0.01,
          "maximum": 100000.0,
          "default": 8.0
        },
        "bump": {
          "description": "Normal strength 0..1.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.5
        },
        "contrast": {
          "description": "Albedo variation 0..1.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.30000001192092896
        },
        "seed": {
          "description": "Noise seed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "px": {
          "description": "Tile side in pixels (16..=2048).",
          "type": "integer",
          "format": "uint32",
          "minimum": 16,
          "maximum": 2048,
          "default": 512
        }
      },
      "additionalProperties": false
    },
    "ScatterLook": {
      "description": "Scatter settings of the look.",
      "type": "object",
      "properties": {
        "mask": {
          "description": "Density mask layer, or none.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "spacing_m": {
          "description": "Spacing between instances, metres (> 0).",
          "type": "number",
          "format": "float"
        },
        "seed": {
          "description": "Seed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "grow": {
          "description": "The population follows the timeline.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "spacing_m"
      ]
    },
    "SunLook": {
      "description": "Sun and sky of the look.",
      "type": "object",
      "properties": {
        "azimuth_deg": {
          "description": "Sun azimuth, degrees clockwise from north.",
          "type": "number",
          "format": "float"
        },
        "elevation_deg": {
          "description": "Sun elevation above the horizon, degrees (0, 90].",
          "type": "number",
          "format": "float"
        },
        "turbidity": {
          "description": "Turbidity 2..=10.",
          "type": "number",
          "format": "float",
          "default": 3.0
        },
        "clouds": {
          "description": "Cloud cover 0..=1.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "fog": {
          "description": "Viewport fog 0..=1.",
          "type": "number",
          "format": "float",
          "default": 0.0
        }
      },
      "additionalProperties": false,
      "required": [
        "azimuth_deg",
        "elevation_deg"
      ]
    }
  }
}
