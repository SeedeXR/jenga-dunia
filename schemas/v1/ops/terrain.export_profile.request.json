{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TerrainExportProfile",
  "description": "`terrain.export_profile` params.",
  "type": "object",
  "properties": {
    "profile": {
      "description": "Target engine.",
      "$ref": "#/$defs/EngineProfile"
    },
    "dir": {
      "description": "Output directory; relative paths resolve against the project's `exports/`.",
      "type": "string"
    },
    "layer": {
      "description": "Height layer.",
      "type": "string",
      "default": "height"
    },
    "masks": {
      "description": "0..1 mask layers written as weightmaps (`weight_<name>.png`).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "range_m": {
      "description": "Height range to encode (default: the layer's min/max).",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number",
        "format": "float"
      },
      "minItems": 2,
      "maxItems": 2,
      "default": null
    },
    "tiles": {
      "description": "Cut the export into `tiles × tiles` engine folders (`tile_<x>_<y>/`) sharing one height range, with a `tiles.json` manifest; the resolution must divide (2..=16).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0,
      "default": null
    },
    "materials": {
      "description": "The material stack to translate: masked layers become weightmaps, `materials.json` carries the look, and the report's `loss` lists what the engine cannot take.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MaterialSpec"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "required": [
    "profile",
    "dir"
  ],
  "$defs": {
    "EngineProfile": {
      "description": "Target engine.",
      "oneOf": [
        {
          "description": "Unity Terrain: RAW 16-bit little-endian, row 0 = south (no flip), Terrain Height = range.",
          "type": "string",
          "const": "unity"
        },
        {
          "description": "Unreal Landscape: PNG16, row 0 = north, Z scale = range_m × 100 / 512, 8-bit weightmaps.",
          "type": "string",
          "const": "unreal"
        }
      ]
    },
    "MaterialSpec": {
      "description": "One material layer of the stack.",
      "type": "object",
      "properties": {
        "mask": {
          "description": "0..1 mask layer that weights this material (omit for everywhere).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "albedo": {
          "description": "Base colour, sRGB 0..1.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "roughness": {
          "description": "Roughness 0..1.",
          "type": "number",
          "format": "float",
          "default": 0.8999999761581421
        },
        "emissive": {
          "description": "Emitted light, linear RGB 0..1 (unset = none): a lava flow's `heat` layer, embers, windows at night.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": null
        },
        "detail": {
          "description": "Tileable detail (grain repeated every `tile_m` metres): baked into the macro maps and\nthe GLB by world position, returned as tiles for the viewport, written as tiles for\nthe engines.",
          "anyOf": [
            {
              "$ref": "#/$defs/DetailSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "albedo"
      ]
    },
    "DetailSpec": {
      "description": "A layer's tileable detail.",
      "type": "object",
      "properties": {
        "tile_m": {
          "description": "Metres per repeat.",
          "type": "number",
          "format": "float",
          "minimum": 0.01,
          "maximum": 100000.0,
          "default": 8.0
        },
        "bump": {
          "description": "Normal strength 0..1.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.5
        },
        "contrast": {
          "description": "Albedo variation 0..1.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.30000001192092896
        },
        "seed": {
          "description": "Noise seed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "px": {
          "description": "Tile side in pixels (16..=2048).",
          "type": "integer",
          "format": "uint32",
          "minimum": 16,
          "maximum": 2048,
          "default": 512
        }
      },
      "additionalProperties": false
    }
  }
}
