{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Jenga Dunia",
  "version": "0.0.1",
  "identifier": "com.seedexr.jengadunia",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Jenga Dunia",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "macOS": { "files": { "Resources/Assets.car": "icons/Assets.car" } },
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Procedural world generation and environmental simulation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["jdproj"],
        "name": "Jenga Dunia Project",
        "description": "Jenga Dunia project directory",
        "role": "Editor"
      }
    ]
  }
}
