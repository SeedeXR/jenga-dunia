            "kind"
          ]
        },
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        },
        "NodeKind": {
          "description": "A node kind identifier `namespace.name@version`, e.g. `jd.noise.fbm@1`.",
          "type": "string"
        },
        "UiMeta": {
          "description": "Editor-only metadata.",
          "type": "object",
          "properties": {
            "position": {
              "description": "Canvas position.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0.0,
                0.0
              ]
            },
            "label": {
              "description": "Display label override.",
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "Edge": {
          "description": "A directed connection from an output port to an input port.",
          "type": "object",
          "properties": {
            "from": {
              "description": "Source output.",
              "$ref": "#/$defs/PortRef"
            },
            "to": {
              "description": "Destination input.",
              "$ref": "#/$defs/PortRef"
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        "PortRef": {
          "description": "One end of an edge.",
          "type": "object",
          "properties": {
            "node": {
              "description": "Node id.",
              "$ref": "#/$defs/NodeId"
            },
            "port": {
              "description": "Port name.",
              "type": "string"
            }
          },
          "required": [
            "node",
            "port"
          ]
        }
      }
    }
  },
  {
    "id": "graph.move_node",
    "description": "Move a node on the editor canvas (journaled)",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "MoveNode",
      "description": "`graph.move_node` params.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Node id.",
          "$ref": "#/$defs/NodeId"
        },
        "position": {
          "description": "New editor position.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "position"
      ],
      "$defs": {
        "NodeId": {
