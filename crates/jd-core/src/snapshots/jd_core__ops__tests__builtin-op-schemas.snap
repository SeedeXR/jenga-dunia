          "description": "Significant wave height Hs (mean of the highest third), m.",
          "type": "number",
          "format": "float"
        },
        "peak_period_s": {
          "description": "Peak period Tp, s.",
          "type": "number",
          "format": "float"
        },
        "wavelength_m": {
          "description": "Peak wavelength, m.",
          "type": "number",
          "format": "float"
        },
        "fully_developed": {
          "description": "Whether the fetch was long enough for the sea to be fully developed for this wind.",
          "type": "boolean"
        },
        "breaking_depth_m": {
          "description": "Depth (m) shallower than which waves of this height break (H/d = 0.78): the surf zone.",
          "type": "number",
          "format": "float"
        },
        "components": {
          "description": "Gerstner components, largest first.",
