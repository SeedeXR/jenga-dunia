        "tile_size",
        "halo",
        "stats",
        "content_hash",
        "duration_ms"
      ],
      "$defs": {
        "HeightfieldStats": {
          "description": "Summary statistics over the whole field.",
          "type": "object",
          "properties": {
            "min": {
              "description": "Minimum height.",
              "type": "number",
              "format": "float"
            },
            "max": {
              "description": "Maximum height.",
              "type": "number",
              "format": "float"
            },
            "mean": {
              "description": "Mean height.",
              "type": "number",
              "format": "double"
            },
            "non_finite": {
              "description": "Count of non-finite samples (must be 0 for a valid field).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "min",
            "max",
            "mean",
            "non_finite"
          ]
        }
      }
    }
  }
]
