    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "LayerInfo",
      "description": "Result of `terrain.generate` / `terrain.stats`.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string"
        },
        "size_px": {
          "description": "Width, height in pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "tile_size": {
          "description": "Tile size and halo.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "halo": {
          "description": "Halo.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stats": {
          "description": "Statistics.",
          "$ref": "#/$defs/HeightfieldStats"
        },
        "content_hash": {
          "description": "blake3 content hash (hex).",
