---
source: crates/jd-core/src/ops.rs
expression: list
---
[
  {
    "id": "caves.export",
    "description": "Write a `jd.cave.system@1` node's cave (walls + speleothems) at full resolution as .glb or .fbx in the terrain export frame, so it drops under the terrain mesh / engine terrain as is — or its skeleton as .json (passages, chambers, entrances, speleothems, water level) for gameplay",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CaveExport",
      "description": "`caves.export` params.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The `jd.cave.system@1` node.",
          "$ref": "#/$defs/NodeId"
        },
        "path": {
          "description": "`.glb` or `.fbx` (the walls), `.json` (the skeleton: passages, chambers, entrances,\nspeleothems, water level); relative paths land in the project's `exports/`.",
          "type": "string"
        },
        "voxel_m": {
          "description": "Voxel size, metres (omitted = automatic).",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "speleothems": {
          "description": "Include the speleothems (default true).",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "$defs": {
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CaveExportResult",
      "description": "`caves.export` result.",
      "type": "object",
      "properties": {
        "path": {
          "description": "File written.",
          "type": "string"
        },
        "triangles": {
          "description": "Triangles written.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bytes": {
          "description": "Bytes written.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "voxel_m": {
          "description": "Voxel size used, metres.",
          "type": "number",
          "format": "float"
        },
        "length_m": {
          "description": "Total passage length, metres.",
          "type": "number",
          "format": "float"
        },
        "entrances": {
          "description": "Where the cave opens.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entrance"
          }
        },
        "notes": {
          "description": "What the generator wants you to know.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "path",
        "triangles",
        "bytes",
        "voxel_m",
        "length_m",
        "entrances",
        "notes"
      ],
      "$defs": {
        "Entrance": {
          "description": "Where a cave opens.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Position `[u, v, z]` on the surface, metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "kind": {
              "description": "Kind.",
              "$ref": "#/$defs/EntranceKind"
            },
            "underwater": {
              "description": "Below the system's water level (a diver's entrance).",
              "type": "boolean"
            }
          },
          "required": [
            "at",
            "kind",
            "underwater"
          ]
        },
        "EntranceKind": {
          "description": "How a cave meets the surface.",
          "oneOf": [
            {
              "description": "A doline / sinkhole swallowing water into the cave (karst inlet).",
              "type": "string",
              "const": "sinkhole"
            },
            {
              "description": "A cave mouth at the foot of a slope or cliff; a mine adit; a tunnel portal.",
              "type": "string",
              "const": "portal"
            },
            {
              "description": "A roof collapse into a lava tube.",
              "type": "string",
              "const": "skylight"
            },
            {
              "description": "Where the cave's water comes out: a spring, often under a lake, river or the sea.",
              "type": "string",
              "const": "resurgence"
            },
            {
              "description": "A wave-cut notch at sea level.",
              "type": "string",
              "const": "sea_cave"
            },
            {
              "description": "A vertical shaft from the surface.",
              "type": "string",
              "const": "shaft"
            }
          ]
        }
      }
    }
  },
  {
    "id": "caves.mesh",
    "description": "The 3-D walls and speleothems of a `jd.cave.system@1` node as mesh arrays for a viewport (terrain export frame), with its entrances, water level, length and the generator's notes",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CaveMeshParams",
      "description": "`caves.mesh` params.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The `jd.cave.system@1` node.",
          "$ref": "#/$defs/NodeId"
        },
        "lod": {
          "description": "Evaluation lod (0 = full resolution; a viewport passes its preview lod).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 0
        },
        "voxel_m": {
          "description": "Voxel size, metres (omitted = about five voxels across the narrowest passage, coarser so\nthe walls stay near 400 k triangles).",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "$defs": {
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CaveMeshResult",
      "description": "`caves.mesh` result.",
      "type": "object",
      "properties": {
        "walls": {
          "description": "The cave walls (normals face into the cave).",
          "$ref": "#/$defs/MeshArrays"
        },
        "speleothems": {
          "description": "Stalactites, stalagmites and columns.",
          "$ref": "#/$defs/MeshArrays"
        },
        "voxel_m": {
          "description": "Voxel size used, metres.",
          "type": "number",
          "format": "float"
        },
        "water_level_m": {
          "description": "Water level, metres: flooded below.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "length_m": {
          "description": "Total passage length, metres.",
          "type": "number",
          "format": "float"
        },
        "passages": {
          "description": "Passages and chambers.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "chambers": {
          "description": "Chambers.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "entrances": {
          "description": "Where the cave opens.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entrance"
          }
        },
        "speleothem_count": {
          "description": "Speleothems placed.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "notes": {
          "description": "What the generator wants you to know.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "walls",
        "speleothems",
        "voxel_m",
        "length_m",
        "passages",
        "chambers",
        "entrances",
        "speleothem_count",
        "notes"
      ],
      "$defs": {
        "MeshArrays": {
          "description": "A mesh as little-endian arrays in the terrain export frame (x east, y up, z south).",
          "type": "object",
          "properties": {
            "positions_base64": {
              "description": "f32 xyz per vertex, base64.",
              "type": "string"
            },
            "normals_base64": {
              "description": "f32 unit normals per vertex, base64.",
              "type": "string"
            },
            "indices_base64": {
              "description": "u32 triangle indices, base64.",
              "type": "string"
            },
            "triangles": {
              "description": "Triangle count.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "positions_base64",
            "normals_base64",
            "indices_base64",
            "triangles"
          ]
        },
        "Entrance": {
          "description": "Where a cave opens.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Position `[u, v, z]` on the surface, metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "kind": {
              "description": "Kind.",
              "$ref": "#/$defs/EntranceKind"
            },
            "underwater": {
              "description": "Below the system's water level (a diver's entrance).",
              "type": "boolean"
            }
          },
          "required": [
            "at",
            "kind",
            "underwater"
          ]
        },
        "EntranceKind": {
          "description": "How a cave meets the surface.",
          "oneOf": [
            {
              "description": "A doline / sinkhole swallowing water into the cave (karst inlet).",
              "type": "string",
              "const": "sinkhole"
            },
            {
              "description": "A cave mouth at the foot of a slope or cliff; a mine adit; a tunnel portal.",
              "type": "string",
              "const": "portal"
            },
            {
              "description": "A roof collapse into a lava tube.",
              "type": "string",
              "const": "skylight"
            },
            {
              "description": "Where the cave's water comes out: a spring, often under a lake, river or the sea.",
              "type": "string",
              "const": "resurgence"
            },
            {
              "description": "A wave-cut notch at sea level.",
              "type": "string",
              "const": "sea_cave"
            },
            {
              "description": "A vertical shaft from the surface.",
              "type": "string",
              "const": "shaft"
            }
          ]
        }
      }
    }
  },
  {
    "id": "diag.bench",
    "description": "Run a benchmark scene (S1: fBm + ridged + add + thermal×50) with the real kernels; per-stage wall time, peak RSS, content hash",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "BenchParams",
      "description": "`diag.bench` params.",
      "type": "object",
      "properties": {
        "scene": {
          "description": "Scene to run.",
          "$ref": "#/$defs/BenchScene",
          "default": "s1"
        },
        "size_px": {
          "description": "Square size in pixels (S1 default 1024).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false,
      "$defs": {
        "BenchScene": {
          "description": "Benchmark scenes (`docs/spec/performance-targets.md`).",
          "oneOf": [
            {
              "description": "S1-small-interactive: fBm + ridged noise, add, thermal erosion (50 steps) — the preview path.",
              "type": "string",
              "const": "s1"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "BenchReport",
      "description": "`diag.bench` result.",
      "type": "object",
      "properties": {
        "scene": {
          "description": "Scene.",
          "$ref": "#/$defs/BenchScene"
        },
        "size_px": {
          "description": "Square size in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stages": {
          "description": "Stages in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BenchStage"
          }
        },
        "total_ms": {
          "description": "Sum of the stages, milliseconds.",
          "type": "number",
          "format": "double"
        },
        "peak_rss_bytes": {
          "description": "Highest resident set size of this process observed between stages, bytes (None when the\nplatform does not report it).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "profile": {
          "description": "`debug` or `release` — debug numbers are not comparable with the spec's targets.",
          "type": "string"
        },
        "content_hash": {
          "description": "Content hash of the final field (determinism check across runs and machines).",
          "type": "string"
        }
      },
      "required": [
        "scene",
        "size_px",
        "stages",
        "total_ms",
        "profile",
        "content_hash"
      ],
      "$defs": {
        "BenchScene": {
          "description": "Benchmark scenes (`docs/spec/performance-targets.md`).",
          "oneOf": [
            {
              "description": "S1-small-interactive: fBm + ridged noise, add, thermal erosion (50 steps) — the preview path.",
              "type": "string",
              "const": "s1"
            }
          ]
        },
        "BenchStage": {
          "description": "One timed stage.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Stage name.",
              "type": "string"
            },
            "ms": {
              "description": "Wall time in milliseconds.",
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "name",
            "ms"
          ]
        }
      }
    }
  },
  {
    "id": "diag.bundle",
    "description": "Write a diagnostic bundle for a bug report: host environment, project.json / graph.json / scene.json, the tail of the journal, versions — no heightfield data",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "DiagBundle",
      "description": "`diag.bundle` params.",
      "type": "object",
      "properties": {
        "dir": {
          "description": "Output directory; relative paths resolve against the project's `exports/`. Default `exports/diagnostics-<UTC stamp>`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "journal_lines": {
          "description": "How many journal entries to include from the end.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 200
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "DiagBundleReport",
      "description": "`diag.bundle` result.",
      "type": "object",
      "properties": {
        "dir": {
          "description": "Where the bundle went.",
          "type": "string"
        },
        "files": {
          "description": "Files written.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bytes": {
          "description": "Total bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "dir",
        "files",
        "bytes"
      ]
    }
  },
  {
    "id": "diag.crash_report",
    "description": "Record a crash the front end caught (message, stack, where) as a JSON report beside the project's ops log — or in the temp dir when no project is open — with the version, OS and architecture",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CrashReportParams",
      "description": "`diag.crash_report` params: a crash the front end caught (an uncaught error, a failed render).",
      "type": "object",
      "properties": {
        "message": {
          "description": "The error message.",
          "type": "string"
        },
        "stack": {
          "description": "The stack trace, when known.",
          "type": "string",
          "default": ""
        },
        "source": {
          "description": "Where it happened (`window`, `promise`, `render`, …).",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "message"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CrashReportResult",
      "description": "`diag.crash_report` result.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The report written.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ]
    }
  },
  {
    "id": "diag.env",
    "description": "Report host environment and detected tools",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "EnvInfo",
      "description": "Snapshot of the host environment.",
      "type": "object",
      "properties": {
        "app_version": {
          "description": "Jenga Dunia version.",
          "type": "string"
        },
        "os": {
          "description": "OS name and version.",
          "type": "string"
        },
        "arch": {
          "description": "CPU architecture.",
          "type": "string"
        },
        "cpus": {
          "description": "Logical CPU count.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "memory_total_bytes": {
          "description": "Total physical memory in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "memory_available_bytes": {
          "description": "Currently available memory in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cwd": {
          "description": "Current working directory.",
          "type": "string"
        },
        "tools": {
          "description": "Optional external tools (validators, DCCs) detected on PATH.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolStatus"
          }
        }
      },
      "required": [
        "app_version",
        "os",
        "arch",
        "cpus",
        "memory_total_bytes",
        "memory_available_bytes",
        "cwd",
        "tools"
      ],
      "$defs": {
        "ToolStatus": {
          "description": "Presence of an optional external tool on `PATH`.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Tool name.",
              "type": "string"
            },
            "path": {
              "description": "Resolved path, if found.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name"
          ]
        }
      }
    }
  },
  {
    "id": "fbx.sdk_check",
    "description": "Read an FBX file through the Autodesk FBX SDK (when this build carries it) and report what the SDK sees: version, meshes, control points, polygons and triangles, bounds, units, up axis, normals, UVs, material and texture — the reference view of our own FBX writer",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SdkCheck",
      "description": "`fbx.sdk_check` params.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The FBX file (absolute, or relative to the project's `exports/`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SdkReport",
      "description": "`fbx.sdk_check` result.",
      "type": "object",
      "properties": {
        "sdk": {
          "description": "The SDK's version string.",
          "type": "string"
        },
        "file_version": {
          "description": "The file's version as the SDK reports it (7400, 7500, …).",
          "type": "integer",
          "format": "int32"
        },
        "meshes": {
          "description": "Meshes in the scene; the rest describes the first.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "vertices": {
          "description": "Control points.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "polygons": {
          "description": "Polygons before the SDK's triangulation.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "triangles": {
          "description": "Triangles after it.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bounds": {
          "description": "Bounds of the control points in file units, `[min, max]`.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 2,
          "maxItems": 2
        },
        "unit_scale": {
          "description": "Centimetres per file unit (1 = cm, 100 = m).",
          "type": "number",
          "format": "double"
        },
        "up_axis": {
          "description": "`Y` or `Z`.",
          "type": "string"
        },
        "has_normals": {
          "description": "A normal layer element exists.",
          "type": "boolean"
        },
        "has_uvs": {
          "description": "A UV layer element exists.",
          "type": "boolean"
        },
        "material": {
          "description": "First material's name.",
          "type": [
            "string",
            "null"
          ]
        },
        "texture": {
          "description": "First diffuse texture's relative file name.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "sdk",
        "file_version",
        "meshes",
        "vertices",
        "polygons",
        "triangles",
        "bounds",
        "unit_scale",
        "up_axis",
        "has_normals",
        "has_uvs"
      ]
    }
  },
  {
    "id": "geo.attributions",
    "description": "The project's consolidated data-source notices (what every export's ATTRIBUTION.txt carries)",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AttributionsResult",
      "description": "`geo.attributions` result.",
      "type": "object",
      "properties": {
        "attribution": {
          "description": "The notices on the project.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attribution"
          }
        },
        "text": {
          "description": "The `ATTRIBUTION.txt` text exports carry.",
          "type": "string"
        }
      },
      "required": [
        "attribution",
        "text"
      ],
      "$defs": {
        "Attribution": {
          "description": "A data-source attribution obligation carried into exports.",
          "type": "object",
          "properties": {
            "source": {
              "description": "Source name (e.g. \"Copernicus DEM GLO-30\").",
              "type": "string"
            },
            "text": {
              "description": "Required notice text.",
              "type": "string"
            },
            "url": {
              "description": "Licence or terms URL.",
              "type": "string"
            },
            "licence": {
              "description": "Licence name or terms in a line.",
              "type": "string"
            }
          },
          "required": [
            "source",
            "text"
          ]
        }
      }
    }
  },
  {
    "id": "geo.fetch_dem",
    "description": "Fetch a DEM for a lon/lat box (Terrarium tiles, Copernicus GLO-30, or OpenTopography with your key) into assets/ as a georeferenced f32 GeoTIFF, cached under cache/geo, with the provider's attribution recorded — then `jd.input.heightmap@1 {path, georeference: true}` places it",
    "scope": "network-geo",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FetchDem",
      "description": "`geo.fetch_dem` params.",
      "type": "object",
      "properties": {
        "bbox": {
          "description": "Lon/lat box in degrees.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bbox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "center": {
          "description": "`[lon, lat]` of the centre (with `radius_m`).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "radius_m": {
          "description": "Half-size of the box around `center`, metres.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "provider": {
          "description": "`terrarium` (default; no key), `copernicus` (1° tiles, ~25 MB each) or `opentopography`\n(needs `api_key`).",
          "$ref": "#/$defs/Provider",
          "default": "terrarium"
        },
        "res_m": {
          "description": "Target ground resolution in metres (Terrarium picks the nearest zoom; the others are 30 m).",
          "type": "number",
          "format": "double",
          "minimum": 1.0,
          "maximum": 10000.0,
          "default": 30.0
        },
        "name": {
          "description": "Asset file name (`.tif`); default `dem-<provider>-<lat>_<lon>.tif`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "overwrite": {
          "description": "Replace an existing asset of that name.",
          "type": "boolean",
          "default": false
        },
        "api_key": {
          "description": "Your OpenTopography key (or `JD_OPENTOPOGRAPHY_KEY`); never stored.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "offline": {
          "description": "Serve the cache only (also `JD_OFFLINE=1`).",
          "type": "boolean",
          "default": false
        },
        "base_url": {
          "description": "Tests only: a loopback server standing in for the provider.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "$defs": {
        "Bbox": {
          "description": "A lon/lat box in degrees.",
          "type": "object",
          "properties": {
            "south": {
              "description": "Southern edge, degrees.",
              "type": "number",
              "format": "double"
            },
            "west": {
              "description": "Western edge, degrees.",
              "type": "number",
              "format": "double"
            },
            "north": {
              "description": "Northern edge, degrees.",
              "type": "number",
              "format": "double"
            },
            "east": {
              "description": "Eastern edge, degrees.",
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "south",
            "west",
            "north",
            "east"
          ]
        },
        "Provider": {
          "description": "Which provider a request names.",
          "oneOf": [
            {
              "description": "AWS Terrain Tiles, Terrarium PNG (no key, no quota; Mapzen + per-source credits).",
              "type": "string",
              "const": "terrarium"
            },
            {
              "description": "Copernicus DEM GLO-30 COGs on AWS (no key; the 6(b)/6(c) notices).",
              "type": "string",
              "const": "copernicus"
            },
            {
              "description": "OpenTopography global DEM API (bring your own key; 50 calls a day).",
              "type": "string",
              "const": "opentopography"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FetchDemResult",
      "description": "`geo.fetch_dem` result.",
      "type": "object",
      "properties": {
        "asset": {
          "description": "The asset's file name (what `jd.input.heightmap@1 {path}` takes).",
          "type": "string"
        },
        "path": {
          "description": "Where it was written.",
          "type": "string"
        },
        "provider": {
          "description": "The provider used.",
          "$ref": "#/$defs/Provider"
        },
        "px": {
          "description": "Raster size.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "spacing": {
          "description": "Sample spacing in the raster's CRS units.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "crs": {
          "description": "CRS of the raster (`EPSG:3857` for Terrarium, `EPSG:4326` otherwise).",
          "type": "string"
        },
        "origin": {
          "description": "Outer south-west corner in `crs` units.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "height_m": {
          "description": "Height range, metres.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "void_share": {
          "description": "Share of nodata samples filled, 0..1.",
          "type": "number",
          "format": "float"
        },
        "fetch": {
          "description": "Fetch statistics.",
          "$ref": "#/$defs/Stats"
        },
        "attribution": {
          "description": "The notice appended to the project.",
          "$ref": "#/$defs/Attribution"
        },
        "next": {
          "description": "How to use it.",
          "type": "string"
        }
      },
      "required": [
        "asset",
        "path",
        "provider",
        "px",
        "spacing",
        "crs",
        "origin",
        "height_m",
        "void_share",
        "fetch",
        "attribution",
        "next"
      ],
      "$defs": {
        "Provider": {
          "description": "Which provider a request names.",
          "oneOf": [
            {
              "description": "AWS Terrain Tiles, Terrarium PNG (no key, no quota; Mapzen + per-source credits).",
              "type": "string",
              "const": "terrarium"
            },
            {
              "description": "Copernicus DEM GLO-30 COGs on AWS (no key; the 6(b)/6(c) notices).",
              "type": "string",
              "const": "copernicus"
            },
            {
              "description": "OpenTopography global DEM API (bring your own key; 50 calls a day).",
              "type": "string",
              "const": "opentopography"
            }
          ]
        },
        "Stats": {
          "description": "What a batch cost.",
          "type": "object",
          "properties": {
            "requests": {
              "description": "Requests in the batch.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "cache_hits": {
              "description": "Requests answered from the cache.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "bytes": {
              "description": "Bytes that crossed the wire (a 304 counts nothing).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "retries": {
              "description": "Retries across the batch.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "connections": {
              "description": "Connections in use when the batch ended.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "bytes_per_s": {
              "description": "Throughput estimate at the end, bytes per second.",
              "type": "number",
              "format": "double"
            },
            "elapsed_ms": {
              "description": "Wall time of the batch.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "requests",
            "cache_hits",
            "bytes",
            "retries",
            "connections",
            "bytes_per_s",
            "elapsed_ms"
          ]
        },
        "Attribution": {
          "description": "A data-source attribution obligation carried into exports.",
          "type": "object",
          "properties": {
            "source": {
              "description": "Source name (e.g. \"Copernicus DEM GLO-30\").",
              "type": "string"
            },
            "text": {
              "description": "Required notice text.",
              "type": "string"
            },
            "url": {
              "description": "Licence or terms URL.",
              "type": "string"
            },
            "licence": {
              "description": "Licence name or terms in a line.",
              "type": "string"
            }
          },
          "required": [
            "source",
            "text"
          ]
        }
      }
    }
  },
  {
    "id": "geo.fetch_features",
    "description": "Fetch OpenStreetMap roads, waterways, water bodies and buildings for a lon/lat box through the Overpass API into assets/ as a GeoJSON file (ODbL; kept separately labelled), with the OSM attribution recorded",
    "scope": "network-geo",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FetchFeatures",
      "description": "`geo.fetch_features` params.",
      "type": "object",
      "properties": {
        "bbox": {
          "description": "Lon/lat box in degrees.",
          "anyOf": [
            {
              "$ref": "#/$defs/Bbox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "center": {
          "description": "`[lon, lat]` of the centre (with `radius_m`).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "radius_m": {
          "description": "Half-size of the box around `center`, metres.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "kinds": {
          "description": "Feature families; default all four.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Kind"
          },
          "default": null
        },
        "name": {
          "description": "Asset file name (`.geojson`); default `osm-<lat>_<lon>.geojson`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "overwrite": {
          "description": "Replace an existing asset of that name.",
          "type": "boolean",
          "default": false
        },
        "offline": {
          "description": "Serve the cache only (also `JD_OFFLINE=1`).",
          "type": "boolean",
          "default": false
        },
        "base_url": {
          "description": "Tests only: a loopback server standing in for Overpass.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "$defs": {
        "Bbox": {
          "description": "A lon/lat box in degrees.",
          "type": "object",
          "properties": {
            "south": {
              "description": "Southern edge, degrees.",
              "type": "number",
              "format": "double"
            },
            "west": {
              "description": "Western edge, degrees.",
              "type": "number",
              "format": "double"
            },
            "north": {
              "description": "Northern edge, degrees.",
              "type": "number",
              "format": "double"
            },
            "east": {
              "description": "Eastern edge, degrees.",
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "south",
            "west",
            "north",
            "east"
          ]
        },
        "Kind": {
          "description": "Feature families the query asks for, in the project's words.",
          "oneOf": [
            {
              "description": "`highway=*` ways.",
              "type": "string",
              "const": "roads"
            },
            {
              "description": "`waterway` rivers, streams and canals.",
              "type": "string",
              "const": "waterways"
            },
            {
              "description": "`natural=water` ways and relations (outer rings only).",
              "type": "string",
              "const": "water"
            },
            {
              "description": "`building=*` ways.",
              "type": "string",
              "const": "buildings"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FetchFeaturesResult",
      "description": "`geo.fetch_features` result.",
      "type": "object",
      "properties": {
        "asset": {
          "description": "The asset's file name.",
          "type": "string"
        },
        "path": {
          "description": "Where it was written.",
          "type": "string"
        },
        "counts": {
          "description": "Features per kind.",
          "$ref": "#/$defs/Counts"
        },
        "bytes": {
          "description": "Size of the GeoJSON written.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "fetch": {
          "description": "Fetch statistics.",
          "$ref": "#/$defs/Stats"
        },
        "attribution": {
          "description": "The notice appended to the project.",
          "$ref": "#/$defs/Attribution"
        }
      },
      "required": [
        "asset",
        "path",
        "counts",
        "bytes",
        "fetch",
        "attribution"
      ],
      "$defs": {
        "Counts": {
          "description": "How many features of each kind came back.",
          "type": "object",
          "properties": {
            "roads": {
              "description": "`highway` ways.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "waterways": {
              "description": "Rivers, streams, canals.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "water": {
              "description": "Water bodies.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "buildings": {
              "description": "Buildings.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "nodes": {
              "description": "Coordinates written in total.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "roads",
            "waterways",
            "water",
            "buildings",
            "nodes"
          ]
        },
        "Stats": {
          "description": "What a batch cost.",
          "type": "object",
          "properties": {
            "requests": {
              "description": "Requests in the batch.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "cache_hits": {
              "description": "Requests answered from the cache.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "bytes": {
              "description": "Bytes that crossed the wire (a 304 counts nothing).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "retries": {
              "description": "Retries across the batch.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "connections": {
              "description": "Connections in use when the batch ended.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "bytes_per_s": {
              "description": "Throughput estimate at the end, bytes per second.",
              "type": "number",
              "format": "double"
            },
            "elapsed_ms": {
              "description": "Wall time of the batch.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "requests",
            "cache_hits",
            "bytes",
            "retries",
            "connections",
            "bytes_per_s",
            "elapsed_ms"
          ]
        },
        "Attribution": {
          "description": "A data-source attribution obligation carried into exports.",
          "type": "object",
          "properties": {
            "source": {
              "description": "Source name (e.g. \"Copernicus DEM GLO-30\").",
              "type": "string"
            },
            "text": {
              "description": "Required notice text.",
              "type": "string"
            },
            "url": {
              "description": "Licence or terms URL.",
              "type": "string"
            },
            "licence": {
              "description": "Licence name or terms in a line.",
              "type": "string"
            }
          },
          "required": [
            "source",
            "text"
          ]
        }
      }
    }
  },
  {
    "id": "graph.add_node",
    "description": "Add a node (journaled)",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AddNode",
      "description": "`graph.add_node` params.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Kind `name@version`, e.g. `jd.noise.fbm@1`.",
          "$ref": "#/$defs/NodeKind"
        },
        "params": {
          "description": "Parameters (validated against the kind's schema before journaling).",
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "id": {
          "description": "Optional client-chosen id (ULID); generated when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "position": {
          "description": "Editor position; when omitted the node lands to the right of the current graph so\nscripted additions (CLI, MCP) never stack at the origin.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "$defs": {
        "NodeKind": {
          "description": "A node kind identifier `namespace.name@version`, e.g. `jd.noise.fbm@1`.",
          "type": "string"
        },
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AddedNode",
      "description": "`graph.add_node` result.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Id of the new node.",
          "$ref": "#/$defs/NodeId"
        }
      },
      "required": [
        "id"
      ],
      "$defs": {
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    }
  },
  {
    "id": "graph.append_param",
    "description": "Push one element onto an array parameter (brush strokes): journaled with just the element, so a long sculpt session grows the journal linearly",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppendParam",
      "description": "`graph.append_param` params.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Node id.",
          "$ref": "#/$defs/NodeId"
        },
        "key": {
          "description": "Array-valued parameter key (created when absent).",
          "type": "string"
        },
        "value": {
          "description": "Element to push."
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "value"
      ],
      "$defs": {
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "GraphView",
      "description": "`graph.list` result.",
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Nodes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeView"
          }
        },
        "edges": {
          "description": "Edges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "undo_depth": {
          "description": "Number of edits `graph.undo` can take back.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "redo_depth": {
          "description": "Number of undone edits `graph.redo` can re-apply.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "time": {
          "description": "Timeline position 0..1 at which keyed parameters resolve (`graph.set_time`).",
          "type": "number",
          "format": "float",
          "default": 0.0
        }
      },
      "required": [
        "nodes",
        "edges",
        "undo_depth",
        "redo_depth"
      ],
      "$defs": {
        "NodeView": {
          "description": "Node as reported by `graph.list`.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Id.",
              "$ref": "#/$defs/NodeId"
            },
            "kind": {
              "description": "Kind `name@version`.",
              "$ref": "#/$defs/NodeKind"
            },
            "params": {
              "description": "Parameters, validated against the kind's schema on every mutation.",
              "type": "object",
              "additionalProperties": true,
              "default": {}
            },
            "bypass": {
              "description": "Bypassed nodes pass their first input through unchanged.",
              "type": "boolean",
              "default": false
            },
            "ui": {
              "description": "Editor metadata.",
              "$ref": "#/$defs/UiMeta",
              "default": {
                "position": [
                  0.0,
                  0.0
                ]
              }
            }
          },
          "required": [
            "id",
            "kind"
          ]
        },
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        },
        "NodeKind": {
          "description": "A node kind identifier `namespace.name@version`, e.g. `jd.noise.fbm@1`.",
          "type": "string"
        },
        "UiMeta": {
          "description": "Editor-only metadata.",
          "type": "object",
          "properties": {
            "position": {
              "description": "Canvas position.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0.0,
                0.0
              ]
            },
            "label": {
              "description": "Display label override.",
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "Edge": {
          "description": "A directed connection from an output port to an input port.",
          "type": "object",
          "properties": {
            "from": {
              "description": "Source output.",
              "$ref": "#/$defs/PortRef"
            },
            "to": {
              "description": "Destination input.",
              "$ref": "#/$defs/PortRef"
            }
          },
          "required": [
