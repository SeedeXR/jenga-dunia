            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float",
              "minimum": 0.01,
              "maximum": 100000.0,
              "default": 8.0
            },
            "bump": {
              "description": "Normal strength 0..1.",
              "type": "number",
              "format": "float",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.5
            },
            "contrast": {
              "description": "Albedo variation 0..1.",
              "type": "number",
              "format": "float",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.30000001192092896
            },
            "seed": {
              "description": "Noise seed.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            },
            "px": {
              "description": "Tile side in pixels (16..=2048).",
              "type": "integer",
              "format": "uint32",
              "minimum": 16,
              "maximum": 2048,
              "default": 512
            }
          },
          "additionalProperties": false
        },
        "TextureSpec": {
          "description": "An image texture set for a material layer.",
          "type": "object",
          "properties": {
            "albedo": {
              "description": "Tileable albedo PNG (sRGB) in the project's assets/ (or an absolute path).",
              "type": "string"
            },
            "normal": {
              "description": "Tangent-space normal PNG (+Y up), optional.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float"
            },
            "px": {
              "description": "Exported tile side in pixels (16..=4096; the images are resampled to it).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1024
            }
          },
          "additionalProperties": false,
          "required": [
            "albedo",
            "tile_m"
          ]
        },
        "ScatterLook": {
          "description": "Scatter settings of the look.",
          "type": "object",
          "properties": {
            "mask": {
              "description": "Density mask layer, or none.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "spacing_m": {
              "description": "Spacing between instances, metres (> 0).",
              "type": "number",
              "format": "float"
            },
            "seed": {
              "description": "Seed.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            },
            "grow": {
              "description": "The population follows the timeline.",
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "spacing_m"
          ]
        },
        "SunLook": {
          "description": "Sun and sky of the look.",
          "type": "object",
          "properties": {
            "azimuth_deg": {
              "description": "Sun azimuth, degrees clockwise from north.",
              "type": "number",
              "format": "float"
            },
            "elevation_deg": {
              "description": "Sun elevation above the horizon, degrees (0, 90].",
              "type": "number",
              "format": "float"
            },
            "turbidity": {
              "description": "Turbidity 2..=10.",
              "type": "number",
              "format": "float",
              "default": 3.0
            },
            "clouds": {
              "description": "Cloud cover 0..=1.",
              "type": "number",
              "format": "float",
              "default": 0.0
            },
            "fog": {
              "description": "Viewport fog 0..=1.",
              "type": "number",
              "format": "float",
              "default": 0.0
            }
          },
          "additionalProperties": false,
          "required": [
            "azimuth_deg",
            "elevation_deg"
          ]
        }
      }
    }
  },
  {
    "id": "project.set_settings",
    "description": "Change project settings (autosave interval, cache limit, preview LOD, memory budget, the world's shared wind, the world origin and CRS); fields left out keep their value — journaled like every mutation",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectSetSettings",
      "description": "`project.set_settings` params: fields left out keep their current value.",
      "type": "object",
      "properties": {
        "autosave_interval_s": {
          "description": "Seconds after the last edit before the desktop autosaves (0 disables).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "cache_limit_bytes": {
          "description": "Layer cache cap in bytes (≥ 16 MiB).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        },
        "preview_lod": {
          "description": "Preview LOD hint (resolution ÷ 2^lod).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": null
        },
        "wind": {
          "description": "Shared wind of the world: every wind-driven node without its own `wind_*` setting follows it.",
          "anyOf": [
            {
              "$ref": "#/$defs/Wind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "description": "World-space origin of pixel (0, 0) in metres, f64 — layers stay in local metres, so\nmoving the origin re-bases the world without touching a sample (GeoTIFF tie points,\nthe Unreal profile and georeferenced exports follow it).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "crs": {
          "description": "Coordinate reference system of the origin, e.g. `EPSG:32637`; an empty string clears it.",
          "type": [
            "string",
            "null"
          ]
        },
        "memory_budget_bytes": {
          "description": "Memory budget for evaluations, bytes (≥ 256 MiB; default 4 GiB).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false,
      "$defs": {
        "Wind": {
          "description": "Shared weather state: the prevailing wind. Every wind-driven node (dunes, yardangs, snow\nscour, the wind sea) follows it unless the node sets its own `wind_*` parameter.",
          "type": "object",
          "properties": {
            "azimuth_deg": {
              "description": "Direction the wind blows FROM, degrees clockwise from north (270 = westerly).",
              "type": "number",
              "format": "float"
            },
            "speed_mps": {
              "description": "Speed 10 m above the ground, m/s (8 = a moderate breeze).",
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "azimuth_deg",
            "speed_mps"
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectSummary",
      "description": "Summary returned by project ops.",
      "type": "object",
      "properties": {
        "project_id": {
          "description": "Project id.",
          "type": "string"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "path": {
          "description": "Directory.",
          "type": "string"
        },
        "world": {
          "description": "World settings.",
          "$ref": "#/$defs/WorldSettings"
        },
        "schema_version": {
          "description": "Document schema version.",
          "$ref": "#/$defs/SchemaVersion"
        },
        "dirty": {
          "description": "Unsaved changes?",
          "type": "boolean"
        },
        "pending_journal": {
          "description": "Journal entries awaiting replay.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "settings": {
          "description": "User-tunable settings (`project.json` → `settings`): autosave interval, cache limit, preview LOD.",
          "$ref": "#/$defs/ProjectSettings"
        },
        "look": {
          "description": "The project's look (`scene.json` → `look`): materials, scatter, sun.",
          "$ref": "#/$defs/Look"
        }
      },
      "required": [
        "project_id",
        "name",
        "path",
        "world",
        "schema_version",
        "dirty",
        "pending_journal",
        "settings",
        "look"
      ],
      "$defs": {
        "WorldSettings": {
          "description": "World extent, resolution and tiling (`docs/spec/project-format.md`).",
          "type": "object",
          "properties": {
            "extent_m": {
              "description": "Extent in metres, [x, y].",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "resolution_px": {
              "description": "Heightfield resolution in pixels, [x, y].",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "tile_size": {
              "description": "Tile edge length in pixels (power of two).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "halo": {
              "description": "Halo width in pixels around each tile.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "origin": {
              "description": "World-space origin of pixel (0,0), metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "crs": {
              "description": "Optional CRS identifier (e.g. \"EPSG:32637\") when georeferenced.",
              "type": [
                "string",
                "null"
              ]
            },
            "seed": {
              "description": "Master seed for all procedural randomness.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "wind": {
              "description": "Prevailing wind shared by the wind-driven nodes.",
              "$ref": "#/$defs/Wind",
              "default": {
                "azimuth_deg": 270.0,
                "speed_mps": 8.0
              }
            }
          },
          "required": [
            "extent_m",
            "resolution_px",
            "tile_size",
            "halo",
            "origin",
            "seed"
          ]
        },
        "Wind": {
          "description": "Shared weather state: the prevailing wind. Every wind-driven node (dunes, yardangs, snow\nscour, the wind sea) follows it unless the node sets its own `wind_*` parameter.",
          "type": "object",
          "properties": {
            "azimuth_deg": {
              "description": "Direction the wind blows FROM, degrees clockwise from north (270 = westerly).",
              "type": "number",
              "format": "float"
            },
            "speed_mps": {
              "description": "Speed 10 m above the ground, m/s (8 = a moderate breeze).",
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "azimuth_deg",
            "speed_mps"
          ]
        },
        "SchemaVersion": {
          "description": "A monotonically increasing document/API schema version.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ProjectSettings": {
          "description": "User-tunable project settings.",
          "type": "object",
          "properties": {
            "autosave_interval_s": {
              "description": "Autosave interval in seconds (0 disables).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "cache_limit_bytes": {
              "description": "Cache size cap in bytes.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "preview_lod": {
              "description": "Preview LOD (resolution divided by 2^lod).",
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            },
            "memory_budget_bytes": {
              "description": "Evaluations whose pre-flight memory estimate exceeds this are refused (`E_RESOURCE_MEMORY`).\nDefault 4 GiB — the brief's ceiling (ADR-0008).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 4294967296
            }
          },
          "required": [
            "autosave_interval_s",
            "cache_limit_bytes",
            "preview_lod"
          ]
        },
        "Look": {
          "description": "The project's look: what the desktop shows on top of the layers — the material stack, the\nscatter settings and the viewport sun. The core keeps it with the project (`project.set_look`,\njournaled like every mutation) so a reopened project looks the way it was left; exports that\ntake materials or a sun are given these by the app.",
          "type": "object",
          "properties": {
            "materials": {
              "description": "Material layers, blended in order over the base (`terrain.textures` / `terrain.export_mesh`).",
              "type": "array",
              "items": {
                "$ref": "#/$defs/MaterialSpec"
              },
              "default": []
            },
            "scatter": {
              "description": "Scatter settings.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ScatterLook"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "sun": {
              "description": "Viewport sun and sky.",
              "anyOf": [
                {
                  "$ref": "#/$defs/SunLook"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false
        },
        "MaterialSpec": {
          "description": "One material layer of the stack.",
          "type": "object",
          "properties": {
            "mask": {
              "description": "0..1 mask layer that weights this material (omit for everywhere).",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "albedo": {
              "description": "Base colour, sRGB 0..1.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "roughness": {
              "description": "Roughness 0..1.",
              "type": "number",
              "format": "float",
              "default": 0.8999999761581421
            },
            "emissive": {
              "description": "Emitted light, linear RGB 0..1 (unset = none): a lava flow's `heat` layer, embers, windows at night.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3,
              "default": null
            },
            "detail": {
              "description": "Tileable detail (grain repeated every `tile_m` metres): baked into the macro maps and\nthe GLB by world position, returned as tiles for the viewport, written as tiles for\nthe engines.",
              "anyOf": [
                {
                  "$ref": "#/$defs/DetailSpec"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "texture": {
              "description": "An image texture set from the project's assets/ (tileable PNGs): the albedo is sampled\ninto the maps by world position and the set is written as the layer's tile for the\nengines; `detail` wins when both are given.",
              "anyOf": [
                {
                  "$ref": "#/$defs/TextureSpec"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "albedo"
          ]
        },
        "DetailSpec": {
          "description": "A layer's tileable detail.",
          "type": "object",
          "properties": {
            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float",
              "minimum": 0.01,
              "maximum": 100000.0,
              "default": 8.0
            },
            "bump": {
              "description": "Normal strength 0..1.",
              "type": "number",
              "format": "float",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.5
            },
            "contrast": {
              "description": "Albedo variation 0..1.",
              "type": "number",
              "format": "float",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.30000001192092896
            },
            "seed": {
              "description": "Noise seed.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            },
            "px": {
              "description": "Tile side in pixels (16..=2048).",
              "type": "integer",
              "format": "uint32",
              "minimum": 16,
              "maximum": 2048,
              "default": 512
            }
          },
          "additionalProperties": false
        },
        "TextureSpec": {
          "description": "An image texture set for a material layer.",
          "type": "object",
          "properties": {
            "albedo": {
              "description": "Tileable albedo PNG (sRGB) in the project's assets/ (or an absolute path).",
              "type": "string"
            },
            "normal": {
              "description": "Tangent-space normal PNG (+Y up), optional.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float"
            },
            "px": {
              "description": "Exported tile side in pixels (16..=4096; the images are resampled to it).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1024
            }
          },
          "additionalProperties": false,
          "required": [
            "albedo",
            "tile_m"
          ]
        },
        "ScatterLook": {
          "description": "Scatter settings of the look.",
          "type": "object",
          "properties": {
            "mask": {
              "description": "Density mask layer, or none.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "spacing_m": {
              "description": "Spacing between instances, metres (> 0).",
              "type": "number",
              "format": "float"
            },
            "seed": {
              "description": "Seed.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            },
            "grow": {
              "description": "The population follows the timeline.",
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "spacing_m"
          ]
        },
        "SunLook": {
          "description": "Sun and sky of the look.",
          "type": "object",
          "properties": {
            "azimuth_deg": {
              "description": "Sun azimuth, degrees clockwise from north.",
              "type": "number",
              "format": "float"
            },
            "elevation_deg": {
              "description": "Sun elevation above the horizon, degrees (0, 90].",
              "type": "number",
              "format": "float"
            },
            "turbidity": {
              "description": "Turbidity 2..=10.",
              "type": "number",
              "format": "float",
              "default": 3.0
            },
            "clouds": {
              "description": "Cloud cover 0..=1.",
              "type": "number",
              "format": "float",
              "default": 0.0
            },
            "fog": {
              "description": "Viewport fog 0..=1.",
              "type": "number",
              "format": "float",
              "default": 0.0
            }
          },
          "additionalProperties": false,
          "required": [
            "azimuth_deg",
            "elevation_deg"
          ]
        }
      }
    }
  },
  {
    "id": "project.write_export",
    "description": "Write bytes (base64) to a file under the project's exports/ — viewport stills and flythrough frames from the desktop, any small artefact from an agent; the path is relative and may not leave exports/",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "WriteExport",
      "description": "`project.write_export` params.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Destination under the project's exports/ (relative, no `..`): `stills/view_01.png`, `flythrough/frame_0003.png`.",
          "type": "string"
        },
        "bytes_base64": {
          "description": "The file's bytes, base64.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "bytes_base64"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "WrittenExport",
      "description": "`project.write_export` result.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Absolute path written.",
          "type": "string"
        },
        "bytes": {
          "description": "Bytes written.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "bytes"
      ]
    }
  },
  {
    "id": "sky.bake",
    "description": "Bake a physical sky (Preetham daylight model: sun azimuth/elevation, turbidity) as an equirectangular HDRI — OpenEXR RGB f32 for engines and renderers, with a tonemapped PNG preview beside it",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SkyBake",
      "description": "`sky.bake` params.",
      "type": "object",
      "properties": {
        "sun_azimuth_deg": {
          "description": "Sun azimuth, degrees clockwise from north.",
          "type": "number",
          "format": "float",
          "default": 140.0
        },
        "sun_elevation_deg": {
          "description": "Sun elevation above the horizon, degrees (0, 90].",
          "type": "number",
          "format": "float",
          "default": 35.0
        },
        "turbidity": {
          "description": "Turbidity: 2 = clear mountain air, 3 = clear, 6 = hazy, 10 = thick haze (2..=10).",
          "type": "number",
          "format": "float",
          "default": 3.0
        },
        "exposure": {
          "description": "Scale from kcd/m² to the written radiance (> 0): 0.05 puts a clear zenith near 0.5.",
          "type": "number",
          "format": "float",
          "default": 0.05000000074505806
        },
        "sun_radiance": {
          "description": "Radiance of the 0.27° sun disc after exposure (≥ 0; 0 hides the disc). The default is the\nreal sun — ≈ 1.6·10⁹ cd/m², i.e. 1.6·10⁶ kcd/m² × the default exposure — so an HDRI lights a\nscene with the right sun-to-sky balance; in the map the disc's energy is spread over the\npixel that holds it when the pixel is larger than the disc.",
          "type": "number",
          "format": "float",
          "default": 80000.0
        },
        "cloud_cover": {
          "description": "Cloud cover 0..1 (0 = clear): a seeded noise layer of cumulus-like patches, brighter on the\nsun side and dimming the disc under cover; a shaded noise field, not a scattering model.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "cloud_scale_deg": {
          "description": "Angular size of the cloud cells, degrees (> 0; 25 ≈ fair-weather cumulus seen from below).",
          "type": "number",
          "format": "float",
          "default": 25.0
        },
        "cloud_seed": {
          "description": "Seed of the cloud field.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "fog": {
          "description": "Fog 0..1: a haze over the low sky — the horizon band fades toward a grey of the horizon's own\nbrightness, strongest at the horizon and gone by ~30° up; below the horizon it is full.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "width": {
          "description": "Width of the equirectangular map in pixels (even, 16..=8192); the height is half.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 2048
        },
        "path": {
          "description": "Output `.exr`; relative paths resolve against the project's `exports/`. A `.png` preview is written beside it.",
          "type": "string",
          "default": "sky.exr"
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SkyBakeResult",
      "description": "`sky.bake` result.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The HDRI written (OpenEXR, RGB f32, equirectangular, row 0 = zenith, column 0 = north).",
          "type": "string"
        },
        "preview": {
          "description": "Tonemapped preview written beside it.",
          "type": "string"
        },
        "px": {
          "description": "Map size in pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "zenith_rgb": {
          "description": "Linear radiance straight up and just above the horizon (north), after exposure.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "horizon_rgb": {
          "description": "Linear radiance just above the horizon (north), after exposure.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "path",
        "preview",
        "px",
        "zenith_rgb",
        "horizon_rgb"
      ]
    }
  },
  {
    "id": "sky.load_hdri",
    "description": "Read an equirectangular EXR (an HDRI, or `sky.bake`'s output) for the viewport dome: a tonemapped PNG, the brightest texel as a sun direction (azimuth clockwise from north, elevation) and the mean luminance",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SkyLoadHdri",
      "description": "`sky.load_hdri` params.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Equirectangular OpenEXR in the project's assets/ (or an absolute path) — `sky.bake`'s own output, or any 2:1 lat-long HDRI.",
          "type": "string"
        },
        "width": {
          "description": "Preview width (even, 16..=2048); height is half.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 512
        },
        "exposure": {
          "description": "Exposure applied before tonemapping (the viewport uses 0.15 for its own sky).",
          "type": "number",
          "format": "float",
          "default": 0.15000000596046448
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SkyHdriResult",
      "description": "`sky.load_hdri` result.",
      "type": "object",
      "properties": {
        "width": {
          "description": "Preview width.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "description": "Preview height.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "png_base64": {
          "description": "Tonemapped sRGB PNG, base64.",
          "type": "string"
        },
        "sun_azimuth_deg": {
          "description": "The brightest texel's direction: azimuth clockwise from north, degrees.",
          "type": "number",
          "format": "float"
        },
        "sun_elevation_deg": {
          "description": "Its elevation above the horizon, degrees.",
          "type": "number",
          "format": "float"
        },
        "mean_luminance": {
          "description": "Mean linear luminance of the map.",
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "width",
        "height",
        "png_base64",
        "sun_azimuth_deg",
        "sun_elevation_deg",
        "mean_luminance"
      ]
    }
  },
  {
    "id": "sky.preview",
    "description": "The physical sky (Preetham) as a small tonemapped equirectangular PNG for viewports — same model as `sky.bake`, no project needed",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SkyPreview",
      "description": "`sky.preview` params.",
      "type": "object",
      "properties": {
        "sun_azimuth_deg": {
          "description": "Sun azimuth, degrees clockwise from north.",
          "type": "number",
          "format": "float",
          "default": 140.0
        },
        "sun_elevation_deg": {
          "description": "Sun elevation above the horizon, degrees (0, 90].",
          "type": "number",
          "format": "float",
          "default": 35.0
        },
        "turbidity": {
          "description": "Turbidity: 2 = clear mountain air, 3 = clear, 6 = hazy, 10 = thick haze (2..=10).",
          "type": "number",
          "format": "float",
          "default": 3.0
        },
        "exposure": {
          "description": "Scale from kcd/m² to the written radiance (> 0): 0.05 puts a clear zenith near 0.5.",
          "type": "number",
          "format": "float",
          "default": 0.05000000074505806
        },
        "sun_radiance": {
          "description": "Radiance of the 0.27° sun disc after exposure (≥ 0; 0 hides the disc). The default is the\nreal sun — ≈ 1.6·10⁹ cd/m², i.e. 1.6·10⁶ kcd/m² × the default exposure — so an HDRI lights a\nscene with the right sun-to-sky balance; in the map the disc's energy is spread over the\npixel that holds it when the pixel is larger than the disc.",
          "type": "number",
          "format": "float",
          "default": 80000.0
        },
        "cloud_cover": {
          "description": "Cloud cover 0..1 (0 = clear): a seeded noise layer of cumulus-like patches, brighter on the\nsun side and dimming the disc under cover; a shaded noise field, not a scattering model.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "cloud_scale_deg": {
          "description": "Angular size of the cloud cells, degrees (> 0; 25 ≈ fair-weather cumulus seen from below).",
          "type": "number",
          "format": "float",
          "default": 25.0
        },
        "cloud_seed": {
          "description": "Seed of the cloud field.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "fog": {
          "description": "Fog 0..1: a haze over the low sky — the horizon band fades toward a grey of the horizon's own\nbrightness, strongest at the horizon and gone by ~30° up; below the horizon it is full.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "width": {
          "description": "Width of the equirectangular preview in pixels (even, 16..=2048); the height is half.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 512
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SkyPreviewResult",
      "description": "`sky.preview` result.",
      "type": "object",
      "properties": {
        "width": {
          "description": "Preview size in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "description": "Preview height in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "png_base64": {
          "description": "Tonemapped sRGB PNG (equirectangular, row 0 = zenith, column 0 = north), standard base64.",
          "type": "string"
        }
      },
      "required": [
        "width",
        "height",
        "png_base64"
      ]
    }
  },
  {
    "id": "terrain.export_contours",
    "description": "Write contour lines (iso-height LineStrings every `interval_m`, each with its `elevation_m`) of a layer as GeoJSON — marching squares joined into rings and lines; coordinates in layer metres, world CRS units or WGS 84",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainExportContours",
      "description": "Request of `terrain.export_contours`.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Output file (`.geojson`), relative to the project's exports/.",
          "type": "string"
        },
        "layer": {
          "description": "Layer to contour.",
          "type": "string",
          "default": "height"
        },
        "interval_m": {
          "description": "Height between contour lines, metres (> 0).",
          "type": "number",
          "format": "float"
        },
        "min_length_m": {
          "description": "Lines shorter than this are dropped, metres.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "coordinates": {
          "description": "Coordinate system of the numbers written (as for splines).",
          "$ref": "#/$defs/SplineCoordinates",
          "default": "local_m"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "interval_m"
      ],
      "$defs": {
        "SplineCoordinates": {
          "description": "Which numbers a splines export writes.",
          "oneOf": [
            {
              "description": "Layer metres: `u` east from the west edge, `v` north from the south edge (Blender, engines).",
              "type": "string",
              "const": "local_m"
            },
            {
              "description": "The world's CRS units from its georeference origin (GIS with the same CRS).",
              "type": "string",
              "const": "world"
            },
            {
              "description": "WGS 84 longitude / latitude through the world's CRS (standard GeoJSON; needs a CRS).",
              "type": "string",
              "const": "wgs84"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ContoursReport",
      "description": "Result of `terrain.export_contours`.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The file written.",
          "type": "string"
        },
        "lines": {
          "description": "Lines written.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "levels": {
          "description": "Distinct levels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bytes": {
          "description": "Bytes written.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "lines",
        "levels",
        "bytes"
      ]
    }
  },
  {
    "id": "terrain.export_heightmap",
    "description": "Write a layer as EXR (f32), PNG16, RAW r16 or r32 with a JSON sidecar",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainExport",
      "description": "`terrain.export_heightmap` params.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string",
          "default": "height"
        },
        "path": {
          "description": "Output file; relative paths resolve against the project's `exports/` directory.",
          "type": "string"
        },
        "format": {
          "description": "Encoding.",
          "$ref": "#/$defs/HeightmapFormat"
        },
        "flip_y": {
          "description": "Flip rows so row 0 is north (image convention). Default true for images, false for RAW.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "range_m": {
          "description": "Height range mapped to [0, 65535] for quantised formats; defaults to the field's min/max.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "georeference": {
          "description": "For `tiff32`: write GeoTIFF tags (pixel scale, tie point, EPSG GeoKeys) when the caller\nsupplies a [`GeoRef`]. Default true; the file is then always north-up.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "format"
      ],
      "$defs": {
        "HeightmapFormat": {
          "description": "Supported heightmap encodings.",
          "oneOf": [
            {
              "description": "OpenEXR, single `Y` channel, 32-bit float, lossless (ZIP). Exact.",
              "type": "string",
              "const": "exr"
            },
            {
              "description": "16-bit grayscale PNG, normalised to the export range.",
              "type": "string",
              "const": "png16"
            },
            {
              "description": "Headerless little-endian u16, normalised to the export range (Unity / Unreal).",
              "type": "string",
              "const": "raw_r16"
            },
            {
              "description": "Headerless little-endian f32. Exact.",
              "type": "string",
              "const": "raw_r32"
            },
            {
              "description": "TIFF, single 32-bit float sample per pixel (GIS and DCC tools read it directly). Exact.",
              "type": "string",
              "const": "tiff32"
            },
            {
              "description": "ESRI ASCII grid (`.asc`): a six-line header (ncols, nrows, xllcorner, yllcorner, cellsize,\nNODATA_value) then rows north to south — GIS tools and World Machine read it. Square cells\nonly; the cell size and corner come from the georeference when given, else 1 m at (0, 0).",
              "type": "string",
              "const": "asc"
            },
            {
              "description": "XYZ points (`.xyz`): one `x y z` line per sample in metres (the georeference's origin and\nspacing when given, else cells of 1 m from (0, 0)), row 0 first. Exact, large.",
              "type": "string",
              "const": "xyz"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ExportReport",
      "description": "What was written.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Written file.",
          "type": "string"
        },
        "sidecar": {
          "description": "Sidecar JSON (always written) describing size, range and conventions.",
          "type": "string"
        },
        "format": {
          "description": "Encoding.",
          "$ref": "#/$defs/HeightmapFormat"
        },
        "size_px": {
          "description": "Width, height in pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "range_m": {
          "description": "Height range encoded (for quantised formats) or observed (exact formats).",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "quantisation_step_m": {
          "description": "Metres per quantisation step (0 for exact formats).",
          "type": "number",
          "format": "float"
        },
        "flip_y": {
          "description": "Whether rows were flipped (row 0 = north).",
          "type": "boolean"
        },
        "bytes": {
          "description": "Bytes written to `path`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sidecar",
        "format",
        "size_px",
        "range_m",
        "quantisation_step_m",
        "flip_y",
        "bytes"
      ],
      "$defs": {
        "HeightmapFormat": {
          "description": "Supported heightmap encodings.",
          "oneOf": [
            {
              "description": "OpenEXR, single `Y` channel, 32-bit float, lossless (ZIP). Exact.",
              "type": "string",
              "const": "exr"
            },
            {
              "description": "16-bit grayscale PNG, normalised to the export range.",
              "type": "string",
              "const": "png16"
            },
            {
              "description": "Headerless little-endian u16, normalised to the export range (Unity / Unreal).",
              "type": "string",
              "const": "raw_r16"
            },
            {
              "description": "Headerless little-endian f32. Exact.",
              "type": "string",
              "const": "raw_r32"
            },
            {
              "description": "TIFF, single 32-bit float sample per pixel (GIS and DCC tools read it directly). Exact.",
              "type": "string",
              "const": "tiff32"
            },
            {
              "description": "ESRI ASCII grid (`.asc`): a six-line header (ncols, nrows, xllcorner, yllcorner, cellsize,\nNODATA_value) then rows north to south — GIS tools and World Machine read it. Square cells\nonly; the cell size and corner come from the georeference when given, else 1 m at (0, 0).",
              "type": "string",
              "const": "asc"
            },
            {
              "description": "XYZ points (`.xyz`): one `x y z` line per sample in metres (the georeference's origin and\nspacing when given, else cells of 1 m from (0, 0)), row 0 first. Exact, large.",
              "type": "string",
              "const": "xyz"
            }
          ]
        }
      }
    }
  },
  {
    "id": "terrain.export_mesh",
    "description": "Write a layer as a grid mesh — .glb (normals, UVs, PBR material with baked base-colour texture), .fbx (binary 7.4 quads, Phong material with the baked texture embedded), .obj, binary .stl, binary .ply with vertex colours, .usda, or .usdz (needs usdzip) — metres, +Y up, centred on the world",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainExportMesh",
      "description": "`terrain.export_mesh` params.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string",
          "default": "height"
        },
        "path": {
          "description": "Output `.glb`, `.fbx`, `.obj`, `.stl`, `.ply`, `.usda`, `.usdc` or `.usdz`; relative paths resolve against the project's `exports/` directory.",
          "type": "string"
        },
        "step": {
          "description": "Grid step (1 = every sample). Default: the smallest step that keeps the mesh within `max_vertices`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "max_vertices": {
          "description": "Vertex budget used when `step` is not given (default 1025² = 1 050 625).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1050625
        },
        "texture": {
          "description": "Embed a baked base-colour texture (hypsometric ramp + slope, one texel per vertex).",
          "type": "boolean",
          "default": true
        },
        "target_triangles": {
          "description": "Decimate the sampled grid to at most this many triangles (quadric edge collapse):\nflat ground collapses, ridges keep their detail. Not for `.fbx`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "materials": {
          "description": "Material layers baked into the GLB's albedo and roughness textures (see `terrain.textures`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaterialSpec"
          },
          "default": []
        },
        "lods": {
          "description": "Also write this many coarser levels beside the file (`<stem>_lod1.<ext>`, …), each with\na quarter of the previous level's triangles; the report lists them under `lods`. 1..=8, not for `.fbx`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "holes": {
          "description": "A 0..1 layer (a painted mask, a class mask) whose cells ≥ 0.5 are holes: their quads are\nleft out of the mesh — cave and tunnel mouths, building footprints.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "$defs": {
        "MaterialSpec": {
          "description": "One material layer of the stack.",
          "type": "object",
          "properties": {
            "mask": {
              "description": "0..1 mask layer that weights this material (omit for everywhere).",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "albedo": {
              "description": "Base colour, sRGB 0..1.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "roughness": {
              "description": "Roughness 0..1.",
              "type": "number",
              "format": "float",
              "default": 0.8999999761581421
            },
            "emissive": {
              "description": "Emitted light, linear RGB 0..1 (unset = none): a lava flow's `heat` layer, embers, windows at night.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3,
              "default": null
            },
            "detail": {
              "description": "Tileable detail (grain repeated every `tile_m` metres): baked into the macro maps and\nthe GLB by world position, returned as tiles for the viewport, written as tiles for\nthe engines.",
              "anyOf": [
                {
                  "$ref": "#/$defs/DetailSpec"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "texture": {
              "description": "An image texture set from the project's assets/ (tileable PNGs): the albedo is sampled\ninto the maps by world position and the set is written as the layer's tile for the\nengines; `detail` wins when both are given.",
              "anyOf": [
                {
                  "$ref": "#/$defs/TextureSpec"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "albedo"
          ]
        },
        "DetailSpec": {
          "description": "A layer's tileable detail.",
          "type": "object",
          "properties": {
            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float",
              "minimum": 0.01,
              "maximum": 100000.0,
              "default": 8.0
            },
            "bump": {
              "description": "Normal strength 0..1.",
              "type": "number",
              "format": "float",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.5
            },
            "contrast": {
              "description": "Albedo variation 0..1.",
              "type": "number",
              "format": "float",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.30000001192092896
            },
            "seed": {
              "description": "Noise seed.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            },
            "px": {
              "description": "Tile side in pixels (16..=2048).",
              "type": "integer",
              "format": "uint32",
              "minimum": 16,
              "maximum": 2048,
              "default": 512
            }
          },
          "additionalProperties": false
        },
        "TextureSpec": {
          "description": "An image texture set for a material layer.",
          "type": "object",
          "properties": {
            "albedo": {
              "description": "Tileable albedo PNG (sRGB) in the project's assets/ (or an absolute path).",
              "type": "string"
            },
            "normal": {
              "description": "Tangent-space normal PNG (+Y up), optional.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float"
            },
            "px": {
              "description": "Exported tile side in pixels (16..=4096; the images are resampled to it).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1024
            }
          },
          "additionalProperties": false,
          "required": [
            "albedo",
            "tile_m"
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "MeshExportReport",
      "description": "What `export_glb` wrote.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Written file.",
          "type": "string"
        },
        "format": {
          "description": "Always `glb`.",
          "type": "string"
        },
        "vertices": {
          "description": "Vertex count.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "triangles": {
          "description": "Triangle count.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "step": {
          "description": "Grid step used (1 = every sample).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bytes": {
          "description": "Bytes written.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "extent_m": {
          "description": "World extent covered, metres.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "texture_px": {
          "description": "Baked base-colour texture size in pixels when one was embedded.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "normal_px": {
          "description": "Baked normal + roughness map size in pixels (full field resolution, capped at 2048²).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "topology": {
          "description": "Topology of the written triangles (None for FBX, which writes quads).",
          "anyOf": [
            {
              "$ref": "#/$defs/MeshTopology"
            },
            {
              "type": "null"
            }
          ]
        },
        "lods": {
          "description": "Coarser levels written beside this file (`<stem>_lod1.<ext>`, …), each with about a\nquarter of the previous level's triangles.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "required": [
        "path",
        "format",
        "vertices",
        "triangles",
        "step",
        "bytes",
        "extent_m"
      ],
      "$defs": {
        "MeshTopology": {
          "description": "Topology summary of an indexed triangle list — the checks a mesh importer trips over.\nA closed-grid terrain has 0 degenerate, 0 non-manifold, 0 unreferenced and a perimeter of\nboundary edges; decimation must keep it that way.",
          "type": "object",
          "properties": {
            "degenerate": {
              "description": "Triangles that repeat a vertex (zero area by construction).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "boundary_edges": {
              "description": "Edges used by exactly one triangle (the outline; holes add to it).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "non_manifold_edges": {
              "description": "Edges shared by more than two triangles.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "unreferenced_vertices": {
              "description": "Vertices no triangle references.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "out_of_range": {
              "description": "Indices past the vertex count (a broken file; always 0 from our writers).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "degenerate",
            "boundary_edges",
            "non_manifold_edges",
            "unreferenced_vertices",
            "out_of_range"
          ]
        }
      }
    }
  },
  {
    "id": "terrain.export_profile",
    "description": "Write a Unity or Unreal terrain import set: heightmap in the engine's encoding and row order, one 8-bit weightmap per mask layer, and a README with the computed Terrain Height / Z scale",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainExportProfile",
      "description": "`terrain.export_profile` params.",
      "type": "object",
      "properties": {
        "profile": {
          "description": "Target engine.",
          "$ref": "#/$defs/EngineProfile"
        },
        "dir": {
          "description": "Output directory; relative paths resolve against the project's `exports/`.",
          "type": "string"
        },
        "layer": {
          "description": "Height layer.",
          "type": "string",
          "default": "height"
        },
        "masks": {
          "description": "0..1 mask layers written as weightmaps (`weight_<name>.png`).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "range_m": {
          "description": "Height range to encode (default: the layer's min/max).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "tiles": {
          "description": "Cut the export into `tiles × tiles` engine folders (`tile_<x>_<y>/`) sharing one height range, with a `tiles.json` manifest; the resolution must divide (2..=16).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "materials": {
          "description": "The material stack to translate: masked layers become weightmaps, `materials.json` carries the look, and the report's `loss` lists what the engine cannot take.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaterialSpec"
          },
          "default": []
        },
        "holes": {
          "description": "A 0..1 layer whose cells ≥ 0.5 are holes, written as `holes.png` (Unity's holes texture via the import script, Unreal's Visibility layer).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "caves": {
          "description": "Carry the project's caves: every `jd.cave.system@1` node's walls and speleothems as\n`cave_<n>.fbx` (Unity) / `cave_<n>.glb` (Unreal) in the terrain frame, their entrance holes\nmerged into `holes.png`, and `caves.json` listing the files, bounds and entrances.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "dir"
      ],
      "$defs": {
        "EngineProfile": {
          "description": "Target engine.",
          "oneOf": [
            {
              "description": "Unity Terrain: RAW 16-bit little-endian, row 0 = south (no flip), Terrain Height = range.",
              "type": "string",
              "const": "unity"
            },
            {
              "description": "Unreal Landscape: PNG16, row 0 = north, Z scale = range_m × 100 / 512, 8-bit weightmaps.",
              "type": "string",
              "const": "unreal"
            }
          ]
        },
        "MaterialSpec": {
          "description": "One material layer of the stack.",
          "type": "object",
          "properties": {
            "mask": {
              "description": "0..1 mask layer that weights this material (omit for everywhere).",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "albedo": {
              "description": "Base colour, sRGB 0..1.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "roughness": {
              "description": "Roughness 0..1.",
              "type": "number",
              "format": "float",
              "default": 0.8999999761581421
            },
            "emissive": {
              "description": "Emitted light, linear RGB 0..1 (unset = none): a lava flow's `heat` layer, embers, windows at night.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3,
              "default": null
            },
            "detail": {
              "description": "Tileable detail (grain repeated every `tile_m` metres): baked into the macro maps and\nthe GLB by world position, returned as tiles for the viewport, written as tiles for\nthe engines.",
              "anyOf": [
                {
                  "$ref": "#/$defs/DetailSpec"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "texture": {
              "description": "An image texture set from the project's assets/ (tileable PNGs): the albedo is sampled\ninto the maps by world position and the set is written as the layer's tile for the\nengines; `detail` wins when both are given.",
              "anyOf": [
                {
                  "$ref": "#/$defs/TextureSpec"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "albedo"
          ]
        },
        "DetailSpec": {
          "description": "A layer's tileable detail.",
          "type": "object",
          "properties": {
            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float",
              "minimum": 0.01,
              "maximum": 100000.0,
              "default": 8.0
            },
            "bump": {
              "description": "Normal strength 0..1.",
              "type": "number",
              "format": "float",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.5
            },
            "contrast": {
              "description": "Albedo variation 0..1.",
              "type": "number",
              "format": "float",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.30000001192092896
            },
            "seed": {
              "description": "Noise seed.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            },
            "px": {
              "description": "Tile side in pixels (16..=2048).",
              "type": "integer",
              "format": "uint32",
              "minimum": 16,
              "maximum": 2048,
              "default": 512
            }
          },
          "additionalProperties": false
        },
        "TextureSpec": {
          "description": "An image texture set for a material layer.",
          "type": "object",
          "properties": {
            "albedo": {
              "description": "Tileable albedo PNG (sRGB) in the project's assets/ (or an absolute path).",
              "type": "string"
            },
            "normal": {
              "description": "Tangent-space normal PNG (+Y up), optional.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float"
            },
            "px": {
              "description": "Exported tile side in pixels (16..=4096; the images are resampled to it).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1024
            }
          },
          "additionalProperties": false,
          "required": [
            "albedo",
            "tile_m"
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProfileReport",
      "description": "What the profile wrote.",
      "type": "object",
      "properties": {
        "profile": {
          "description": "Engine.",
          "$ref": "#/$defs/EngineProfile"
        },
        "dir": {
          "description": "Output directory.",
          "type": "string"
        },
        "files": {
          "description": "Files written, relative to `dir`, in write order (heightmap, sidecar, weightmaps, README).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size_px": {
          "description": "Heightmap size in pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "settings": {
          "description": "Import numbers.",
          "$ref": "#/$defs/ProfileSettings"
        },
        "notes": {
          "description": "Non-fatal notes (e.g. a size Unreal does not recommend).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "loss": {
          "description": "What the engine's material model cannot take from the material stack (empty without `materials`).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "profile",
        "dir",
        "files",
        "size_px",
        "settings",
        "notes"
      ],
      "$defs": {
        "EngineProfile": {
          "description": "Target engine.",
          "oneOf": [
            {
              "description": "Unity Terrain: RAW 16-bit little-endian, row 0 = south (no flip), Terrain Height = range.",
              "type": "string",
              "const": "unity"
            },
            {
              "description": "Unreal Landscape: PNG16, row 0 = north, Z scale = range_m × 100 / 512, 8-bit weightmaps.",
              "type": "string",
              "const": "unreal"
            }
          ]
        },
        "ProfileSettings": {
          "description": "Engine-specific numbers the importer needs.",
          "type": "object",
          "properties": {
            "min_m": {
              "description": "Lowest encoded height (metres) — the terrain's base offset.",
              "type": "number",
              "format": "float"
            },
            "max_m": {
              "description": "Highest encoded height (metres).",
              "type": "number",
              "format": "float"
            },
            "unity_terrain_height_m": {
              "description": "Unity: Terrain Height in metres (max − min); place the terrain at y = min.",
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "unreal_z_scale": {
              "description": "Unreal: Landscape Z scale for this encoding (range × 100 / 512).",
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "unreal_location_z_cm": {
              "description": "Unreal: Z location in centimetres so mid-grey (32768) lands at (min + max) / 2.",
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            }
          },
          "required": [
            "min_m",
            "max_m"
          ]
        }
      }
    }
  },
  {
    "id": "terrain.export_splines",
    "description": "Write rivers and placed splines as GeoJSON LineStrings: river centrelines traced from a 0..1 mask down the height layer's D8 drainage (one line per reach, ending on the reach it joins), plus every `jd.terrain.spline@1` polyline; coordinates in layer metres (Blender, engines), the world's CRS units, or WGS 84 longitude / latitude",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainExportSplines",
      "description": "Request of `terrain.export_splines`.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Output file (`.geojson`), relative to the project's exports/.",
          "type": "string"
        },
        "height": {
          "description": "Height layer the rivers drain over.",
          "type": "string",
          "default": "height"
        },
        "rivers": {
          "description": "A 0..1 river mask layer to trace (omit for graph splines only).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "threshold": {
          "description": "Mask value from which a cell is river.",
          "type": "number",
          "format": "float",
          "default": 0.5
        },
        "min_length_m": {
          "description": "Reaches shorter than this are dropped, metres.",
          "type": "number",
          "format": "float",
          "default": 50.0
        },
        "graph_splines": {
          "description": "Also write every `jd.terrain.spline@1` node's polyline (roads, canals, dykes).",
          "type": "boolean",
          "default": true
        },
        "coordinates": {
          "description": "Coordinate system of the numbers written.",
          "$ref": "#/$defs/SplineCoordinates",
          "default": "local_m"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "$defs": {
        "SplineCoordinates": {
          "description": "Which numbers a splines export writes.",
          "oneOf": [
            {
              "description": "Layer metres: `u` east from the west edge, `v` north from the south edge (Blender, engines).",
              "type": "string",
              "const": "local_m"
            },
            {
              "description": "The world's CRS units from its georeference origin (GIS with the same CRS).",
              "type": "string",
              "const": "world"
            },
            {
              "description": "WGS 84 longitude / latitude through the world's CRS (standard GeoJSON; needs a CRS).",
              "type": "string",
              "const": "wgs84"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SplinesReport",
      "description": "Result of `terrain.export_splines`.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The file written.",
          "type": "string"
        },
        "rivers": {
          "description": "River reaches written.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "splines": {
          "description": "Graph spline polylines written.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bytes": {
          "description": "Bytes written.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "coordinates": {
          "description": "What the coordinates are.",
          "$ref": "#/$defs/SplineCoordinates"
        }
      },
      "required": [
        "path",
        "rivers",
        "splines",
        "bytes",
        "coordinates"
      ],
      "$defs": {
        "SplineCoordinates": {
          "description": "Which numbers a splines export writes.",
          "oneOf": [
            {
              "description": "Layer metres: `u` east from the west edge, `v` north from the south edge (Blender, engines).",
              "type": "string",
              "const": "local_m"
            },
            {
              "description": "The world's CRS units from its georeference origin (GIS with the same CRS).",
              "type": "string",
              "const": "world"
            },
            {
              "description": "WGS 84 longitude / latitude through the world's CRS (standard GeoJSON; needs a CRS).",
              "type": "string",
              "const": "wgs84"
            }
          ]
        }
      }
    }
  },
  {
    "id": "terrain.generate",
    "description": "Generate a noise heightfield for the open project's world and store it as a layer",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainGenerate",
      "description": "`terrain.generate` params.",
      "type": "object",
      "properties": {
        "noise": {
          "description": "Noise parameters (all optional; see schema defaults).",
          "$ref": "#/$defs/NoiseParams",
          "default": {
            "kind": "open_simplex2",
            "fractal": "fbm",
            "seed": 0,
            "feature_size_m": 1024.0,
            "octaves": 6,
            "lacunarity": 2.0,
            "gain": 0.5,
            "height_range_m": [
              0.0,
              500.0
            ],
            "warp": null,
            "strength": 1.0,
            "offset_m": [
              0.0,
              0.0
            ]
          }
        },
        "layer": {
          "description": "Layer name to store the result under.",
          "type": "string",
          "default": "height"
        }
      },
      "additionalProperties": false,
      "$defs": {
        "NoiseParams": {
          "description": "Parameters of a noise heightfield generator.",
          "type": "object",
          "properties": {
            "kind": {
              "description": "Lattice.",
              "$ref": "#/$defs/NoiseKind",
              "default": "open_simplex2"
            },
            "fractal": {
              "description": "Fractal combinator.",
              "$ref": "#/$defs/FractalKind",
              "default": "fbm"
            },
            "seed": {
              "description": "Seed (combined with the world seed by the caller when desired).",
              "type": "integer",
              "format": "int32",
              "default": 0
            },
            "feature_size_m": {
              "description": "Feature size in metres (wavelength of the first octave).",
              "type": "number",
              "format": "float",
              "default": 1024.0
            },
            "octaves": {
              "description": "Octave count (1–16).",
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255,
              "default": 6
            },
            "lacunarity": {
              "description": "Frequency multiplier per octave.",
              "type": "number",
              "format": "float",
              "default": 2.0
            },
            "gain": {
              "description": "Amplitude multiplier per octave.",
              "type": "number",
              "format": "float",
              "default": 0.5
            },
            "height_range_m": {
              "description": "Output height range in metres: noise ∈ [-1,1] maps to [min, max].",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0.0,
                500.0
              ]
            },
            "warp": {
              "description": "Domain warp: the sampling coordinates are bent by a second noise before the lattice is\nread, which turns straight ridges and round cells into the swirled, folded shapes of\nreal relief (World Creator's distortion filter, Gaea's warp). Unset = none.",
              "anyOf": [
                {
                  "$ref": "#/$defs/DomainWarp"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "octave_weights": {
              "description": "Per-octave strengths (World Creator's octave bars), first = the coarsest octave; each 0..=2,\nat most `octaves` values (missing ones count as 1). fbm only. Empty = the plain fractal.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              }
            },
            "strength": {
              "description": "General strength 0..=4: scales the relief around the middle of `height_range_m` (1 = as is).",
              "type": "number",
              "format": "float",
              "default": 1.0
            },
            "offset_m": {
              "description": "Offset of the sampling origin in metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0.0,
                0.0
              ]
            }
          },
          "additionalProperties": false
        },
        "NoiseKind": {
          "description": "Base noise lattice.",
          "oneOf": [
            {
              "description": "OpenSimplex2 (fast, isotropic). Default.",
              "type": "string",
              "const": "open_simplex2"
            },
            {
              "description": "OpenSimplex2S (smoother).",
              "type": "string",
              "const": "open_simplex2_s"
            },
            {
              "description": "Improved Perlin.",
              "type": "string",
              "const": "perlin"
            },
            {
              "description": "Value noise.",
              "type": "string",
              "const": "value"
            },
            {
              "description": "Cubic value noise.",
              "type": "string",
              "const": "value_cubic"
            },
            {
              "description": "Cellular / Worley (F1 distance).",
              "type": "string",
              "const": "cellular"
            }
          ]
        },
        "FractalKind": {
          "description": "Fractal combinator.",
          "oneOf": [
            {
              "description": "Single octave.",
              "type": "string",
              "const": "none"
            },
            {
              "description": "Fractal Brownian motion. Default.",
              "type": "string",
              "const": "fbm"
            },
            {
              "description": "Ridged multifractal (mountain ridges).",
              "type": "string",
              "const": "ridged"
            },
            {
              "description": "Ping-pong (terraced/billowy).",
              "type": "string",
              "const": "ping_pong"
            }
          ]
        },
        "DomainWarp": {
          "description": "Domain warp settings.",
          "type": "object",
          "properties": {
            "amp_m": {
              "description": "How far a sample point is displaced, metres (> 0).",
              "type": "number",
              "format": "float"
            },
            "feature_m": {
              "description": "Wavelength of the displacement field, metres (> 0); larger folds the terrain in broader sweeps.",
              "type": "number",
              "format": "float"
            },
            "octaves": {
              "description": "Octaves of the displacement field (1..=8): more adds finer wrinkles to the folds.",
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255,
              "default": 3
            }
          },
          "additionalProperties": false,
          "required": [
            "amp_m",
            "feature_m"
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "LayerInfo",
      "description": "Result of `terrain.generate` / `terrain.stats`.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string"
        },
        "size_px": {
          "description": "Width, height in pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "tile_size": {
          "description": "Tile size and halo.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "halo": {
          "description": "Halo.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stats": {
          "description": "Statistics.",
          "$ref": "#/$defs/HeightfieldStats"
        },
        "content_hash": {
          "description": "blake3 content hash (hex).",
          "type": "string"
        },
        "duration_ms": {
          "description": "Wall time of the operation in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "layer",
        "size_px",
        "tile_size",
        "halo",
        "stats",
        "content_hash",
        "duration_ms"
      ],
      "$defs": {
        "HeightfieldStats": {
          "description": "Summary statistics over the whole field.",
          "type": "object",
          "properties": {
            "min": {
              "description": "Minimum height.",
              "type": "number",
              "format": "float"
            },
            "max": {
              "description": "Maximum height.",
              "type": "number",
              "format": "float"
            },
            "mean": {
              "description": "Mean height.",
              "type": "number",
              "format": "double"
            },
            "non_finite": {
              "description": "Count of non-finite samples (must be 0 for a valid field).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "min",
            "max",
            "mean",
            "non_finite"
          ]
        }
      }
    }
  },
  {
    "id": "terrain.horizon",
    "description": "The world's noise continued beyond its border: the graph's noise node evaluated over `scale` × the extent (same seed and origin, so it matches at the edge) at a coarse `px`, as a u16 preview — a horizon skirt for viewers; erosion and the rest of the graph are not continued",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainHorizon",
      "description": "`terrain.horizon` params.",
      "type": "object",
      "properties": {
        "scale": {
          "description": "How much larger than the world the horizon field is (1.5..=16), centred on the world.",
          "type": "number",
          "format": "float",
          "default": 3.0
        },
        "px": {
          "description": "Resolution of the horizon field in pixels per side (16..=1024).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 256
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "PreviewResult",
      "description": "`terrain.preview` result: a downsampled u16 heightfield, base64-encoded.\n(The desktop app uses the zero-copy `layer_preview` command; this op serves MCP agents\nand browser-based tests that cannot receive raw bytes.)",
      "type": "object",
      "properties": {
        "width": {
          "description": "Width in samples.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "description": "Height in samples.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "min": {
          "description": "Height of sample value 0.",
          "type": "number",
          "format": "float"
        },
        "max": {
          "description": "Height of sample value 65535.",
          "type": "number",
          "format": "float"
        },
        "bytes_base64": {
          "description": "The exact wire format of `jd_terrain::preview::Preview::to_bytes` (16-byte little-endian\nheader `u32 width, u32 height, f32 min, f32 max` followed by row-major u16 samples),\nstandard base64 with padding. One decoder serves both transports.",
          "type": "string"
        }
      },
      "required": [
        "width",
        "height",
        "min",
        "max",
        "bytes_base64"
      ]
    }
  },
  {
    "id": "terrain.measure",
    "description": "A layer's landform fingerprint — relief, hypsometric integral, slope mean / median / 90th percentile and 5° histogram, and the share of each geomorphon (flat, peak, ridge, shoulder, spur, slope, hollow, footslope, valley, pit) — to compare a generated world with a real DEM of the same landform",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainMeasure",
      "description": "`terrain.measure` params.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer to measure.",
          "type": "string",
          "default": "height"
        },
        "search_m": {
          "description": "How far the geomorphons look along each direction, metres; default 20 cells. Use the\nsame distance when comparing two terrains (a real DEM and its generated twin).",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "flat_deg": {
          "description": "Lines of sight within this angle of horizontal count as flat, degrees.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 44.0,
          "default": 1.0
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Fingerprint",
      "description": "A terrain's fingerprint.",
      "type": "object",
      "properties": {
        "cell_m": {
          "description": "Sample spacing, metres.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "relief_m": {
          "description": "Highest minus lowest, metres.",
          "type": "number",
          "format": "double"
        },
        "hypsometric_integral": {
          "description": "(mean − min) / (max − min): ~0.2–0.4 for old, eroded uplands, ~0.6+ for young plateaus\n(Strahler's hypsometric integral via Pike & Wilson's elevation–relief ratio).",
          "type": "number",
          "format": "double"
        },
        "slope": {
          "description": "Slope statistics, degrees.",
          "$ref": "#/$defs/SlopeStats"
        },
        "geomorphons": {
          "description": "Share of interior cells in each geomorphon class.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "search_m": {
          "description": "The `search_m` the geomorphons used.",
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "cell_m",
        "relief_m",
        "hypsometric_integral",
        "slope",
        "geomorphons",
        "search_m"
      ],
      "$defs": {
        "SlopeStats": {
          "description": "Slope statistics.",
          "type": "object",
          "properties": {
            "mean_deg": {
              "description": "Mean slope, degrees.",
              "type": "number",
              "format": "double"
            },
            "p50_deg": {
              "description": "Median, degrees.",
              "type": "number",
              "format": "double"
            },
            "p90_deg": {
              "description": "90th percentile, degrees.",
              "type": "number",
              "format": "double"
            },
            "histogram_5deg": {
              "description": "Share of cells per 5° band: 0–5, 5–10, …, 85–90.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "required": [
            "mean_deg",
            "p50_deg",
            "p90_deg",
            "histogram_5deg"
          ]
        }
      }
    }
  },
  {
    "id": "terrain.preview",
    "description": "Downsampled u16 preview of a layer (base64) for agents and viewers",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainPreview",
      "description": "`terrain.preview` params.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string",
          "default": "height"
        },
        "lod": {
          "description": "Downsample factor exponent (0 = full, 1 = half, …).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 2
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "PreviewResult",
      "description": "`terrain.preview` result: a downsampled u16 heightfield, base64-encoded.\n(The desktop app uses the zero-copy `layer_preview` command; this op serves MCP agents\nand browser-based tests that cannot receive raw bytes.)",
      "type": "object",
      "properties": {
        "width": {
          "description": "Width in samples.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "description": "Height in samples.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "min": {
          "description": "Height of sample value 0.",
          "type": "number",
          "format": "float"
        },
        "max": {
          "description": "Height of sample value 65535.",
          "type": "number",
          "format": "float"
        },
        "bytes_base64": {
          "description": "The exact wire format of `jd_terrain::preview::Preview::to_bytes` (16-byte little-endian\nheader `u32 width, u32 height, f32 min, f32 max` followed by row-major u16 samples),\nstandard base64 with padding. One decoder serves both transports.",
          "type": "string"
        }
      },
      "required": [
        "width",
        "height",
        "min",
        "max",
        "bytes_base64"
      ]
    }
  },
  {
    "id": "terrain.rocks",
    "description": "Generate seeded, faceted boulders as .glb meshes (icosphere squashed and displaced by value noise, flat base, flat shading) — scatter proxies and props",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainRocks",
      "description": "`terrain.rocks` params.",
      "type": "object",
      "properties": {
        "count": {
          "description": "How many rocks to write (1..=64): `rock_0.glb` … seeded `seed`, `seed + 1`, ….",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 4
        },
        "seed": {
          "description": "Seed: the same seed is the same rock.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "radius_m": {
          "description": "Nominal radius, metres (> 0).",
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "detail": {
          "description": "Icosphere subdivisions 0..=4: 20 · 4ⁿ triangles (2 → 320, 3 → 1 280).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 2
        },
        "roughness": {
          "description": "Surface displacement as a fraction of the radius, 0..=1 (0.35 is a weathered boulder).",
          "type": "number",
          "format": "float",
          "default": 0.3499999940395355
        },
        "flatten": {
          "description": "Share of the rock's height cut away at the bottom so it sits flat, 0..=0.5.",
          "type": "number",
          "format": "float",
          "default": 0.25
        },
        "dir": {
          "description": "Output directory; relative paths resolve against the project's `exports/`.",
          "type": "string",
          "default": "rocks"
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Array_of_RockFile",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RockFile"
      },
      "$defs": {
        "RockFile": {
          "description": "One written rock.",
          "type": "object",
          "properties": {
            "path": {
              "description": "Written `.glb`.",
              "type": "string"
            },
            "seed": {
              "description": "Seed of this rock.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "triangles": {
              "description": "Triangles.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "size_m": {
              "description": "Bounding box size x / y / z, metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "path",
            "seed",
            "triangles",
            "size_m"
          ]
        }
      }
    }
  },
  {
    "id": "terrain.scatter",
    "description": "Scatter instance points over the world from a 0..1 density mask layer (stratified jittered grid, deterministic by seed): write CSV / JSON / GLB instances to `path`, or return the points when `path` is omitted",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainScatter",
      "description": "`terrain.scatter` params.",
      "type": "object",
      "properties": {
        "mask": {
          "description": "0..1 density mask layer (a biome class mask, wetness, a painted mask…).",
          "type": "string"
        },
        "height": {
          "description": "Height layer sampled for `z` (null = 0).",
          "type": [
            "string",
            "null"
          ],
          "default": "height"
        },
        "path": {
          "description": "Output `.csv`, `.json` or `.glb` (proxy mesh instanced with `EXT_mesh_gpu_instancing`);\nrelative paths resolve against the project's `exports/`. Omit it to get the points\nback in the result instead (viewport preview; at most 200 000).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "model": {
          "description": "Instance your own model — a binary FBX mesh in the project's assets/ (metres, +Y up) — in `.glb`\noutput instead of the cone or the generated rock; wins over `rock` when both are given.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "rock": {
          "description": "Instance a generated rock (seeded from the scatter seed) instead of the 1 m cone proxy in `.glb` output.",
          "anyOf": [
            {
              "$ref": "#/$defs/RockParams"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avoid": {
          "description": "Keep clear of an earlier scatter: no point within `radius_m` of any instance in that CSV (ecosystem layers that exclude each other).",
          "anyOf": [
            {
              "$ref": "#/$defs/ScatterAvoid"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "follow_time": {
          "description": "Use the project's timeline position as the scatter `time` when `time` is not given (the desktop's live preview: scrub the timeline and the population grows).",
          "type": "boolean",
          "default": false
        },
        "engine": {
          "description": "Write `path` in an engine's own conventions instead of the plain formats: `unreal` → DataTable CSV in centimetres (X east, Y south, Z up, Yaw, Scale), `unity` → JSON in the Terrain's local metres (x east, y up, z north, nx/nz normalised).",
          "anyOf": [
            {
              "$ref": "#/$defs/EngineProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "spacing_m": {
          "description": "Target spacing between points in metres (grid cell size); must be ≥ one sample spacing.",
          "type": "number",
          "format": "float"
        },
        "jitter": {
          "description": "Random offset inside the cell, 0 (regular grid) .. 1 (anywhere in the cell).",
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "seed": {
          "description": "Seed for the jitter and the density test.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "time": {
          "description": "Timeline position 0..1: the population grows over the timeline — every instance has a\nbirth time spread across it and matures over the following half; unborn instances are\nnot placed, young ones carry `age` < 1 (writers scale by it). Omit for the full-grown population.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "mask",
        "spacing_m"
      ],
      "$defs": {
        "RockParams": {
          "description": "Rock settings.",
          "type": "object",
          "properties": {
            "seed": {
              "description": "Seed: the same seed is the same rock.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            },
            "radius_m": {
              "description": "Nominal radius, metres (> 0).",
              "type": "number",
              "format": "float",
              "default": 1.0
            },
            "detail": {
              "description": "Icosphere subdivisions 0..=4: 20 · 4ⁿ triangles (2 → 320, 3 → 1 280).",
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255,
              "default": 2
            },
            "roughness": {
              "description": "Surface displacement as a fraction of the radius, 0..=1 (0.35 is a weathered boulder).",
              "type": "number",
              "format": "float",
              "default": 0.3499999940395355
            },
            "flatten": {
              "description": "Share of the rock's height cut away at the bottom so it sits flat, 0..=0.5.",
              "type": "number",
              "format": "float",
              "default": 0.25
            }
          },
          "additionalProperties": false
        },
        "ScatterAvoid": {
          "description": "An earlier scatter layer to keep clear of.",
          "type": "object",
          "properties": {
            "csv": {
              "description": "Its `.csv` (`u,v,z,r`); relative paths resolve against the project's `exports/`.",
              "type": "string"
            },
            "radius_m": {
              "description": "Exclusion radius around each of its instances, metres (> 0).",
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false,
          "required": [
            "csv",
            "radius_m"
          ]
        },
        "EngineProfile": {
          "description": "Target engine.",
          "oneOf": [
            {
              "description": "Unity Terrain: RAW 16-bit little-endian, row 0 = south (no flip), Terrain Height = range.",
              "type": "string",
              "const": "unity"
            },
            {
              "description": "Unreal Landscape: PNG16, row 0 = north, Z scale = range_m × 100 / 512, 8-bit weightmaps.",
              "type": "string",
              "const": "unreal"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ScatterReport",
      "description": "`terrain.scatter` result.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Written file (null when the points were returned inline).",
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "description": "Points placed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "excluded": {
          "description": "Points dropped for `avoid` (within its radius of an earlier layer).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "bytes": {
          "description": "Bytes written (0 inline).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "spacing_m": {
          "description": "Grid spacing used.",
          "type": "number",
          "format": "float"
        },
        "points": {
          "description": "The points (`u` east, `v` north from the south edge, `z`, `r`) when no `path` was given.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ScatterPoint"
          }
        }
      },
      "required": [
        "count",
        "bytes",
        "spacing_m"
      ],
      "$defs": {
        "ScatterPoint": {
          "description": "A scattered instance in world metres (`u` east, `v` north from the south edge, `z` height).",
          "type": "object",
          "properties": {
            "u": {
              "description": "Easting from the west edge, metres.",
              "type": "number",
              "format": "float"
            },
            "v": {
              "description": "Northing from the south edge, metres.",
              "type": "number",
              "format": "float"
            },
            "z": {
              "description": "Terrain height at the point (0 when no height layer is given).",
              "type": "number",
              "format": "float"
            },
            "r": {
              "description": "Deterministic 0..1 value per point for the caller's own variation (scale, rotation).",
              "type": "number",
              "format": "float"
            },
            "age": {
              "description": "Growth 0..1 at the scatter's `time` (1 = mature; always 1 without a timeline). Writers scale by it.",
              "type": "number",
              "format": "float",
              "default": 1.0
            }
          },
          "required": [
            "u",
            "v",
            "z",
            "r"
          ]
        }
      }
    }
  },
  {
    "id": "terrain.stats",
    "description": "Statistics and content hash of a layer",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainLayer",
      "description": "`terrain.stats` params.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string",
          "default": "height"
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "LayerInfo",
      "description": "Result of `terrain.generate` / `terrain.stats`.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string"
        },
        "size_px": {
          "description": "Width, height in pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "tile_size": {
          "description": "Tile size and halo.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "halo": {
          "description": "Halo.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stats": {
          "description": "Statistics.",
          "$ref": "#/$defs/HeightfieldStats"
        },
        "content_hash": {
          "description": "blake3 content hash (hex).",
          "type": "string"
        },
        "duration_ms": {
          "description": "Wall time of the operation in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "layer",
        "size_px",
        "tile_size",
        "halo",
        "stats",
        "content_hash",
        "duration_ms"
      ],
      "$defs": {
        "HeightfieldStats": {
          "description": "Summary statistics over the whole field.",
          "type": "object",
          "properties": {
            "min": {
              "description": "Minimum height.",
              "type": "number",
              "format": "float"
            },
            "max": {
              "description": "Maximum height.",
              "type": "number",
              "format": "float"
            },
            "mean": {
              "description": "Mean height.",
              "type": "number",
              "format": "double"
            },
            "non_finite": {
              "description": "Count of non-finite samples (must be 0 for a valid field).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "min",
            "max",
            "mean",
            "non_finite"
          ]
        }
      }
    }
  },
  {
    "id": "terrain.textures",
    "description": "Bake the material maps of a layer — albedo, tangent-space normal, roughness — as PNGs (base64) for viewers and engines",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainTextures",
      "description": "`terrain.textures` params.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string",
          "default": "height"
        },
        "max_px": {
          "description": "Largest texture side in pixels (the field is sampled every ⌈size / max_px⌉ cells).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1024
        },
        "materials": {
          "description": "Material layers blended over the hypsometric base in order, each by its 0..1 mask layer (biome class masks, snow, wetness, painted) — the material graph's layer stack.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaterialSpec"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "$defs": {
        "MaterialSpec": {
          "description": "One material layer of the stack.",
          "type": "object",
          "properties": {
            "mask": {
              "description": "0..1 mask layer that weights this material (omit for everywhere).",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "albedo": {
              "description": "Base colour, sRGB 0..1.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "roughness": {
              "description": "Roughness 0..1.",
              "type": "number",
              "format": "float",
              "default": 0.8999999761581421
            },
            "emissive": {
              "description": "Emitted light, linear RGB 0..1 (unset = none): a lava flow's `heat` layer, embers, windows at night.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 3,
              "maxItems": 3,
              "default": null
            },
            "detail": {
              "description": "Tileable detail (grain repeated every `tile_m` metres): baked into the macro maps and\nthe GLB by world position, returned as tiles for the viewport, written as tiles for\nthe engines.",
              "anyOf": [
                {
                  "$ref": "#/$defs/DetailSpec"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "texture": {
              "description": "An image texture set from the project's assets/ (tileable PNGs): the albedo is sampled\ninto the maps by world position and the set is written as the layer's tile for the\nengines; `detail` wins when both are given.",
              "anyOf": [
                {
                  "$ref": "#/$defs/TextureSpec"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "albedo"
          ]
        },
        "DetailSpec": {
          "description": "A layer's tileable detail.",
          "type": "object",
          "properties": {
            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float",
              "minimum": 0.01,
              "maximum": 100000.0,
              "default": 8.0
            },
            "bump": {
              "description": "Normal strength 0..1.",
              "type": "number",
              "format": "float",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.5
            },
            "contrast": {
              "description": "Albedo variation 0..1.",
              "type": "number",
              "format": "float",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.30000001192092896
            },
            "seed": {
              "description": "Noise seed.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 0
            },
            "px": {
              "description": "Tile side in pixels (16..=2048).",
              "type": "integer",
              "format": "uint32",
              "minimum": 16,
              "maximum": 2048,
              "default": 512
            }
          },
          "additionalProperties": false
        },
        "TextureSpec": {
          "description": "An image texture set for a material layer.",
          "type": "object",
          "properties": {
            "albedo": {
              "description": "Tileable albedo PNG (sRGB) in the project's assets/ (or an absolute path).",
              "type": "string"
            },
            "normal": {
              "description": "Tangent-space normal PNG (+Y up), optional.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float"
            },
            "px": {
              "description": "Exported tile side in pixels (16..=4096; the images are resampled to it).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1024
            }
          },
          "additionalProperties": false,
          "required": [
            "albedo",
            "tile_m"
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TexturesResult",
      "description": "`terrain.textures` result: PNGs, standard base64.",
      "type": "object",
      "properties": {
        "width": {
          "description": "Texture width in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "description": "Texture height in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "albedo_png_base64": {
          "description": "Base colour (hypsometric ramp blended to rock on slopes), row 0 = south.",
          "type": "string"
        },
        "normal_png_base64": {
          "description": "Tangent-space normal map (+X east, +Y north, +Z out).",
          "type": "string"
        },
        "roughness_png_base64": {
          "description": "glTF ORM layout: ambient occlusion in R (1 − sky occlusion within 16 cells), roughness in G (0.92 flat → 0.62 steep rock, 0.6 above the snow line), metallic 0 in B.",
          "type": "string"
        },
        "emissive_png_base64": {
          "description": "Emissive map (PNG, base64) when a material layer emits; absent otherwise.",
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "description": "Detail tiles of the layers that have one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DetailOut"
          },
          "default": []
        },
        "detail_weights_png_base64": {
          "description": "The first four detail layers' masks packed into an RGBA PNG at the map size (base64),\nfor blending the tiles in a viewport; empty without details.",
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "width",
        "height",
        "albedo_png_base64",
        "normal_png_base64",
        "roughness_png_base64"
      ],
      "$defs": {
        "DetailOut": {
          "description": "One detail tile of a `terrain.textures` result.",
          "type": "object",
          "properties": {
            "layer": {
              "description": "Index of the layer in `materials`.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "mask": {
              "description": "Its mask layer name, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "tile_m": {
              "description": "Metres per repeat.",
              "type": "number",
              "format": "float"
            },
            "px": {
              "description": "Tile side, pixels.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "albedo_png_base64": {
              "description": "The colour tile (sRGB PNG, base64).",
              "type": "string"
            },
            "normal_png_base64": {
              "description": "The tangent-space normal tile (PNG, base64).",
              "type": "string"
            }
          },
          "required": [
            "layer",
            "tile_m",
            "px",
            "albedo_png_base64",
            "normal_png_base64"
          ]
        }
      }
    }
  },
  {
    "id": "timeline.export",
    "description": "Evaluate the graph at evenly spaced timeline positions and write one heightmap per frame (keyframed parameters animate; the project's own time is untouched)",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TimelineExport",
      "description": "`timeline.export` params.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "The output node's layer to write, one file per frame.",
          "type": "string",
          "default": "height"
        },
        "frames": {
          "description": "Number of frames (2..=10000), spread evenly from `from` to `to` inclusive.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "from": {
          "description": "First frame's timeline position (0..1).",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "to": {
          "description": "Last frame's timeline position (0..1).",
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "dir": {
          "description": "Output directory; relative paths resolve against the project's `exports/`. Files are `<layer>_<frame>.<ext>`.",
          "type": "string"
        },
        "lod": {
          "description": "Level of detail (0 = full resolution).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 0
        },
        "format": {
          "description": "Encoding.",
          "$ref": "#/$defs/HeightmapFormat"
        },
        "flip_y": {
          "description": "Flip rows so row 0 is north (image convention). Default true for images, false for RAW.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "range_m": {
          "description": "Height range mapped to [0, 65535] for quantised formats; defaults to the field's min/max.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        },
        "georeference": {
          "description": "For `tiff32`: write GeoTIFF tags (pixel scale, tie point, EPSG GeoKeys) when the caller\nsupplies a [`GeoRef`]. Default true; the file is then always north-up.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "frames",
        "dir",
        "format"
      ],
      "$defs": {
        "HeightmapFormat": {
          "description": "Supported heightmap encodings.",
          "oneOf": [
            {
              "description": "OpenEXR, single `Y` channel, 32-bit float, lossless (ZIP). Exact.",
              "type": "string",
              "const": "exr"
            },
            {
              "description": "16-bit grayscale PNG, normalised to the export range.",
              "type": "string",
              "const": "png16"
            },
            {
              "description": "Headerless little-endian u16, normalised to the export range (Unity / Unreal).",
              "type": "string",
              "const": "raw_r16"
            },
            {
              "description": "Headerless little-endian f32. Exact.",
              "type": "string",
              "const": "raw_r32"
            },
            {
              "description": "TIFF, single 32-bit float sample per pixel (GIS and DCC tools read it directly). Exact.",
              "type": "string",
              "const": "tiff32"
            },
            {
              "description": "ESRI ASCII grid (`.asc`): a six-line header (ncols, nrows, xllcorner, yllcorner, cellsize,\nNODATA_value) then rows north to south — GIS tools and World Machine read it. Square cells\nonly; the cell size and corner come from the georeference when given, else 1 m at (0, 0).",
              "type": "string",
              "const": "asc"
            },
            {
              "description": "XYZ points (`.xyz`): one `x y z` line per sample in metres (the georeference's origin and\nspacing when given, else cells of 1 m from (0, 0)), row 0 first. Exact, large.",
              "type": "string",
              "const": "xyz"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TimelineExportReport",
      "description": "`timeline.export` result.",
      "type": "object",
      "properties": {
        "dir": {
          "description": "Directory the frames went to.",
          "type": "string"
        },
        "frames": {
          "description": "The frames in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineFrame"
          }
        },
        "range_m": {
          "description": "Height range the quantised frames share, metres.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "duration_ms": {
          "description": "Wall time, milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "dir",
        "frames",
        "range_m",
        "duration_ms"
      ],
      "$defs": {
        "TimelineFrame": {
          "description": "One exported frame.",
          "type": "object",
          "properties": {
            "time": {
              "description": "Timeline position.",
              "type": "number",
              "format": "float"
            },
            "file": {
              "description": "File written.",
              "type": "string"
            },
            "min": {
              "description": "Height statistics of the frame, metres.",
              "type": "number",
              "format": "float"
            },
            "max": {
              "description": "Maximum.",
              "type": "number",
              "format": "float"
            },
            "mean": {
              "description": "Mean.",
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "time",
            "file",
            "min",
            "max",
            "mean"
          ]
        }
      }
    }
  },
  {
    "id": "vision.depth",
    "description": "Monocular depth from a photograph (MoGe-2 or Depth Anything 3 metric through ONNX Runtime, CPU) written as an OpenEXR relief 0..1 — or metres with `metric` — import it with `jd.input.heightmap@1` to sculpt from a picture",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "VisionDepth",
      "description": "`vision.depth` params.",
      "type": "object",
      "properties": {
        "image": {
          "description": "Photograph to read (PNG or JPEG; absolute, or relative to the project's `assets/`).",
          "type": "string"
        },
        "model": {
          "description": "ONNX model (absolute, or relative to the project root): MoGe-2 (`model.onnx` from\n`Ruicheng/moge-2-vit{s,b,l}-normal-onnx`, MIT) or Depth Anything 3 metric\n(`Heliosoph/da3metric-large-onnx`, Apache-2.0) — told apart by the graph's outputs.",
          "type": "string"
        },
        "path": {
          "description": "Output heightmap, OpenEXR f32 (absolute, or relative to the project's `exports/`): the\nrelief 0..1, near = high, row 0 = the top of the photograph, masked pixels 0 — or,\nwith `metric`, the depth per pixel in metres (masked pixels 0).",
          "type": "string",
          "default": "photo-depth.exr"
        },
        "fov_x_deg": {
          "description": "The camera's horizontal field of view in degrees, when known: MoGe-2 then fits the\nz shift only (its own estimate is the default), DA3 needs it for metres.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "minimum": 1.0,
          "maximum": 179.0,
          "default": null
        },
        "metric": {
          "description": "Write the depth in metres instead of the 0..1 relief.",
          "type": "boolean",
          "default": false
        },
        "camera_model": {
          "description": "DA3 only: the `da3-base` ONNX export (`Heliosoph/da3-base-onnx`, Apache-2.0; absolute,\nor relative to the project root) whose camera head estimates the field of view when\n`fov_x_deg` is not given — the metric export has no camera head of its own.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "camera_height_m": {
          "description": "Camera height above the ground, metres — a standing photographer's eye (~1.6), a drone's altitude: the\nground plane in the lower image is fitted and the metric depth rescaled so the camera sits that high\n(landscape photos otherwise read ~10× too close); reported as `ground`.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "max_px": {
          "description": "Long side the photograph is resized to before inference (518..=4096).",
          "type": "integer",
          "format": "uint32",
          "minimum": 518,
          "maximum": 4096,
          "default": 1024
        },
        "num_tokens": {
          "description": "Token budget of the model (1200..=3600): more is finer and slower.",
          "type": "integer",
          "format": "int64",
          "minimum": 1200,
          "maximum": 3600,
          "default": 1800
        }
      },
      "additionalProperties": false,
      "required": [
        "image",
        "model"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "VisionDepthResult",
      "description": "`vision.depth` result.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The EXR written.",
          "type": "string"
        },
        "px": {
          "description": "Field size in pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "masked_share": {
          "description": "Share of pixels the model masked out (sky, nothing), 0..1.",
          "type": "number",
          "format": "float"
        },
        "model": {
          "description": "`moge2` or `da3-metric`.",
          "type": "string"
        },
        "metric": {
          "description": "Whether `depth_m` (and a `metric` EXR) is in metres: always for MoGe-2, for DA3 only\nwith `fov_x_deg`.",
          "type": "boolean"
        },
        "fov_x_deg": {
          "description": "Horizontal field of view in degrees (recovered by MoGe-2, estimated by DA3's camera\nhead, or the one given).",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "fov_source": {
          "description": "`recovered`, `given`, `camera` or `none`.",
          "type": "string"
        },
        "depth_m": {
          "description": "Depth over the trusted pixels, `[min, max]`: metres when `metric`, else the model's\ncanonical units.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "metric_scale": {
          "description": "MoGe-2's metric scale (metres per unit of shifted z; 1 for DA3).",
          "type": "number",
          "format": "float"
        },
        "ground": {
          "description": "The ground-plane fit when `camera_height_m` was given and a plane was found: `[fitted_height_m, scale, inliers]`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "load_ms": {
          "description": "Milliseconds loading the model (0 when it was already resident).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "infer_ms": {
          "description": "Milliseconds in the session.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "px",
        "masked_share",
        "model",
        "metric",
        "fov_source",
        "depth_m",
        "metric_scale",
        "load_ms",
        "infer_ms"
      ]
    }
  }
]
