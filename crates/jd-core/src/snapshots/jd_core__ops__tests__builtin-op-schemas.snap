---
source: crates/jd-core/src/ops.rs
expression: list
---
[
  {
    "id": "diag.env",
    "description": "Report host environment and detected tools",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "EnvInfo",
      "description": "Snapshot of the host environment.",
      "type": "object",
      "properties": {
        "app_version": {
          "description": "Jenga Dunia version.",
          "type": "string"
        },
        "os": {
          "description": "OS name and version.",
          "type": "string"
        },
        "arch": {
          "description": "CPU architecture.",
          "type": "string"
        },
        "cpus": {
          "description": "Logical CPU count.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "memory_total_bytes": {
          "description": "Total physical memory in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "memory_available_bytes": {
          "description": "Currently available memory in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cwd": {
          "description": "Current working directory.",
          "type": "string"
        },
        "tools": {
          "description": "Optional external tools (validators, DCCs) detected on PATH.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolStatus"
          }
        }
      },
      "required": [
        "app_version",
        "os",
        "arch",
        "cpus",
        "memory_total_bytes",
        "memory_available_bytes",
        "cwd",
        "tools"
      ],
      "$defs": {
        "ToolStatus": {
          "description": "Presence of an optional external tool on `PATH`.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Tool name.",
              "type": "string"
            },
            "path": {
              "description": "Resolved path, if found.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name"
          ]
        }
      }
    }
  },
  {
    "id": "project.close",
    "description": "Close the open project (unsaved changes stay in the journal)",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectSummary",
      "description": "Summary returned by project ops.",
      "type": "object",
      "properties": {
        "project_id": {
          "description": "Project id.",
          "type": "string"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "path": {
          "description": "Directory.",
          "type": "string"
        },
        "world": {
          "description": "World settings.",
          "$ref": "#/$defs/WorldSettings"
        },
        "schema_version": {
          "description": "Document schema version.",
          "$ref": "#/$defs/SchemaVersion"
        },
        "dirty": {
          "description": "Unsaved changes?",
          "type": "boolean"
        },
        "pending_journal": {
          "description": "Journal entries awaiting replay.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "project_id",
        "name",
        "path",
        "world",
        "schema_version",
        "dirty",
        "pending_journal"
      ],
      "$defs": {
        "WorldSettings": {
          "description": "World extent, resolution and tiling (`docs/spec/project-format.md`).",
          "type": "object",
          "properties": {
            "extent_m": {
              "description": "Extent in metres, [x, y].",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "resolution_px": {
              "description": "Heightfield resolution in pixels, [x, y].",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "tile_size": {
              "description": "Tile edge length in pixels (power of two).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "halo": {
              "description": "Halo width in pixels around each tile.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "origin": {
              "description": "World-space origin of pixel (0,0), metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "crs": {
              "description": "Optional CRS identifier (e.g. \"EPSG:32637\") when georeferenced.",
              "type": [
                "string",
                "null"
              ]
            },
            "seed": {
              "description": "Master seed for all procedural randomness.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "extent_m",
            "resolution_px",
            "tile_size",
            "halo",
            "origin",
            "seed"
          ]
        },
        "SchemaVersion": {
          "description": "A monotonically increasing document/API schema version.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    }
  },
  {
    "id": "project.create",
    "description": "Create a new project directory and open it",
    "scope": "fs-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectCreate",
      "description": "`project.create` params.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Directory to create (conventionally ending in `.jdproj`).",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "world": {
          "description": "World settings; defaults when omitted.",
          "anyOf": [
            {
              "$ref": "#/$defs/WorldSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "name"
      ],
      "$defs": {
        "WorldSettings": {
          "description": "World extent, resolution and tiling (`docs/spec/project-format.md`).",
          "type": "object",
          "properties": {
            "extent_m": {
              "description": "Extent in metres, [x, y].",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "resolution_px": {
              "description": "Heightfield resolution in pixels, [x, y].",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "tile_size": {
              "description": "Tile edge length in pixels (power of two).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "halo": {
              "description": "Halo width in pixels around each tile.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "origin": {
              "description": "World-space origin of pixel (0,0), metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "crs": {
              "description": "Optional CRS identifier (e.g. \"EPSG:32637\") when georeferenced.",
              "type": [
                "string",
                "null"
              ]
            },
            "seed": {
              "description": "Master seed for all procedural randomness.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "extent_m",
            "resolution_px",
            "tile_size",
            "halo",
            "origin",
            "seed"
          ]
        }
      }
    },
    "result_schema": {
