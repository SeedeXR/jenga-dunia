  {
    "id": "project.set_settings",
    "description": "Change project settings (autosave interval, cache limit, preview LOD); fields left out keep their value — journaled like every mutation",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectSetSettings",
      "description": "`project.set_settings` params: fields left out keep their current value.",
      "type": "object",
      "properties": {
        "autosave_interval_s": {
          "description": "Seconds after the last edit before the desktop autosaves (0 disables).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "cache_limit_bytes": {
          "description": "Layer cache cap in bytes (≥ 16 MiB).",
