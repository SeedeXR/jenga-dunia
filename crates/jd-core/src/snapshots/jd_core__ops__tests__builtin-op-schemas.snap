      }
    }
  },
  {
    "id": "project.set_name",
    "description": "Rename the open project",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectSetName",
      "description": "`project.set_name` params.",
      "type": "object",
      "properties": {
        "name": {
          "description": "New display name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectSummary",
      "description": "Summary returned by project ops.",
      "type": "object",
      "properties": {
        "project_id": {
          "description": "Project id.",
          "type": "string"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "path": {
          "description": "Directory.",
          "type": "string"
        },
        "world": {
          "description": "World settings.",
          "$ref": "#/$defs/WorldSettings"
        },
        "schema_version": {
          "description": "Document schema version.",
          "$ref": "#/$defs/SchemaVersion"
        },
        "dirty": {
          "description": "Unsaved changes?",
          "type": "boolean"
        },
        "pending_journal": {
          "description": "Journal entries awaiting replay.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "project_id",
        "name",
        "path",
        "world",
        "schema_version",
        "dirty",
        "pending_journal"
      ],
      "$defs": {
        "WorldSettings": {
          "description": "World extent, resolution and tiling (`docs/spec/project-format.md`).",
          "type": "object",
          "properties": {
            "extent_m": {
              "description": "Extent in metres, [x, y].",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "resolution_px": {
              "description": "Heightfield resolution in pixels, [x, y].",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "tile_size": {
              "description": "Tile edge length in pixels (power of two).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "halo": {
              "description": "Halo width in pixels around each tile.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "origin": {
              "description": "World-space origin of pixel (0,0), metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "crs": {
              "description": "Optional CRS identifier (e.g. \"EPSG:32637\") when georeferenced.",
              "type": [
                "string",
                "null"
              ]
            },
            "seed": {
              "description": "Master seed for all procedural randomness.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "extent_m",
            "resolution_px",
            "tile_size",
            "halo",
            "origin",
            "seed"
          ]
        },
        "SchemaVersion": {
          "description": "A monotonically increasing document/API schema version.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    }
  },
  {
    "id": "terrain.export_heightmap",
    "description": "Write a layer as EXR (f32), PNG16, RAW r16 or r32 with a JSON sidecar",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainExport",
      "description": "`terrain.export_heightmap` params.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string",
          "default": "height"
        },
        "path": {
          "description": "Output file; relative paths resolve against the project's `exports/` directory.",
          "type": "string"
        },
        "format": {
          "description": "Encoding.",
          "$ref": "#/$defs/HeightmapFormat"
        },
        "flip_y": {
          "description": "Flip rows so row 0 is north (image convention). Default true for images, false for RAW.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "range_m": {
          "description": "Height range mapped to [0, 65535] for quantised formats; defaults to the field's min/max.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "format"
      ],
      "$defs": {
        "HeightmapFormat": {
          "description": "Supported heightmap encodings.",
          "oneOf": [
            {
              "description": "OpenEXR, single `Y` channel, 32-bit float, lossless (ZIP). Exact.",
              "type": "string",
              "const": "exr"
            },
            {
              "description": "16-bit grayscale PNG, normalised to the export range.",
              "type": "string",
              "const": "png16"
            },
            {
              "description": "Headerless little-endian u16, normalised to the export range (Unity / Unreal).",
              "type": "string",
              "const": "raw_r16"
            },
            {
              "description": "Headerless little-endian f32. Exact.",
              "type": "string",
              "const": "raw_r32"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ExportReport",
      "description": "What was written.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Written file.",
          "type": "string"
        },
        "sidecar": {
          "description": "Sidecar JSON (always written) describing size, range and conventions.",
          "type": "string"
        },
        "format": {
          "description": "Encoding.",
          "$ref": "#/$defs/HeightmapFormat"
        },
        "size_px": {
          "description": "Width, height in pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "range_m": {
          "description": "Height range encoded (for quantised formats) or observed (exact formats).",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "quantisation_step_m": {
          "description": "Metres per quantisation step (0 for exact formats).",
          "type": "number",
          "format": "float"
        },
        "flip_y": {
          "description": "Whether rows were flipped (row 0 = north).",
          "type": "boolean"
        },
        "bytes": {
          "description": "Bytes written to `path`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sidecar",
        "format",
        "size_px",
        "range_m",
        "quantisation_step_m",
        "flip_y",
        "bytes"
      ],
      "$defs": {
        "HeightmapFormat": {
          "description": "Supported heightmap encodings.",
          "oneOf": [
            {
              "description": "OpenEXR, single `Y` channel, 32-bit float, lossless (ZIP). Exact.",
              "type": "string",
              "const": "exr"
            },
            {
              "description": "16-bit grayscale PNG, normalised to the export range.",
              "type": "string",
              "const": "png16"
            },
            {
              "description": "Headerless little-endian u16, normalised to the export range (Unity / Unreal).",
              "type": "string",
              "const": "raw_r16"
            },
            {
              "description": "Headerless little-endian f32. Exact.",
              "type": "string",
              "const": "raw_r32"
            }
          ]
        }
      }
    }
  },
  {
    "id": "terrain.generate",
    "description": "Generate a noise heightfield for the open project's world and store it as a layer",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainGenerate",
      "description": "`terrain.generate` params.",
      "type": "object",
      "properties": {
        "noise": {
          "description": "Noise parameters (all optional; see schema defaults).",
          "$ref": "#/$defs/NoiseParams",
          "default": {
            "kind": "open_simplex2",
            "fractal": "fbm",
            "seed": 0,
            "feature_size_m": 1024.0,
            "octaves": 6,
            "lacunarity": 2.0,
            "gain": 0.5,
            "height_range_m": [
              0.0,
              500.0
            ],
            "offset_m": [
              0.0,
              0.0
            ]
          }
        },
        "layer": {
          "description": "Layer name to store the result under.",
          "type": "string",
          "default": "height"
        }
      },
      "additionalProperties": false,
      "$defs": {
        "NoiseParams": {
          "description": "Parameters of a noise heightfield generator.",
          "type": "object",
          "properties": {
            "kind": {
              "description": "Lattice.",
              "$ref": "#/$defs/NoiseKind",
              "default": "open_simplex2"
            },
            "fractal": {
              "description": "Fractal combinator.",
              "$ref": "#/$defs/FractalKind",
              "default": "fbm"
            },
            "seed": {
              "description": "Seed (combined with the world seed by the caller when desired).",
              "type": "integer",
              "format": "int32",
              "default": 0
            },
            "feature_size_m": {
              "description": "Feature size in metres (wavelength of the first octave).",
              "type": "number",
              "format": "float",
              "default": 1024.0
            },
            "octaves": {
              "description": "Octave count (1–16).",
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255,
              "default": 6
            },
            "lacunarity": {
              "description": "Frequency multiplier per octave.",
              "type": "number",
              "format": "float",
              "default": 2.0
            },
            "gain": {
              "description": "Amplitude multiplier per octave.",
              "type": "number",
              "format": "float",
              "default": 0.5
            },
            "height_range_m": {
              "description": "Output height range in metres: noise ∈ [-1,1] maps to [min, max].",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0.0,
                500.0
              ]
            },
            "offset_m": {
              "description": "Offset of the sampling origin in metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0.0,
                0.0
              ]
            }
          },
          "additionalProperties": false
        },
        "NoiseKind": {
          "description": "Base noise lattice.",
          "oneOf": [
            {
              "description": "OpenSimplex2 (fast, isotropic). Default.",
              "type": "string",
              "const": "open_simplex2"
            },
            {
              "description": "OpenSimplex2S (smoother).",
              "type": "string",
              "const": "open_simplex2_s"
            },
            {
              "description": "Improved Perlin.",
              "type": "string",
              "const": "perlin"
            },
            {
              "description": "Value noise.",
              "type": "string",
              "const": "value"
            },
            {
              "description": "Cubic value noise.",
              "type": "string",
              "const": "value_cubic"
            },
            {
              "description": "Cellular / Worley (F1 distance).",
              "type": "string",
              "const": "cellular"
            }
          ]
        },
        "FractalKind": {
          "description": "Fractal combinator.",
          "oneOf": [
            {
              "description": "Single octave.",
              "type": "string",
              "const": "none"
            },
            {
              "description": "Fractal Brownian motion. Default.",
              "type": "string",
              "const": "fbm"
            },
            {
              "description": "Ridged multifractal (mountain ridges).",
              "type": "string",
              "const": "ridged"
            },
            {
              "description": "Ping-pong (terraced/billowy).",
              "type": "string",
              "const": "ping_pong"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "LayerInfo",
      "description": "Result of `terrain.generate` / `terrain.stats`.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string"
        },
        "size_px": {
          "description": "Width, height in pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "tile_size": {
          "description": "Tile size and halo.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "halo": {
          "description": "Halo.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stats": {
          "description": "Statistics.",
          "$ref": "#/$defs/HeightfieldStats"
        },
        "content_hash": {
          "description": "blake3 content hash (hex).",
          "type": "string"
        },
        "duration_ms": {
          "description": "Wall time of the operation in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "layer",
        "size_px",
        "tile_size",
        "halo",
        "stats",
        "content_hash",
        "duration_ms"
      ],
      "$defs": {
        "HeightfieldStats": {
          "description": "Summary statistics over the whole field.",
          "type": "object",
          "properties": {
            "min": {
              "description": "Minimum height.",
              "type": "number",
              "format": "float"
            },
            "max": {
              "description": "Maximum height.",
              "type": "number",
              "format": "float"
            },
            "mean": {
              "description": "Mean height.",
              "type": "number",
              "format": "double"
            },
            "non_finite": {
              "description": "Count of non-finite samples (must be 0 for a valid field).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "min",
            "max",
            "mean",
            "non_finite"
          ]
        }
      }
    }
  },
  {
    "id": "terrain.stats",
    "description": "Statistics and content hash of a layer",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "TerrainLayer",
      "description": "`terrain.stats` params.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string",
          "default": "height"
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "LayerInfo",
      "description": "Result of `terrain.generate` / `terrain.stats`.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Layer name.",
          "type": "string"
        },
        "size_px": {
          "description": "Width, height in pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "tile_size": {
          "description": "Tile size and halo.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "halo": {
          "description": "Halo.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stats": {
          "description": "Statistics.",
          "$ref": "#/$defs/HeightfieldStats"
        },
        "content_hash": {
          "description": "blake3 content hash (hex).",
          "type": "string"
        },
        "duration_ms": {
          "description": "Wall time of the operation in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "layer",
        "size_px",
        "tile_size",
        "halo",
        "stats",
        "content_hash",
        "duration_ms"
      ],
      "$defs": {
        "HeightfieldStats": {
          "description": "Summary statistics over the whole field.",
          "type": "object",
          "properties": {
            "min": {
              "description": "Minimum height.",
              "type": "number",
              "format": "float"
            },
            "max": {
              "description": "Maximum height.",
              "type": "number",
              "format": "float"
            },
            "mean": {
              "description": "Mean height.",
              "type": "number",
              "format": "double"
            },
            "non_finite": {
              "description": "Count of non-finite samples (must be 0 for a valid field).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "min",
            "max",
            "mean",
            "non_finite"
          ]
        }
      }
    }
  }
]
