  {
    "id": "project.import_asset",
    "description": "Copy a file (DEM, heightmap, texture) into the project's assets/ so nodes can reference it by name",
    "scope": "fs-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ImportAsset",
      "description": "`project.import_asset` params.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Source file on disk.",
          "type": "string"
        },
        "name": {
          "description": "Name inside `assets/` (default: the source file name).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ImportedAsset",
      "description": "`project.import_asset` result.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name to reference from nodes (relative to `assets/`).",
          "type": "string"
        },
        "bytes": {
          "description": "Bytes copied.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "geo": {
          "description": "GeoTIFF georeferencing (pixel scale, tie point, nodata) when the file carries it.",
          "anyOf": [
            {
              "$ref": "#/$defs/GeoTags"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "bytes"
      ],
      "$defs": {
        "GeoTags": {
          "description": "Georeferencing read from a GeoTIFF (what the file says, no reprojection).",
          "type": "object",
          "properties": {
            "pixel_scale": {
              "description": "Ground size of one pixel, [x, y], in the file's CRS units (`ModelPixelScaleTag`).",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "tiepoint": {
              "description": "Raster → model tie point `[i, j, k, x, y, z]` (`ModelTiepointTag`, first point).",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 6,
              "maxItems": 6
            },
            "nodata": {
              "description": "`GDAL_NODATA` value.",
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "epsg": {
              "description": "EPSG code from the GeoKey directory (ProjectedCSTypeGeoKey or GeographicTypeGeoKey).",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            }
          }
        }
      }
    }
  },
