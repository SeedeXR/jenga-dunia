            "$ref": "#/$defs/NodeView"
          }
        },
        "edges": {
          "description": "Edges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "undo_depth": {
          "description": "Number of edits `graph.undo` can take back.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "redo_depth": {
          "description": "Number of undone edits `graph.redo` can re-apply.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "time": {
          "description": "Timeline position 0..1 at which keyed parameters resolve (`graph.set_time`).",
          "type": "number",
          "format": "float",
          "default": 0.0
        }
      },
      "required": [
        "nodes",
        "edges",
        "undo_depth",
        "redo_depth"
      ],
      "$defs": {
        "NodeView": {
          "description": "Node as reported by `graph.list`.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Id.",
              "$ref": "#/$defs/NodeId"
            },
            "kind": {
              "description": "Kind `name@version`.",
              "$ref": "#/$defs/NodeKind"
            },
            "params": {
              "description": "Parameters, validated against the kind's schema on every mutation.",
              "type": "object",
              "additionalProperties": true,
              "default": {}
            },
            "bypass": {
              "description": "Bypassed nodes pass their first input through unchanged.",
              "type": "boolean",
              "default": false
            },
            "ui": {
              "description": "Editor metadata.",
              "$ref": "#/$defs/UiMeta",
              "default": {
                "position": [
                  0.0,
                  0.0
                ]
              }
            }
          },
          "required": [
