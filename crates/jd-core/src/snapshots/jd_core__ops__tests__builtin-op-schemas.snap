---
source: crates/jd-core/src/ops.rs
expression: list
---
[
  {
    "id": "diag.env",
    "description": "Report host environment and detected tools",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "EnvInfo",
      "description": "Snapshot of the host environment.",
      "type": "object",
      "properties": {
        "app_version": {
          "description": "Jenga Dunia version.",
          "type": "string"
        },
        "os": {
          "description": "OS name and version.",
          "type": "string"
        },
        "arch": {
          "description": "CPU architecture.",
          "type": "string"
        },
        "cpus": {
          "description": "Logical CPU count.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "memory_total_bytes": {
          "description": "Total physical memory in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "memory_available_bytes": {
          "description": "Currently available memory in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cwd": {
          "description": "Current working directory.",
          "type": "string"
        },
        "tools": {
          "description": "Optional external tools (validators, DCCs) detected on PATH.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolStatus"
          }
        }
      },
      "required": [
        "app_version",
        "os",
        "arch",
        "cpus",
        "memory_total_bytes",
        "memory_available_bytes",
        "cwd",
        "tools"
      ],
      "$defs": {
        "ToolStatus": {
          "description": "Presence of an optional external tool on `PATH`.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Tool name.",
              "type": "string"
            },
            "path": {
              "description": "Resolved path, if found.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name"
          ]
        }
      }
    }
  },
  {
    "id": "graph.add_node",
    "description": "Add a node (journaled)",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AddNode",
      "description": "`graph.add_node` params.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Kind `name@version`, e.g. `jd.noise.fbm@1`.",
          "$ref": "#/$defs/NodeKind"
        },
        "params": {
          "description": "Parameters (validated against the kind's schema before journaling).",
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "id": {
          "description": "Optional client-chosen id (ULID); generated when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "position": {
          "description": "Editor position.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0.0,
            0.0
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "$defs": {
        "NodeKind": {
          "description": "A node kind identifier `namespace.name@version`, e.g. `jd.noise.fbm@1`.",
          "type": "string"
        },
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AddedNode",
      "description": "`graph.add_node` result.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Id of the new node.",
          "$ref": "#/$defs/NodeId"
        }
      },
      "required": [
        "id"
      ],
      "$defs": {
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    }
  },
  {
    "id": "graph.connect",
    "description": "Connect an output to an input (journaled; rejects bad ports, type mismatches and cycles)",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Connect",
      "description": "`graph.connect` / `graph.disconnect` params.",
      "type": "object",
      "properties": {
        "from": {
          "description": "Source node.",
          "$ref": "#/$defs/NodeId"
        },
        "from_port": {
          "description": "Source output port (default `out`).",
          "type": "string",
          "default": "out"
        },
        "to": {
          "description": "Destination node.",
          "$ref": "#/$defs/NodeId"
        },
        "to_port": {
          "description": "Destination input port.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "to_port"
      ],
      "$defs": {
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "GraphView",
      "description": "`graph.list` result.",
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Nodes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeView"
          }
        },
        "edges": {
          "description": "Edges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "undo_depth": {
          "description": "Number of edits `graph.undo` can take back.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "redo_depth": {
          "description": "Number of undone edits `graph.redo` can re-apply.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "nodes",
        "edges",
        "undo_depth",
        "redo_depth"
      ],
      "$defs": {
        "NodeView": {
          "description": "Node as reported by `graph.list`.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Id.",
              "$ref": "#/$defs/NodeId"
            },
            "kind": {
              "description": "Kind `name@version`.",
              "$ref": "#/$defs/NodeKind"
            },
            "params": {
              "description": "Parameters, validated against the kind's schema on every mutation.",
              "type": "object",
              "additionalProperties": true,
              "default": {}
            },
            "bypass": {
              "description": "Bypassed nodes pass their first input through unchanged.",
              "type": "boolean",
              "default": false
            },
            "ui": {
              "description": "Editor metadata.",
              "$ref": "#/$defs/UiMeta",
              "default": {
                "position": [
                  0.0,
                  0.0
                ]
              }
            }
          },
          "required": [
            "id",
            "kind"
          ]
        },
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        },
        "NodeKind": {
          "description": "A node kind identifier `namespace.name@version`, e.g. `jd.noise.fbm@1`.",
          "type": "string"
        },
        "UiMeta": {
          "description": "Editor-only metadata.",
          "type": "object",
          "properties": {
            "position": {
              "description": "Canvas position.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0.0,
                0.0
              ]
            },
            "label": {
              "description": "Display label override.",
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "Edge": {
          "description": "A directed connection from an output port to an input port.",
          "type": "object",
          "properties": {
            "from": {
              "description": "Source output.",
              "$ref": "#/$defs/PortRef"
            },
            "to": {
              "description": "Destination input.",
              "$ref": "#/$defs/PortRef"
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        "PortRef": {
          "description": "One end of an edge.",
          "type": "object",
          "properties": {
            "node": {
              "description": "Node id.",
              "$ref": "#/$defs/NodeId"
            },
            "port": {
              "description": "Port name.",
              "type": "string"
            }
          },
          "required": [
            "node",
            "port"
          ]
        }
      }
    }
  },
  {
    "id": "graph.disconnect",
    "description": "Remove an edge (journaled)",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Connect",
      "description": "`graph.connect` / `graph.disconnect` params.",
      "type": "object",
      "properties": {
        "from": {
          "description": "Source node.",
          "$ref": "#/$defs/NodeId"
        },
        "from_port": {
          "description": "Source output port (default `out`).",
          "type": "string",
          "default": "out"
        },
        "to": {
          "description": "Destination node.",
          "$ref": "#/$defs/NodeId"
        },
        "to_port": {
          "description": "Destination input port.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "to_port"
      ],
      "$defs": {
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "GraphView",
      "description": "`graph.list` result.",
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Nodes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeView"
          }
        },
        "edges": {
          "description": "Edges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "undo_depth": {
          "description": "Number of edits `graph.undo` can take back.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "redo_depth": {
          "description": "Number of undone edits `graph.redo` can re-apply.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "nodes",
        "edges",
        "undo_depth",
        "redo_depth"
      ],
      "$defs": {
        "NodeView": {
          "description": "Node as reported by `graph.list`.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Id.",
              "$ref": "#/$defs/NodeId"
            },
            "kind": {
              "description": "Kind `name@version`.",
              "$ref": "#/$defs/NodeKind"
            },
            "params": {
              "description": "Parameters, validated against the kind's schema on every mutation.",
              "type": "object",
              "additionalProperties": true,
              "default": {}
            },
            "bypass": {
              "description": "Bypassed nodes pass their first input through unchanged.",
              "type": "boolean",
              "default": false
            },
            "ui": {
              "description": "Editor metadata.",
              "$ref": "#/$defs/UiMeta",
              "default": {
                "position": [
                  0.0,
                  0.0
                ]
              }
            }
          },
          "required": [
            "id",
            "kind"
          ]
        },
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        },
        "NodeKind": {
          "description": "A node kind identifier `namespace.name@version`, e.g. `jd.noise.fbm@1`.",
          "type": "string"
        },
        "UiMeta": {
          "description": "Editor-only metadata.",
          "type": "object",
          "properties": {
            "position": {
              "description": "Canvas position.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0.0,
                0.0
              ]
            },
            "label": {
              "description": "Display label override.",
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "Edge": {
          "description": "A directed connection from an output port to an input port.",
          "type": "object",
          "properties": {
            "from": {
              "description": "Source output.",
              "$ref": "#/$defs/PortRef"
            },
            "to": {
              "description": "Destination input.",
              "$ref": "#/$defs/PortRef"
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        "PortRef": {
          "description": "One end of an edge.",
          "type": "object",
          "properties": {
            "node": {
              "description": "Node id.",
              "$ref": "#/$defs/NodeId"
            },
            "port": {
              "description": "Port name.",
              "type": "string"
            }
          },
          "required": [
            "node",
            "port"
          ]
        }
      }
    }
  },
  {
    "id": "graph.evaluate",
    "description": "Validate and evaluate the graph incrementally; publishes output nodes as layers (`<layer>#lod<N>` when lod > 0)",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Evaluate",
      "description": "`graph.evaluate` params.",
      "type": "object",
      "properties": {
        "lod": {
          "description": "Level of detail (0 = full resolution).",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "EvaluateResult",
      "description": "`graph.evaluate` result.",
      "type": "object",
      "properties": {
        "lod": {
          "description": "Level of detail evaluated.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "nodes": {
          "description": "Reports in evaluation order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeReport"
          }
        },
        "duration_ms": {
          "description": "Total milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "layers": {
          "description": "Layers published by output nodes (layer name → content hash).",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "lod",
        "nodes",
        "duration_ms",
        "layers"
      ],
      "$defs": {
        "NodeReport": {
          "description": "Per-node evaluation report.",
          "type": "object",
          "properties": {
            "node": {
              "description": "Node id.",
              "$ref": "#/$defs/NodeId"
            },
            "kind": {
              "description": "Kind.",
              "type": "string"
            },
            "hash": {
              "description": "Input hash (hex) — the cache key.",
              "type": "string"
            },
            "cached": {
              "description": "Served from cache?",
              "type": "boolean"
            },
            "duration_ms": {
              "description": "Milliseconds spent (0 when cached).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "node",
            "kind",
            "hash",
            "cached",
            "duration_ms"
          ]
        },
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    }
  },
  {
    "id": "graph.kinds",
    "description": "List available node kinds with ports and parameter schemas",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Array_of_NodeDefInfo",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NodeDefInfo"
      },
      "$defs": {
        "NodeDefInfo": {
          "description": "Machine-readable description of a node kind.",
          "type": "object",
          "properties": {
            "kind": {
              "description": "Kind.",
              "$ref": "#/$defs/NodeKind"
            },
            "description": {
              "description": "Description.",
              "type": "string"
            },
            "inputs": {
              "description": "Inputs.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Port"
              }
            },
            "outputs": {
              "description": "Outputs.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Port"
              }
            },
            "param_schema": {
              "description": "Param schema."
            }
          },
          "required": [
            "kind",
            "description",
            "inputs",
            "outputs",
            "param_schema"
          ]
        },
        "NodeKind": {
          "description": "A node kind identifier `namespace.name@version`, e.g. `jd.noise.fbm@1`.",
          "type": "string"
        },
        "Port": {
          "description": "A typed port declared by a node definition.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Port name, unique within the node's inputs or outputs.",
              "type": "string"
            },
            "ty": {
              "description": "Data type.",
              "$ref": "#/$defs/PortType"
            },
            "required": {
              "description": "Inputs only: must be connected for the node to evaluate.",
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "name",
            "ty"
          ]
        },
        "PortType": {
          "description": "Port data types. Only heightfields flow today; new types are added with their first producer.",
          "oneOf": [
            {
              "description": "f32 heightfield in metres (masks are heightfields in 0..1).",
              "type": "string",
              "const": "heightfield"
            }
          ]
        }
      }
    }
  },
  {
    "id": "graph.list",
    "description": "Nodes and edges of the open project's graph",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "GraphView",
      "description": "`graph.list` result.",
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Nodes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeView"
          }
        },
        "edges": {
          "description": "Edges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "undo_depth": {
          "description": "Number of edits `graph.undo` can take back.",
          "type": "integer",
          "format": "uint",
