  {
    "id": "jobs.cancel",
    "description": "Request cancellation of a running job; it stops at the next node or kernel iteration with E_CANCELLED",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CancelJob",
      "description": "`jobs.cancel` params.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Job id from `jobs.list`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "boolean",
      "type": "boolean"
    }
  },
  {
    "id": "jobs.list",
    "description": "Running jobs with progress (steps done/total, current node) — poll while an evaluation runs",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Array_of_JobInfo",
      "type": "array",
      "items": {
        "$ref": "#/$defs/JobInfo"
      },
      "$defs": {
        "JobInfo": {
          "description": "A running job as reported by `jobs.list`.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Job id (process-local, increasing).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "op": {
              "description": "Operation running.",
              "type": "string"
            },
            "elapsed_ms": {
              "description": "Milliseconds since the job started.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "done": {
              "description": "Steps finished (graph nodes).",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "total": {
              "description": "Total steps.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "current": {
              "description": "What is running now (node kind).",
              "type": "string"
            },
            "cancelling": {
              "description": "Cancel requested.",
              "type": "boolean"
            },
            "state": {
              "description": "`running`, or `queued` for a detached job waiting for a worker slot.",
              "type": "string"
            },
            "priority": {
              "description": "Queue priority: `low`, `normal` or `high`.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "op",
            "elapsed_ms",
            "done",
            "total",
            "current",
            "cancelling",
            "state",
            "priority"
          ]
        }
      }
    }
  },
  {
    "id": "jobs.result",
    "description": "State of a job: running (progress), done (the finished op's envelope, handed over once) or unknown",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CancelJob",
      "description": "`jobs.cancel` params.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Job id from `jobs.list`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "JobResult",
      "description": "What `jobs.result` reports.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Job id asked for.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "description": "`running`, `done` (envelope attached, now collected) or `unknown` (never existed or already collected).",
          "type": "string"
        },
        "info": {
          "description": "Progress while running.",
          "anyOf": [
            {
              "$ref": "#/$defs/JobInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "description": "The finished op's envelope fields: `status`, `result` / `error`, `warnings`."
        }
      },
      "required": [
        "id",
        "state"
      ],
      "$defs": {
        "JobInfo": {
          "description": "A running job as reported by `jobs.list`.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Job id (process-local, increasing).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "op": {
              "description": "Operation running.",
              "type": "string"
            },
            "elapsed_ms": {
              "description": "Milliseconds since the job started.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "done": {
              "description": "Steps finished (graph nodes).",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "total": {
              "description": "Total steps.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "current": {
              "description": "What is running now (node kind).",
              "type": "string"
            },
            "cancelling": {
              "description": "Cancel requested.",
              "type": "boolean"
            },
            "state": {
              "description": "`running`, or `queued` for a detached job waiting for a worker slot.",
              "type": "string"
            },
            "priority": {
              "description": "Queue priority: `low`, `normal` or `high`.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "op",
            "elapsed_ms",
            "done",
            "total",
            "current",
            "cancelling",
            "state",
            "priority"
          ]
        }
      }
    }
  },
  {
    "id": "project.cache_gc",
    "description": "Evict the oldest cached layer blobs until the project's cache fits `settings.cache_limit_bytes` (the cache is disposable); reports what is left",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "GcReport",
      "description": "What [`LayerCache::gc`] found and did.",
      "type": "object",
      "properties": {
        "blobs": {
          "description": "Blobs kept.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "bytes": {
          "description": "Bytes kept.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "evicted_blobs": {
          "description": "Blobs removed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "evicted_bytes": {
          "description": "Bytes removed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "limit_bytes": {
          "description": "The limit applied (None = report only).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "blobs",
        "bytes",
        "evicted_blobs",
        "evicted_bytes"
      ]
    }
  },
  {
    "id": "project.close",
    "description": "Close the open project (unsaved changes stay in the journal)",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectSummary",
      "description": "Summary returned by project ops.",
      "type": "object",
      "properties": {
        "project_id": {
          "description": "Project id.",
          "type": "string"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "path": {
          "description": "Directory.",
          "type": "string"
        },
        "world": {
          "description": "World settings.",
          "$ref": "#/$defs/WorldSettings"
        },
        "schema_version": {
          "description": "Document schema version.",
          "$ref": "#/$defs/SchemaVersion"
        },
        "dirty": {
          "description": "Unsaved changes?",
          "type": "boolean"
        },
        "pending_journal": {
          "description": "Journal entries awaiting replay.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "settings": {
          "description": "User-tunable settings (`project.json` → `settings`): autosave interval, cache limit, preview LOD.",
          "$ref": "#/$defs/ProjectSettings"
        }
      },
      "required": [
        "project_id",
        "name",
        "path",
        "world",
        "schema_version",
        "dirty",
        "pending_journal",
        "settings"
      ],
      "$defs": {
        "WorldSettings": {
          "description": "World extent, resolution and tiling (`docs/spec/project-format.md`).",
          "type": "object",
          "properties": {
            "extent_m": {
              "description": "Extent in metres, [x, y].",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "resolution_px": {
              "description": "Heightfield resolution in pixels, [x, y].",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "tile_size": {
              "description": "Tile edge length in pixels (power of two).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "halo": {
              "description": "Halo width in pixels around each tile.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "origin": {
              "description": "World-space origin of pixel (0,0), metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "crs": {
              "description": "Optional CRS identifier (e.g. \"EPSG:32637\") when georeferenced.",
              "type": [
                "string",
                "null"
              ]
            },
            "seed": {
              "description": "Master seed for all procedural randomness.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "extent_m",
            "resolution_px",
            "tile_size",
            "halo",
            "origin",
            "seed"
          ]
        },
        "SchemaVersion": {
          "description": "A monotonically increasing document/API schema version.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ProjectSettings": {
          "description": "User-tunable project settings.",
          "type": "object",
          "properties": {
            "autosave_interval_s": {
              "description": "Autosave interval in seconds (0 disables).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "cache_limit_bytes": {
              "description": "Cache size cap in bytes.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "preview_lod": {
              "description": "Preview LOD (resolution divided by 2^lod).",
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            },
            "memory_budget_bytes": {
              "description": "Evaluations whose pre-flight memory estimate exceeds this are refused (`E_RESOURCE_MEMORY`).\nDefault 4 GiB — the brief's ceiling (ADR-0008).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "default": 4294967296
            }
          },
          "required": [
            "autosave_interval_s",
            "cache_limit_bytes",
            "preview_lod"
          ]
        }
      }
    }
  },
  {
    "id": "project.create",
    "description": "Create a new project directory and open it",
    "scope": "fs-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ProjectCreate",
      "description": "`project.create` params.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Directory to create (conventionally ending in `.jdproj`).",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "world": {
          "description": "World settings; defaults when omitted.",
          "anyOf": [
            {
              "$ref": "#/$defs/WorldSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "name"
      ],
      "$defs": {
        "WorldSettings": {
          "description": "World extent, resolution and tiling (`docs/spec/project-format.md`).",
          "type": "object",
          "properties": {
            "extent_m": {
              "description": "Extent in metres, [x, y].",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "resolution_px": {
              "description": "Heightfield resolution in pixels, [x, y].",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "tile_size": {
              "description": "Tile edge length in pixels (power of two).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "halo": {
              "description": "Halo width in pixels around each tile.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "origin": {
              "description": "World-space origin of pixel (0,0), metres.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "crs": {
              "description": "Optional CRS identifier (e.g. \"EPSG:32637\") when georeferenced.",
              "type": [
                "string",
                "null"
              ]
            },
            "seed": {
              "description": "Master seed for all procedural randomness.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "extent_m",
            "resolution_px",
            "tile_size",
            "halo",
            "origin",
            "seed"
          ]
        }
      }
    },
