            },
            "px": {
              "description": "Tile side in pixels (16..=2048).",
              "type": "integer",
              "format": "uint32",
              "minimum": 16,
              "maximum": 2048,
              "default": 512
            }
          },
          "additionalProperties": false
        },
        "TextureSpec": {
          "description": "An image texture set for a material layer.",
          "type": "object",
