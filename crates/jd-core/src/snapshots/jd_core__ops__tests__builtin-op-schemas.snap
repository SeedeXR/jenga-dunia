  {
    "id": "jobs.cancel",
    "description": "Request cancellation of a running job; it stops at the next node or kernel iteration with E_CANCELLED",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CancelJob",
      "description": "`jobs.cancel` params.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Job id from `jobs.list`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "boolean",
      "type": "boolean"
    }
  },
  {
    "id": "jobs.list",
    "description": "Running jobs with progress (steps done/total, current node) — poll while an evaluation runs",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Array_of_JobInfo",
      "type": "array",
      "items": {
        "$ref": "#/$defs/JobInfo"
      },
      "$defs": {
        "JobInfo": {
          "description": "A running job as reported by `jobs.list`.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Job id (process-local, increasing).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "op": {
              "description": "Operation running.",
              "type": "string"
            },
            "elapsed_ms": {
              "description": "Milliseconds since the job started.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "done": {
              "description": "Steps finished (graph nodes).",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "total": {
              "description": "Total steps.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "current": {
              "description": "What is running now (node kind).",
              "type": "string"
            },
            "cancelling": {
              "description": "Cancel requested.",
              "type": "boolean"
            },
            "state": {
              "description": "`running`, or `queued` for a detached job waiting for a worker slot.",
              "type": "string"
            },
            "priority": {
              "description": "Queue priority: `low`, `normal` or `high`.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "op",
            "elapsed_ms",
            "done",
            "total",
            "current",
            "cancelling",
            "state",
            "priority"
          ]
        }
      }
    }
  },
  {
    "id": "jobs.result",
    "description": "State of a job: running (progress), done (the finished op's envelope, handed over once) or unknown",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CancelJob",
      "description": "`jobs.cancel` params.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Job id from `jobs.list`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "JobResult",
      "description": "What `jobs.result` reports.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Job id asked for.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "description": "`running`, `done` (envelope attached, now collected) or `unknown` (never existed or already collected).",
          "type": "string"
        },
        "info": {
          "description": "Progress while running.",
          "anyOf": [
            {
              "$ref": "#/$defs/JobInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "description": "The finished op's envelope fields: `status`, `result` / `error`, `warnings`."
        }
      },
      "required": [
        "id",
        "state"
      ],
      "$defs": {
        "JobInfo": {
          "description": "A running job as reported by `jobs.list`.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Job id (process-local, increasing).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "op": {
              "description": "Operation running.",
              "type": "string"
            },
            "elapsed_ms": {
              "description": "Milliseconds since the job started.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "done": {
              "description": "Steps finished (graph nodes).",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "total": {
              "description": "Total steps.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "current": {
              "description": "What is running now (node kind).",
              "type": "string"
            },
            "cancelling": {
              "description": "Cancel requested.",
              "type": "boolean"
            },
            "state": {
              "description": "`running`, or `queued` for a detached job waiting for a worker slot.",
              "type": "string"
            },
            "priority": {
              "description": "Queue priority: `low`, `normal` or `high`.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "op",
            "elapsed_ms",
            "done",
            "total",
            "current",
            "cancelling",
            "state",
            "priority"
          ]
        }
      }
    }
  },
  {
    "id": "media.metadata",
    "description": "What a photo, 360° photo sphere or video states about where, when and how it was taken — GPS position, UTC capture time, compass heading, field of view, exposure, panorama / 360° video projection and the north column — and the sun's azimuth and elevation then; suggests params for geo.fetch_dem, sky and vision.depth",
    "scope": "project-read",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "MediaMetadataParams",
      "description": "`media.metadata` params.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Photo (JPEG, PNG, TIFF, HEIF, WebP — flat or a 360° photo sphere) or video (MP4, MOV,\n360° included): absolute, or relative to the open project's `assets/`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "MediaMetadataResult",
      "description": "`media.metadata` result: the facts in the file and what to feed the other ops.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The file read.",
          "type": "string"
        },
        "kind": {
          "description": "`photo`, `photo360`, `video` or `video360`.",
          "type": "string"
        },
        "format": {
          "description": "Container: `jpeg`, `png`, `tiff`, `heif`, `webp`, `mp4` or `mov`.",
          "type": "string"
        },
        "px": {
          "description": "Displayed width and height in pixels (after the EXIF orientation).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "orientation": {
          "description": "EXIF orientation 1..8 (6 and 8 are portrait shots stored sideways).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "captured_at_utc": {
          "description": "Capture instant, UTC, RFC 3339.",
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at_source": {
          "description": "Where the instant came from: `gps` (satellite UTC), `exif_offset` (camera clock + its UTC\noffset), `gpano_first_photo_date` (a photo sphere's first source photo, UTC),\n`exif_local_assumed_utc` (camera clock, no offset — may be hours off), `mvhd` or\n`quicktime_creationdate`.",
          "type": [
            "string",
            "null"
          ]
        },
        "local_offset": {
          "description": "The camera's UTC offset at capture, `±HH:MM`.",
          "type": [
            "string",
            "null"
          ]
        },
        "gps": {
          "description": "Position, WGS 84.",
          "anyOf": [
            {
              "$ref": "#/$defs/Gps"
            },
            {
              "type": "null"
            }
          ]
        },
        "heading_deg": {
          "description": "Compass direction the camera faced, degrees clockwise from north.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "heading_ref": {
          "description": "`true` or `magnetic` (a magnetic heading is not corrected for declination).",
          "type": [
            "string",
            "null"
          ]
        },
        "heading_source": {
          "description": "Where the heading came from.",
          "type": [
            "string",
            "null"
          ]
        },
        "pitch_deg": {
          "description": "Camera pitch, degrees above the horizon (Apple video `direction.facing`).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "fov_x_deg": {
          "description": "Horizontal field of view, degrees (flat photos only).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "fov_source": {
          "description": "`sensor` (focal length + focal-plane resolution), `f35_diag` (35 mm equivalent by the\ndiagonal) or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "camera": {
          "description": "Camera make, model and lens.",
          "anyOf": [
            {
              "$ref": "#/$defs/Camera"
            },
            {
              "type": "null"
            }
          ]
        },
        "exposure": {
          "description": "Exposure settings.",
          "anyOf": [
            {
              "$ref": "#/$defs/Exposure"
            },
            {
              "type": "null"
            }
          ]
        },
        "projection": {
          "description": "Panorama / 360° video projection, when the file declares one.",
          "anyOf": [
            {
              "$ref": "#/$defs/Projection"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_s": {
          "description": "Video duration, seconds.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "sun": {
          "description": "The sun at the capture place and instant (needs `gps` and `captured_at_utc`).",
          "anyOf": [
            {
              "$ref": "#/$defs/Sun"
            },
            {
              "type": "null"
            }
          ]
        },
        "hints": {
          "description": "Things the file suggests but does not state (e.g. a 2:1 image with no panorama tags).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggest": {
          "description": "Ready-made params for the ops these facts drive.",
          "$ref": "#/$defs/MediaSuggest"
        },
        "notes": {
          "description": "How far to trust the facts above (assumed time zones, magnetic headings, phone compasses).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "path",
        "kind",
        "format",
        "hints",
        "suggest",
        "notes"
      ],
      "$defs": {
        "Gps": {
          "description": "A WGS 84 position.",
          "type": "object",
          "properties": {
            "lat": {
              "description": "Latitude, degrees north.",
              "type": "number",
              "format": "double"
            },
            "lon": {
              "description": "Longitude, degrees east.",
              "type": "number",
              "format": "double"
            },
            "alt_m": {
              "description": "Altitude above sea level, metres.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "required": [
            "lat",
            "lon"
          ]
        },
        "Camera": {
          "description": "Camera identity and optics.",
          "type": "object",
          "properties": {
            "make": {
              "description": "Manufacturer.",
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "description": "Model.",
              "type": [
                "string",
                "null"
              ]
            },
            "focal_mm": {
              "description": "Real focal length, mm.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "focal_35mm": {
              "description": "35 mm equivalent focal length, mm.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          }
        },
        "Exposure": {
          "description": "Exposure settings.",
          "type": "object",
          "properties": {
            "exposure_s": {
              "description": "Shutter time, seconds.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "f_number": {
              "description": "Aperture f-number.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "iso": {
              "description": "ISO sensitivity.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "ev100": {
              "description": "Exposure value at ISO 100: log2(N²/t) − log2(ISO/100). Bright sunlight ≈ 15, overcast ≈ 12.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          }
        },
        "Projection": {
          "description": "A declared projection.",
          "type": "object",
          "properties": {
            "type": {
              "description": "`equirectangular` or `cubemap`.",
              "type": "string"
            },
            "pose_heading_deg": {
              "description": "Heading of the full panorama's centre column, degrees clockwise from north.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "pose_pitch_deg": {
              "description": "Pitch, degrees.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "pose_roll_deg": {
              "description": "Roll, degrees.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "full_px": {
              "description": "Full panorama size (GPano), pixels.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "crop_left_top": {
              "description": "Left and top of the stored crop inside the full panorama, pixels.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "north_column_px": {
              "description": "Column of the stored image that faces true north (needs a heading).",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "stereo": {
              "description": "`mono`, `top-bottom`, `left-right`, `custom` or `right-left` (video).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        "Sun": {
          "description": "The sun's position.",
          "type": "object",
          "properties": {
            "azimuth_deg": {
              "description": "Azimuth, degrees clockwise from true north.",
              "type": "number",
              "format": "double"
            },
            "elevation_deg": {
              "description": "Elevation above the horizon with atmospheric refraction, degrees.",
              "type": "number",
              "format": "double"
            },
            "below_horizon": {
              "description": "True when the sun was below the horizon (night or twilight).",
              "type": "boolean"
            }
          },
          "required": [
            "azimuth_deg",
            "elevation_deg",
            "below_horizon"
          ]
        },
        "MediaSuggest": {
          "description": "Params for other ops, from a file's metadata.",
          "type": "object",
          "properties": {
            "geo_fetch_dem": {
              "description": "`geo.fetch_dem` around the camera: `{center: [lon, lat], radius_m}`."
            },
            "sky": {
              "description": "`sky.preview` / `sky.bake` sun: `{sun_azimuth_deg, sun_elevation_deg}` (sun above the horizon only)."
            },
            "vision_depth": {
              "description": "`vision.depth` field of view: `{fov_x_deg}` (flat photos only)."
            }
          }
        }
      }
    }
  },
  {
    "id": "ocean.bake",
    "description": "Write the water textures of a sea at `level_m`: depth (16-bit), the water's colour through its clarity and tint (sRGB), the shoreline + surf foam, and a tileable Gerstner wave normal map for the wind sea",
    "scope": "export",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "OceanBake",
      "description": "`ocean.bake` params.",
      "type": "object",
      "properties": {
        "layer": {
          "description": "Height layer the sea floods.",
          "type": "string",
          "default": "height"
        },
        "level_m": {
          "description": "Sea level, metres.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "visibility_m": {
          "description": "Depth at which the bottom fades out, metres (> 0): ~30 crystal clear, 15 open ocean, 3 murky.",
          "type": "number",
          "format": "float",
          "default": 15.0
        },
        "tint": {
          "description": "Colour of the suspended matter scattered back, linear RGB 0..1.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            0.10000000149011612,
            0.3499999940395355,
            0.4000000059604645
          ]
        },
        "wind_speed_mps": {
          "description": "Wind speed 10 m above the sea, m/s (≥ 0; 0 = flat calm): 3 ripples, 8 moderate sea, 20 gale.",
          "type": "number",
          "format": "float",
          "default": 8.0
        },
        "fetch_km": {
          "description": "Fetch, km: how far the wind has blown over open water (> 0). Omit for a fully developed sea.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "wind_azimuth_deg": {
          "description": "Where the wind blows FROM, degrees clockwise from north; waves travel the opposite way.",
          "type": "number",
          "format": "float",
          "default": 270.0
        },
        "max_px": {
          "description": "Largest side of the depth / colour / foam maps, pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1024
        },
        "wave_px": {
          "description": "Side of the tileable wave normal map, pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 512
        },
        "wave_tile_m": {
          "description": "World size the wave tile covers, metres; omit for a quarter of the world's width.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "shore": {
          "description": "Optional 0..1 shore layer (the coastal node's `shore` output): added to the foam as wash along exposed, eroding shores.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "dir": {
          "description": "Output directory; relative paths resolve against the project's `exports/`.",
          "type": "string",
          "default": "water"
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "OceanBakeResult",
      "description": "`ocean.bake` result.",
      "type": "object",
      "properties": {
        "dir": {
          "description": "Directory the four PNGs were written to.",
          "type": "string"
        },
        "files": {
          "description": "`water_depth.png` (16-bit grey, depth / max_depth_m), `water_colour.png` (sRGB), `water_foam.png` (8-bit grey), `wave_normal.png` (tangent space, tileable), `wave_displacement.png` (16-bit RGB: east / up / north offsets at t = 0, `v / displacement_scale_m · 0.5 + 0.5`, tileable).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "px": {
          "description": "Depth / colour / foam map size, pixels.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "max_depth_m": {
          "description": "Deepest water, metres (the depth map's white point).",
          "type": "number",
          "format": "float"
        },
        "wave_tile_m": {
          "description": "Wave tile side in metres and pixels.",
          "type": "number",
          "format": "float"
        },
        "wave_px": {
          "description": "Wave tile side, pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "waves": {
          "description": "The wind sea that was baked.",
          "$ref": "#/$defs/WaveSpectrum"
        },
        "tile_components": {
          "description": "The components as snapped to the tile (wavelength and direction may differ slightly from `waves`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/WaveComponent"
          }
        },
        "displacement_scale_m": {
          "description": "Metres per full channel swing of `wave_displacement.png` (the largest offset the sea reaches).",
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "dir",
        "files",
        "px",
        "max_depth_m",
        "wave_tile_m",
        "wave_px",
        "waves",
        "tile_components",
        "displacement_scale_m"
      ],
      "$defs": {
        "WaveSpectrum": {
          "description": "The wind sea: bulk statistics plus the Gerstner components that draw it.",
          "type": "object",
          "properties": {
            "significant_height_m": {
              "description": "Significant wave height Hs (mean of the highest third), m.",
              "type": "number",
              "format": "float"
            },
            "peak_period_s": {
              "description": "Peak period Tp, s.",
              "type": "number",
              "format": "float"
            },
            "wavelength_m": {
              "description": "Peak wavelength, m.",
              "type": "number",
              "format": "float"
            },
            "fully_developed": {
              "description": "Whether the fetch was long enough for the sea to be fully developed for this wind.",
              "type": "boolean"
            },
            "breaking_depth_m": {
              "description": "Depth (m) shallower than which waves of this height break (H/d = 0.78): the surf zone.",
              "type": "number",
              "format": "float"
            },
            "components": {
              "description": "Gerstner components, largest first.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/WaveComponent"
              }
            }
          },
          "required": [
            "significant_height_m",
            "peak_period_s",
            "wavelength_m",
            "fully_developed",
            "breaking_depth_m",
            "components"
          ]
        },
        "WaveComponent": {
          "description": "One trochoidal (Gerstner) wave.",
          "type": "object",
          "properties": {
            "amplitude_m": {
              "description": "Crest height above the mean surface, m.",
              "type": "number",
              "format": "float"
            },
            "wavelength_m": {
              "description": "Crest-to-crest distance, m.",
              "type": "number",
              "format": "float"
            },
            "direction_deg": {
              "description": "Travel direction, degrees clockwise from north.",
              "type": "number",
              "format": "float"
            },
            "speed_mps": {
              "description": "Deep-water phase speed √(g L / 2π), m/s.",
              "type": "number",
              "format": "float"
            },
            "phase": {
              "description": "Phase offset, radians.",
              "type": "number",
              "format": "float"
            }
          },
          "required": [
            "amplitude_m",
            "wavelength_m",
            "direction_deg",
            "speed_mps",
            "phase"
          ]
        }
      }
    }
  },
  {
    "id": "ocean.waves",
    "description": "Wind sea for a wind speed and fetch (JONSWAP growth capped at the fully developed Pierson–Moskowitz sea): significant height, peak period and wavelength, breaking depth, and the Gerstner components the viewport animates",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "WaveParams",
      "description": "Wind-sea settings.",
      "type": "object",
      "properties": {
        "wind_speed_mps": {
          "description": "Wind speed 10 m above the sea, m/s (≥ 0; 0 = flat calm): 3 ripples, 8 moderate sea, 20 gale.",
          "type": "number",
          "format": "float",
          "default": 8.0
        },
        "fetch_km": {
          "description": "Fetch, km: how far the wind has blown over open water (> 0). Omit for a fully developed sea.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "wind_azimuth_deg": {
          "description": "Where the wind blows FROM, degrees clockwise from north; waves travel the opposite way.",
          "type": "number",
          "format": "float",
          "default": 270.0
        }
      },
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "WaveSpectrum",
