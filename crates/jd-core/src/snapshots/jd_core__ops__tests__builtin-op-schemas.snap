---
source: crates/jd-core/src/ops.rs
expression: list
---
[
  {
    "id": "diag.bench",
    "description": "Run a benchmark scene (S1: fBm + ridged + add + thermal×50) with the real kernels; per-stage wall time, peak RSS, content hash",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "BenchParams",
      "description": "`diag.bench` params.",
      "type": "object",
      "properties": {
        "scene": {
          "description": "Scene to run.",
          "$ref": "#/$defs/BenchScene",
          "default": "s1"
        },
        "size_px": {
          "description": "Square size in pixels (S1 default 1024).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false,
      "$defs": {
        "BenchScene": {
          "description": "Benchmark scenes (`docs/spec/performance-targets.md`).",
          "oneOf": [
            {
              "description": "S1-small-interactive: fBm + ridged noise, add, thermal erosion (50 steps) — the preview path.",
              "type": "string",
              "const": "s1"
            }
          ]
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "BenchReport",
      "description": "`diag.bench` result.",
      "type": "object",
      "properties": {
        "scene": {
          "description": "Scene.",
          "$ref": "#/$defs/BenchScene"
        },
        "size_px": {
          "description": "Square size in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stages": {
          "description": "Stages in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BenchStage"
          }
        },
        "total_ms": {
          "description": "Sum of the stages, milliseconds.",
          "type": "number",
          "format": "double"
        },
        "peak_rss_bytes": {
          "description": "Highest resident set size of this process observed between stages, bytes (None when the\nplatform does not report it).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "profile": {
          "description": "`debug` or `release` — debug numbers are not comparable with the spec's targets.",
          "type": "string"
        },
        "content_hash": {
          "description": "Content hash of the final field (determinism check across runs and machines).",
          "type": "string"
        }
      },
      "required": [
        "scene",
        "size_px",
        "stages",
        "total_ms",
        "profile",
        "content_hash"
      ],
      "$defs": {
        "BenchScene": {
          "description": "Benchmark scenes (`docs/spec/performance-targets.md`).",
          "oneOf": [
            {
              "description": "S1-small-interactive: fBm + ridged noise, add, thermal erosion (50 steps) — the preview path.",
              "type": "string",
              "const": "s1"
            }
          ]
        },
        "BenchStage": {
          "description": "One timed stage.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Stage name.",
              "type": "string"
            },
            "ms": {
              "description": "Wall time in milliseconds.",
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "name",
            "ms"
          ]
        }
      }
    }
  },
  {
    "id": "diag.env",
    "description": "Report host environment and detected tools",
    "scope": "none",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NoParams",
      "description": "Empty params.",
      "type": "object",
      "additionalProperties": false
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "EnvInfo",
      "description": "Snapshot of the host environment.",
      "type": "object",
      "properties": {
        "app_version": {
          "description": "Jenga Dunia version.",
          "type": "string"
        },
        "os": {
          "description": "OS name and version.",
          "type": "string"
        },
        "arch": {
          "description": "CPU architecture.",
          "type": "string"
        },
        "cpus": {
          "description": "Logical CPU count.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "memory_total_bytes": {
          "description": "Total physical memory in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "memory_available_bytes": {
          "description": "Currently available memory in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cwd": {
          "description": "Current working directory.",
          "type": "string"
        },
        "tools": {
          "description": "Optional external tools (validators, DCCs) detected on PATH.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolStatus"
          }
        }
      },
      "required": [
        "app_version",
        "os",
        "arch",
        "cpus",
        "memory_total_bytes",
        "memory_available_bytes",
        "cwd",
        "tools"
      ],
      "$defs": {
        "ToolStatus": {
          "description": "Presence of an optional external tool on `PATH`.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Tool name.",
              "type": "string"
            },
            "path": {
              "description": "Resolved path, if found.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name"
          ]
        }
      }
    }
  },
  {
    "id": "graph.add_node",
    "description": "Add a node (journaled)",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AddNode",
      "description": "`graph.add_node` params.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Kind `name@version`, e.g. `jd.noise.fbm@1`.",
          "$ref": "#/$defs/NodeKind"
        },
        "params": {
          "description": "Parameters (validated against the kind's schema before journaling).",
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "id": {
          "description": "Optional client-chosen id (ULID); generated when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "position": {
          "description": "Editor position; when omitted the node lands to the right of the current graph so\nscripted additions (CLI, MCP) never stack at the origin.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "$defs": {
        "NodeKind": {
          "description": "A node kind identifier `namespace.name@version`, e.g. `jd.noise.fbm@1`.",
          "type": "string"
        },
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AddedNode",
      "description": "`graph.add_node` result.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Id of the new node.",
          "$ref": "#/$defs/NodeId"
        }
      },
      "required": [
        "id"
      ],
      "$defs": {
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    }
  },
  {
    "id": "graph.append_param",
    "description": "Push one element onto an array parameter (brush strokes): journaled with just the element, so a long sculpt session grows the journal linearly",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AppendParam",
      "description": "`graph.append_param` params.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Node id.",
          "$ref": "#/$defs/NodeId"
        },
        "key": {
          "description": "Array-valued parameter key (created when absent).",
          "type": "string"
        },
        "value": {
          "description": "Element to push."
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "value"
      ],
      "$defs": {
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "GraphView",
      "description": "`graph.list` result.",
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Nodes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeView"
          }
        },
        "edges": {
          "description": "Edges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "undo_depth": {
          "description": "Number of edits `graph.undo` can take back.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "redo_depth": {
          "description": "Number of undone edits `graph.redo` can re-apply.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "nodes",
        "edges",
        "undo_depth",
        "redo_depth"
      ],
      "$defs": {
        "NodeView": {
          "description": "Node as reported by `graph.list`.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Id.",
              "$ref": "#/$defs/NodeId"
            },
            "kind": {
              "description": "Kind `name@version`.",
              "$ref": "#/$defs/NodeKind"
            },
            "params": {
              "description": "Parameters, validated against the kind's schema on every mutation.",
              "type": "object",
              "additionalProperties": true,
              "default": {}
            },
            "bypass": {
              "description": "Bypassed nodes pass their first input through unchanged.",
              "type": "boolean",
              "default": false
            },
            "ui": {
              "description": "Editor metadata.",
              "$ref": "#/$defs/UiMeta",
              "default": {
                "position": [
                  0.0,
                  0.0
                ]
              }
            }
          },
          "required": [
            "id",
            "kind"
          ]
        },
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        },
        "NodeKind": {
          "description": "A node kind identifier `namespace.name@version`, e.g. `jd.noise.fbm@1`.",
          "type": "string"
        },
        "UiMeta": {
          "description": "Editor-only metadata.",
          "type": "object",
          "properties": {
            "position": {
              "description": "Canvas position.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0.0,
                0.0
              ]
            },
            "label": {
              "description": "Display label override.",
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "Edge": {
          "description": "A directed connection from an output port to an input port.",
          "type": "object",
          "properties": {
            "from": {
              "description": "Source output.",
              "$ref": "#/$defs/PortRef"
            },
            "to": {
              "description": "Destination input.",
              "$ref": "#/$defs/PortRef"
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        "PortRef": {
          "description": "One end of an edge.",
          "type": "object",
          "properties": {
            "node": {
              "description": "Node id.",
              "$ref": "#/$defs/NodeId"
            },
            "port": {
              "description": "Port name.",
              "type": "string"
            }
          },
          "required": [
            "node",
            "port"
          ]
        }
      }
    }
  },
  {
    "id": "graph.connect",
    "description": "Connect an output to an input (journaled; rejects bad ports, type mismatches and cycles)",
    "scope": "project-write",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Connect",
      "description": "`graph.connect` / `graph.disconnect` params.",
      "type": "object",
      "properties": {
        "from": {
          "description": "Source node.",
          "$ref": "#/$defs/NodeId"
        },
        "from_port": {
          "description": "Source output port (default `out`).",
          "type": "string",
          "default": "out"
        },
        "to": {
          "description": "Destination node.",
          "$ref": "#/$defs/NodeId"
        },
        "to_port": {
          "description": "Destination input port.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "to_port"
      ],
      "$defs": {
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        }
      }
    },
    "result_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "GraphView",
      "description": "`graph.list` result.",
      "type": "object",
      "properties": {
        "nodes": {
          "description": "Nodes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeView"
          }
        },
        "edges": {
          "description": "Edges.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "undo_depth": {
          "description": "Number of edits `graph.undo` can take back.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "redo_depth": {
          "description": "Number of undone edits `graph.redo` can re-apply.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "nodes",
        "edges",
        "undo_depth",
        "redo_depth"
      ],
      "$defs": {
        "NodeView": {
          "description": "Node as reported by `graph.list`.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Id.",
              "$ref": "#/$defs/NodeId"
            },
            "kind": {
              "description": "Kind `name@version`.",
              "$ref": "#/$defs/NodeKind"
            },
            "params": {
              "description": "Parameters, validated against the kind's schema on every mutation.",
              "type": "object",
              "additionalProperties": true,
              "default": {}
            },
            "bypass": {
              "description": "Bypassed nodes pass their first input through unchanged.",
              "type": "boolean",
              "default": false
            },
            "ui": {
              "description": "Editor metadata.",
              "$ref": "#/$defs/UiMeta",
              "default": {
                "position": [
                  0.0,
                  0.0
                ]
              }
            }
          },
          "required": [
            "id",
            "kind"
          ]
        },
        "NodeId": {
          "description": "Identifies a graph node.",
          "type": "string"
        },
        "NodeKind": {
          "description": "A node kind identifier `namespace.name@version`, e.g. `jd.noise.fbm@1`.",
          "type": "string"
        },
        "UiMeta": {
          "description": "Editor-only metadata.",
          "type": "object",
          "properties": {
            "position": {
              "description": "Canvas position.",
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0.0,
                0.0
              ]
            },
            "label": {
              "description": "Display label override.",
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "Edge": {
          "description": "A directed connection from an output port to an input port.",
          "type": "object",
          "properties": {
            "from": {
              "description": "Source output.",
              "$ref": "#/$defs/PortRef"
            },
            "to": {
              "description": "Destination input.",
              "$ref": "#/$defs/PortRef"
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        "PortRef": {
          "description": "One end of an edge.",
          "type": "object",
          "properties": {
            "node": {
              "description": "Node id.",
              "$ref": "#/$defs/NodeId"
            },
            "port": {
              "description": "Port name.",
              "type": "string"
            }
          },
          "required": [
            "node",
            "port"
          ]
        }
      }
    }
  },
